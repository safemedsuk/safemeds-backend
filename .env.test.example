# ─────────────────────────────────────────────────────────────────────────
# SafeMeds Backend — Environment Configuration
#
# Copy this file to `.env` and fill in real values. The app validates every
# variable below at boot (src/config/env.validation.ts) via Zod and refuses
# to start if anything is missing or malformed — there is no silent fallback
# to an insecure default in the places that matter (secrets, credentials).
#
# Generate a strong random secret with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=test
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1

# ── Database (Postgres via Prisma) ──────────────────────────────────────
# Matches docker-compose.yml by default.
DATABASE_URL=postgresql://safemeds:safemeds@localhost:5432/safemeds_test?schema=public
DATABASE_POOL_SIZE=10

# ── Redis (BullMQ queues, single-use token store, caching) ─────────────
REDIS_URL=redis://localhost:6379

# ── JWT / session tokens ─────────────────────────────────────────────────
# Access token: short-lived JWT. Refresh token itself is an opaque random
# value (not a JWT) stored hashed — no secret needed for it, only a TTL.
JWT_ACCESS_SECRET=f4f55555a7dcf2759457d980a36eb0d1c29cc92772f83a2ba26b8c6dabad9544
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_MFA_PENDING_SECRET=226ecef72542c7fc454a98fb7645512499e700ea9b307550e80020a0fa6024d6
JWT_MFA_PENDING_EXPIRES_IN=5m

# ── Cookies & CSRF ────────────────────────────────────────────────────────
# Leave COOKIE_DOMAIN unset for localhost; set to `.safemeds.uk` in prod.
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_SECRET=9741c4b1218eeca8adf9c75a229c7e0f03063e7d57c022f62414f8ce4d300fed

# ── Password hashing (argon2id tuning) ───────────────────────────────────
ARGON2_MEMORY_COST_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12

# ── MFA (TOTP secrets encrypted at rest, AES-256-GCM) ────────────────────
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
MFA_ENCRYPTION_KEY=830cf6037368e1a2138848446eadd418d467f47d45afe69fa7c0b8cfbaeae6ac

# ── Re-authentication (signature-grade tokens, Phase 1.9 / Phase 6) ─────
REAUTH_TOKEN_EXPIRES_IN_MINUTES=5

# ── Account lifecycle timing ─────────────────────────────────────────────
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
INVITATION_TOKEN_TTL_DAYS=7
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15

# ── Rate limiting ─────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_REGISTER_LIMIT_PER_HOUR=3
AUTH_THROTTLE_LOGIN_LIMIT_PER_MINUTE=10
AUTH_THROTTLE_RESEND_CODE_SECONDS=60

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_dev_placeholder_not_a_real_key
MAIL_FROM_ADDRESS=no-reply@safemeds.uk
MAIL_FROM_NAME=SafeMeds

# ── Object storage (Cloudflare R2, S3-compatible API) ────────────────────
R2_ACCOUNT_ID=dev_placeholder
R2_ACCESS_KEY_ID=dev_placeholder
R2_SECRET_ACCESS_KEY=dev_placeholder
R2_BUCKET_NAME=safemeds-documents-dev
R2_ENDPOINT=https://dev-placeholder.r2.cloudflarestorage.com
R2_PUBLIC_URL=
UPLOAD_MAX_FILE_SIZE_MB=10
PRESIGNED_UPLOAD_TTL_SECONDS=300
PRESIGNED_DOWNLOAD_TTL_SECONDS=900

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=error
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── API docs ──────────────────────────────────────────────────────────────
SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated extra origins beyond FRONTEND_URL (e.g. staging previews).
CORS_ADDITIONAL_ORIGINS=
