{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(@scure|@noble))"
  ],
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFilesAfterEnv": ["<rootDir>/setup-e2e.ts"]
}
