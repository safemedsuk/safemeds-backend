// SafeMeds base engine — Prisma schema
//
// Translated incrementally from `docs/safemeds-erd-v2.mermaid`, one phase's
// models at a time (see docs/safemeds-base-engine-build-spec.md). Phase 0
// established only the datasource/generator; Phase 1 (Auth & Account
// Lifecycle) adds the first domain models below.
//
// Naming: snake_case in Postgres (tables via @@map, columns via @map),
// camelCase in the generated client — every multi-word field below carries
// an explicit @map to its snake_case column name.
// IDs: UUID v7, generated in application code via src/common/id.ts —
// Prisma's own @default(uuid()) only produces v4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Phase 1 — Auth & Account Lifecycle ────────────────────────────────────
//
// Reconciled against the ERD/spec divergence (see memory
// safemeds-docs-canonical): registration's verification code (1.3) lives
// directly on CompanyRegistration, not AuthToken — no User exists at that
// point yet. AuthToken (1.7/1.8) covers email_verification (post-invite)
// and password_reset only; signature-grade tokens (1.9) live in Redis
// only (single-use, 5-min TTL — no Postgres row needed or made). Role/
// Permission/RolePermission/UserRole are Phase 2 — User carries a
// denormalized `roleKeys` array for now, matching the ERD's own
// INVITATION.role_keys denormalization style.

enum CompanyType {
  manufacturer
  importer_distributor
  pharmacy_chain
  e_pharmacy
  medical_facility
  ngo_social_health
  research_institution
  other
}

enum CompanyStatus {
  active
  suspended
}

enum CompanyRegistrationStatus {
  pending_verification
  under_review
  approved
  rejected
}

enum UserStatus {
  active
  deactivated
}

enum PlatformRole {
  super_admin
  operations
  support
  /// Field/regulatory domain expert — config-write (platform.config.manage) + audit/records read, deliberately without tenant-administrative permissions (suspend, staff management, break-glass support).
  regulatory_lead
}

enum AuditActorType {
  user
  system
}

enum MfaMethod {
  totp
  sms
}

enum AuthTokenPurpose {
  email_verification
  password_reset
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Country {
  id           String   @id @db.Uuid
  isoCode      String   @unique @map("iso_code") @db.VarChar(2)
  name         String
  /**
   * VigiCloud Stage 12 — the formal state name for regulatory-letterhead
   * use (e.g. "Republic of Kenya"), distinct from `name`'s plain short
   * form ("Kenya"). Deliberately nullable and never pattern-generated
   * from `name` (e.g. a naive "Republic of {name}") — not every country
   * is a republic (compare Kingdom of Eswatini, Kingdom of Morocco), so
   * guessing would risk printing a wrong official name on a real
   * regulatory submission document. Null renders as a graceful blank in
   * `RegulatorySubmissionPdfService`'s letterhead, never a guess.
   */
  officialName String?  @map("official_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  companies     Company[]
  registrations CompanyRegistration[]

  regulatoryAuthorities      RegulatoryAuthority[]
  formSchemas                FormSchema[]
  markets                    CompanyMarket[]
  facilities                 Facility[]
  workflowDefinitions        WorkflowDefinition[]
  userLocationScopes         UserLocationScope[]
  pvCasesOfOccurrence        Case[]                     @relation("case_country_of_occurrence")
  pvCasesOfReport            Case[]                     @relation("case_country_of_report")
  pvReporters                Reporter[]
  pvSuspectProductsObtained  SuspectProduct[]
  clinicalTrials             ClinicalTrial[]
  distributors               Distributor[]
  trainingTypeCatalogEntries TrainingTypeCatalogEntry[]

  // RegCloud (Phase 12) Stage 0 — see the dedicated section near the end of
  // this file for the models themselves.
  regRequirements    RegulatoryRequirement[]
  regFeeSchedules    RegulatoryFeeSchedule[]
  regDeadlineRules   RegDeadlineRule[]
  manufacturers      Manufacturer[]
  manufacturingSites ManufacturingSite[]
  localReps          LocalRepresentative[]

  // QualCloud (Phase 13) Stage 0 — Foundation Layer.
  qualitySuppliers Supplier[]
  // QualCloud (Phase 13) Stage 10.1/10.2 — Recall.
  recallRuleSets   RecallRuleSet[]
  recallCountries  RecallCountry[]

  @@map("country")
}

/**
 * Special Corner SC-8 (Admin Configuration Console — training-type
 * catalog) — "PPB Academy" only makes sense for a Kenya-market company,
 * but the training-type dropdown used to be a hardcoded 4-option list
 * baked into the frontend with no country awareness at all. `countryId:
 * null` means "available to every market" (e.g. "Internal"/"Other");
 * a non-null `countryId` scopes an entry to that one market's own
 * training programs, the same way `RegulatoryAuthority` scopes a
 * letterhead to one authority. Plain CRUD, not version-on-write — an
 * entry's own identity doesn't need audit-trailed history the way a
 * *rule* does, matching `RegulatoryAuthority`'s own precedent from
 * Admin Config Console Gap 2.
 */
model TrainingTypeCatalogEntry {
  id        String   @id @db.Uuid
  countryId String?  @map("country_id") @db.Uuid
  country   Country? @relation(fields: [countryId], references: [id])
  typeKey   String   @map("type_key")
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  curriculumRows RoleTrainingCurriculum[]

  @@map("training_type_catalog_entry")
}

model Company {
  id                                       String        @id @db.Uuid
  name                                     String
  companyType                              CompanyType   @map("company_type")
  homeCountryId                            String        @map("home_country_id") @db.Uuid
  homeCountry                              Country       @relation(fields: [homeCountryId], references: [id])
  status                                   CompanyStatus @default(active)
  /**
   * VigiCloud Stage 3.2 — the public case-reporting URL slug
   * (`{FRONTEND_URL}/report/{slug}`). Null until a tenant admin generates
   * one via `CompanyProfileService.generatePublicReportingSlug()`; public
   * reporting is opt-in per company, not on by default.
   */
  publicReportingSlug                      String?       @unique @map("public_reporting_slug")
  /**
   * VigiCloud Stage 3.3 — the inbound-mailbox address this company's
   * drug-safety inbox forwards to (`{slug}@{EMAIL_INTAKE_DOMAIN}`), used
   * by `EmailIntakeService` to resolve which tenant an inbound email
   * belongs to. Null until generated the same way as the reporting slug —
   * see `vg-stage3-setup.md` for the actual mail-forwarding configuration
   * this depends on.
   */
  intakeEmailAddress                       String?       @unique @map("intake_email_address")
  /**
   * VigiCloud Stage 3.4 — the Meta-assigned WhatsApp Business phone number
   * ID for this company's dedicated intake number, if they have one
   * (the "one number per tenant" model). Null when this company instead
   * shares SafeMeds's central WhatsApp number and is routed by an
   * initial company-selection prompt in the chatbot flow instead — see
   * `WhatsAppIntakeService`'s own doc comment. Admin-entered (Meta assigns
   * this during WhatsApp Business Platform onboarding, outside this app),
   * not generated here.
   */
  whatsappBusinessPhoneNumberId            String?       @unique @map("whatsapp_business_phone_number_id")
  /**
   * VigiCloud Stage 12 — the E2B(R3) `sender` block and the generated
   * submission PDF's "Information on Sender" section both need real
   * correspondence details this company never had a field for before.
   * All nullable and blank-by-default (never fabricated) — a company
   * fills these in via Company Profile before its first real
   * regulatory submission, matching the same discovered-late-but-real
   * pattern as `Product.innName`/`atcCode` before it.
   */
  registeredAddress                        String?       @map("registered_address")
  regulatoryContactEmail                   String?       @map("regulatory_contact_email")
  regulatoryContactPhone                   String?       @map("regulatory_contact_phone")
  /**
   * QualCloud (Phase 13) Stage 10.7 — the mock-recall (self-inspection
   * drill) cadence, in months. `null` means "use the default" (12 —
   * WHO GMP's own commonly-cited annual self-inspection/mock-recall
   * convention) — a company-editable generic default, deliberately
   * **not** claimed as a confirmed Kenya-PPB-specific requirement; the
   * Country Rules Content Pack itself flags "does PPB mandate mock
   * recalls, and how often?" as unverified.
   */
  mockRecallCadenceMonths                  Int?          @map("mock_recall_cadence_months")
  /**
   * VigiCloud Stage 16.4 — live current-state pointers, kept in sync
   * with `QppvNomination`'s own `active` rows by `QppvNominationService`.
   * A backup QPPV is legally mandatory per GUD/006 §3, not optional —
   * see `QppvNomination`'s own doc comment.
   */
  primaryQppvUserId                        String?       @map("primary_qppv_user_id") @db.Uuid
  primaryQppv                              User?         @relation("company_primary_qppv", fields: [primaryQppvUserId], references: [id])
  backupQppvUserId                         String?       @map("backup_qppv_user_id") @db.Uuid
  backupQppv                               User?         @relation("company_backup_qppv", fields: [backupQppvUserId], references: [id])
  /**
   * RegCloud (Phase 12) Stage 15 — Modular Engagement Model. Plain
   * string, not an enum (matching `Recall.recallClass`'s own precedent
   * for a still-evolving classification) — `full_service |
   * dossier_review_only | client_handles_queries`, per the Build
   * Priority doc's own three engagement types. This is the company's
   * *default*; an individual `RegDossier.engagementType` can override
   * it per-registration (see that field's own doc comment). Deliberately
   * NOT gated behind a `REGULATORY_AFFAIRS_OFFICER` role split — see
   * `todo-regcloud.md`'s own explicit warning against building that
   * speculatively before the mechanics are concrete.
   */
  engagementType                           String        @default("full_service") @map("engagement_type")
  /**
   * QualCloud (Phase 13) Stage 0 — `todo-qualcloud.md` Reconciliation
   * Note 2: whether this tenant needs the full manufacturer-grade GMP
   * set (MBRs, PQR, batch release, stability) or only the GDP subset
   * (document control, complaints, recall, storage, self-inspection) is
   * never a hard architectural fork — every QualCloud table/endpoint
   * exists regardless of this value. `manufacturer_full_gmp |
   * distributor_gdp | both` only ever affects default sidebar/dashboard
   * *visibility*, never a permission gate — defaults to `both` so
   * nothing is ever hidden by mistake for a tenant that hasn't set it.
   * Plain string, not an enum, matching `Company.engagementType`'s own
   * "still-evolving classification" precedent exactly.
   */
  qualityProfile                           String        @default("both") @map("quality_profile")
  /**
   * QualCloud (Phase 13) Stage 8 — the trend-detection rule's own
   * admin-editable knobs (`todo-qualcloud.md`'s own "3 or more... within
   * a rolling 6 months (admin-editable count/window)"). Both nullable —
   * null means the coded default (3 occurrences / 180 days), matching
   * this schema's general "a plain per-tenant override column, not a
   * separate config table, until a real need for more" discipline.
   */
  qualityTrendThresholdCount               Int?          @map("quality_trend_threshold_count")
  qualityTrendWindowDays                   Int?          @map("quality_trend_window_days")
  /**
   * QualCloud (Phase 13) Stage 11 — re-qualification cadence, same
   * nullable-means-coded-default pattern as the trend-detection knobs
   * above: 12 months for `criticality: critical` suppliers, 30 months
   * (middle of WHO GMP's commonly-cited 2–3-year band) for
   * `non_critical` ones.
   */
  supplierCriticalRequalificationMonths    Int?          @map("supplier_critical_requalification_months")
  supplierNonCriticalRequalificationMonths Int?          @map("supplier_non_critical_requalification_months")
  createdAt                                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                      User[]
  securityPolicy             SecurityPolicy?
  registration               CompanyRegistration?
  auditEntries               AuditEntry[]
  invitations                Invitation[]
  markets                    CompanyMarket[]
  facilities                 Facility[]
  deadlines                  Deadline[]
  signatureEvents            SignatureEvent[]
  products                   Product[]
  batches                    Batch[]
  productRegistrations       ProductRegistration[]
  documents                  Document[]
  tasks                      Task[]
  notifications              Notification[]
  consentRecords             ConsentRecord[]
  dataSubjectRequests        DataSubjectRequest[]
  recordVersions             RecordVersion[]
  entitlements               Entitlement[]
  userLocationScopes         UserLocationScope[]
  generatedReports           GeneratedReport[]
  reportDefinitions          ReportDefinition[]
  pvCases                    Case[]
  pvReporters                Reporter[]
  pvPatients                 Patient[]
  pvSuspectProducts          SuspectProduct[]
  pvAdverseEvents            AdverseEvent[]
  pvCausalityAssessments     CausalityAssessment[]
  pvSourceDocuments          SourceDocument[]
  pvPregnancyContexts        PregnancyContext[]
  pvCallLogs                 CallLog[]
  pvDuplicateReviews         DuplicateReview[]
  pvCaseFollowUps            CaseFollowUp[]
  pvCaseFollowUpAttempts     CaseFollowUpAttempt[]
  pvRegulatorySubmissions    RegulatorySubmission[]
  clinicalTrials             ClinicalTrial[]
  clinicalTrialSubjects      ClinicalTrialSubject[]
  distributors               Distributor[]               @relation("distributor_owner")
  distributorTenantOf        Distributor[]               @relation("distributor_tenant")
  caseDistributorMappings    CaseDistributorMapping[]
  reconciliationReports      ReconciliationReport[]
  contactTests               ContactTest[]
  contactTestAttempts        ContactTestAttempt[]
  psmfs                      Psmf[]
  auditRequirementRecords    AuditRequirementRecord[]
  auditPacks                 AuditPack[]
  internalAudits             InternalAudit[]
  auditFindings              AuditFinding[]
  capas                      Capa[]
  qppvNominations            QppvNomination[]
  sdeas                      Sdea[]
  trainingRecords            TrainingRecord[]
  distributorTrainingRecords DistributorTrainingRecord[]
  pvSignals                  Signal[]
  pvSignalCases              SignalCase[]
  riskManagementPlans        RiskManagementPlan[]
  safetyAlerts               SafetyAlert[]
  safetyLetterRecipients     SafetyLetterRecipient[]
  literatureMonitoringRuns   LiteratureMonitoringRun[]

  // RegCloud (Phase 12) Stage 0 — tenant-scoped rows only (the country
  // rule-set graph itself — RegulatoryRequirement/RegulatoryFeeSchedule/
  // RegDeadlineRule — has no companyId, it's global config owned by
  // Country/RegulatoryAuthority, same as ReportingRule).
  regDeadlines                   RegDeadline[]
  manufacturers                  Manufacturer[]
  manufacturingSites             ManufacturingSite[]
  localReps                      LocalRepresentative[]
  regDossiers                    RegDossier[]
  regFeeInvoices                 RegFeeInvoice[]
  regFeePayments                 RegFeePayment[]
  regSubmissions                 RegSubmission[]
  regQueries                     RegQuery[]
  regQueryCorrespondence         RegQueryCorrespondence[]
  regVariations                  RegVariation[]
  regRetentions                  RegRetention[]
  personnelLicences              PersonnelLicence[]
  regPostMarketObligations       RegPostMarketObligation[]
  importExportPermits            ImportExportPermit[]
  promotionalMaterialSubmissions PromotionalMaterialSubmission[]
  recalls                        Recall[]
  recallCases                    RecallCase[]
  relianceApplications           RelianceApplication[]

  // QualCloud (Phase 13) Stage 0 — Foundation Layer.
  qualitySuppliers                Supplier[]
  qualityEquipment                Equipment[]
  qualitySops                     Sop[]
  qualitySpecifications           Specification[]
  qualityDocumentAcks             DocumentAcknowledgment[]
  qualityRetentionPolicies        RetentionPolicy[]
  qualityRiskAssessments          RiskAssessment[]
  // QualCloud (Phase 13) Stage 2 — Deviation & Non-Conformance Management.
  qualityDeviations               Deviation[]
  qualityInvestigations           Investigation[]
  // QualCloud (Phase 13) Stage 4 — Change Control.
  qualityChangeControls           ChangeControl[]
  // QualCloud (Phase 13) Stage 5 — Complaint Handling.
  qualityComplaints               Complaint[]
  // QualCloud (Phase 13) Stage 6 — OOS/OOT Investigation.
  qualityOosRecords               Oos[]
  // QualCloud (Phase 13) Stage 7 — Batch Traceability & Record Review.
  qualityBatchRecordReviews       BatchRecordReview[]
  // QualCloud (Phase 13) Stage 8 — Metrics, Trending & Management Review.
  qualityTrendFlags               QualityTrendFlag[]
  managementReviews               ManagementReview[]
  // QualCloud (Phase 13) Stage 9 — Audit & Inspection Management.
  internalAuditChecklistResponses InternalAuditChecklistResponse[]
  regulatoryInspectionResponses   RegulatoryInspectionResponse[]
  inspectionReadinessPacks        InspectionReadinessPack[]
  // QualCloud (Phase 13) Stage 10.0-10.5 — Recall & Mock Recall.
  recallSubmissions               RecallSubmission[]
  recallCountries                 RecallCountry[]
  recallRequirements              RecallRequirement[]
  recallScopeVersions             RecallScopeVersion[]
  stakeholders                    Stakeholder[]
  recallDistributionRecords       RecallDistributionRecord[]
  recallImportJobs                RecallImportJob[]
  recallCascadeInvites            RecallCascadeInvite[]
  recallSightings                 RecallSighting[]
  recallPortalLinks               RecallPortalLink[]
  recallMessages                  RecallMessage[]
  recallQuarantineRecords         RecallQuarantineRecord[]
  recallReturnRecords             RecallReturnRecord[]
  recallReconciliationSnapshots   RecallReconciliationSnapshot[]
  recallDiscrepancies             RecallDiscrepancy[]
  recallDestructionRecords        RecallDestructionRecord[]
  recallEffectivenessChecks       RecallEffectivenessCheck[]
  pqrs                            Pqr[]
  roleTrainingCurriculums         RoleTrainingCurriculum[]
  competencyAssessments           CompetencyAssessment[]
  supplierQuestionnaires          SupplierQuestionnaire[]
  certificateOfAnalyses           CertificateOfAnalysis[]
  equipmentQualificationEvents    EquipmentQualificationEvent[]
  maintenanceRecords              MaintenanceRecord[]
  wasteDisposalRecords            WasteDisposalRecord[]
  falsifiedProductReports         FalsifiedProductReport[]
  batchReleaseDecisions           BatchReleaseDecision[]
  validationProtocols             ValidationProtocol[]
  validationReports               ValidationReport[]
  environmentalMonitoringResults  EnvironmentalMonitoringResult[]
  stabilityStudies                StabilityStudy[]
  stabilityTimepoints             StabilityTimepoint[]

  @@map("company")
}

model SecurityPolicy {
  id                           String   @id @db.Uuid
  companyId                    String   @unique @map("company_id") @db.Uuid
  company                      Company  @relation(fields: [companyId], references: [id])
  minPasswordLength            Int      @default(12) @map("min_password_length")
  /**
   * VigiCloud Stage 0.7 — lowered from 30 to 5 ("especially for patient
   * data"). Companies that had never touched this field are backfilled to
   * 5 in the same migration that changes this default; a company that
   * explicitly customized it keeps its own chosen value.
   */
  sessionTimeoutMinutes        Int      @default(5) @map("session_timeout_minutes")
  mfaRequiredForSignatureRoles Boolean  @default(false) @map("mfa_required_for_signature_roles")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("security_policy")
}

model CompanyRegistration {
  id               String      @id @db.Uuid
  referenceNumber  String      @unique @map("reference_number")
  companyName      String      @map("company_name")
  companyType      CompanyType @map("company_type")
  countryId        String      @map("country_id") @db.Uuid
  country          Country     @relation(fields: [countryId], references: [id])
  licenceNumber    String      @map("licence_number")
  licenceDocKey    String?     @map("licence_doc_key")
  licenceDocSha256 String?     @map("licence_doc_sha256")

  adminFullName     String  @map("admin_full_name")
  adminEmail        String  @map("admin_email")
  adminPhone        String? @map("admin_phone")
  adminPasswordHash String  @map("admin_password_hash")
  /**
   * testing-correction-explanation.md decision #4 — "every company MUST
   * have an email address," carried through to `Company.regulatoryContactEmail`
   * at approval. Nullable for the same reason every new field on a table
   * with real pending rows is (9 real `pending_verification` rows exist
   * already, captured before this field existed) — required going
   * forward via `RegisterCompanyDto`, never a DB constraint.
   */
  companyEmail      String? @map("company_email")

  status CompanyRegistrationStatus @default(pending_verification)

  verificationCodeHash      String?   @map("verification_code_hash")
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at") @db.Timestamptz(3)
  verificationAttempts      Int       @default(0) @map("verification_attempts")
  verificationLastSentAt    DateTime? @map("verification_last_sent_at") @db.Timestamptz(3)

  companyId String?  @unique @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewer        User?     @relation("registration_reviewer", fields: [reviewedBy], references: [id])
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("company_registration")
}

model User {
  id        String   @id @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  email        String     @unique
  fullName     String     @map("full_name")
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)

  platformRole PlatformRole? @map("platform_role")
  roleKeys     String[]      @default([]) @map("role_keys")
  /**
   * True for an outsourced/contracted professional (e.g. an external
   * QPPV, or — RegCloud Stage 15 — a multi-client regulatory consultant)
   * rather than the tenant's own direct employee. One email always maps
   * to one account per tenant — never a shared cross-tenant identity;
   * the same person consulting for several companies holds a separate
   * `User` row (and separate `isExternal: true`) in each. Set at invite
   * time (`Invitation.isExternal`) or toggled afterward via
   * `PATCH /users/:id/roles`.
   */
  isExternal   Boolean       @default(false) @map("is_external")

  mustChangePassword Boolean @default(false) @map("must_change_password")
  tokenVersion       Int     @default(0) @map("token_version")
  version            Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens                          RefreshToken[]
  loginAttempts                          LoginAttempt[]
  reviewedRegistrations                  CompanyRegistration[]                @relation("registration_reviewer")
  auditEntries                           AuditEntry[]
  mfaCredential                          MfaCredential?
  authTokens                             AuthToken[]
  invitationsSent                        Invitation[]                         @relation("invitation_invited_by")
  invitationsAccepted                    Invitation[]                         @relation("invitation_accepted_by")
  signatureEvents                        SignatureEvent[]
  documentsCreated                       Document[]
  documentVersionsSent                   DocumentVersion[]
  tasksAssigned                          Task[]                               @relation("task_assigned_user")
  tasksClaimed                           Task[]                               @relation("task_claimed_by")
  notifications                          Notification[]
  notificationPreference                 NotificationPreference?
  consentRecordsCaptured                 ConsentRecord[]
  dataSubjectRequestsMade                DataSubjectRequest[]
  recordVersionsCaptured                 RecordVersion[]
  entitlementsGranted                    Entitlement[]
  locationScopes                         UserLocationScope[]                  @relation("user_location_scope_user")
  locationScopesGranted                  UserLocationScope[]                  @relation("user_location_scope_granted_by")
  generatedReportsMade                   GeneratedReport[]
  reportDefinitionsCreated               ReportDefinition[]
  pvCasesCreated                         Case[]                               @relation("case_created_by")
  pvCasesDraftClaimed                    Case[]                               @relation("case_draft_claimed_by")
  pvCausalityAssessed                    CausalityAssessment[]
  pvSourceDocumentsRedacted              SourceDocument[]
  pvCallLogsLogged                       CallLog[]
  pvCasesExpectednessAssessed            Case[]                               @relation("case_expectedness_assessed_by")
  pvAdverseEventsCoded                   AdverseEvent[]
  pvSuspectProductsCoded                 SuspectProduct[]
  pvDuplicateReviewsDecided              DuplicateReview[]
  pvCaseFollowUpsStarted                 CaseFollowUp[]
  pvCaseFollowUpAttemptsLogged           CaseFollowUpAttempt[]
  pvRegulatorySubmissionsGenerated       RegulatorySubmission[]               @relation("regulatory_submission_generated_by")
  pvRegulatorySubmissionsSubmitted       RegulatorySubmission[]               @relation("regulatory_submission_submitted_by")
  clinicalTrialSubjectsUnblinded         ClinicalTrialSubject[]
  caseDistributorMappingsReconciled      CaseDistributorMapping[]
  reconciliationReportsGenerated         ReconciliationReport[]
  contactTestsInitiated                  ContactTest[]
  contactTestAttemptsLogged              ContactTestAttempt[]
  psmfsCreated                           Psmf[]                               @relation("psmf_created_by")
  auditRequirementRecordsUpdated         AuditRequirementRecord[]             @relation("audit_requirement_record_updated_by")
  auditPacksGenerated                    AuditPack[]                          @relation("audit_pack_generated_by")
  internalAuditsLed                      InternalAudit[]                      @relation("internal_audit_lead_auditor")
  internalAuditsCreated                  InternalAudit[]                      @relation("internal_audit_created_by")
  auditFindingsCreated                   AuditFinding[]                       @relation("audit_finding_created_by")
  capasOwned                             Capa[]                               @relation("capa_owner")
  // QualCloud (Phase 13) Stage 8 — Metrics, Trending & Management Review.
  qualityTrendFlagsAcknowledged          QualityTrendFlag[]                   @relation("quality_trend_flag_acknowledged_by")
  managementReviewsCreated               ManagementReview[]                   @relation("management_review_created_by")
  // QualCloud (Phase 13) Stage 9 — Audit & Inspection Management.
  checklistResponsesReviewed             InternalAuditChecklistResponse[]     @relation("checklist_response_reviewed_by")
  regulatoryInspectionResponsesSubmitted RegulatoryInspectionResponse[]       @relation("regulatory_inspection_response_submitted_by")
