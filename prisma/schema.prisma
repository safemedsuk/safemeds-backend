  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("auth_token")
}

// ── Phase 1.8 — Invitations ────────────────────────────────────────────────

model Invitation {
  id         String   @id @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  email      String
  roleKeys   String[] @map("role_keys")
  /**
   * RegCloud (Phase 12) Stage 15 — carries the inviter's own `isExternal`
   * choice through to the `User` row `accept()` creates, mirroring
   * `User.isExternal`'s own pre-existing (if previously unwired) field
   * exactly — the "multi-client consultant" case (one external
   * regulatory consultant, invited into several tenants, never a shared
   * identity) this stage's own todo item calls for.
   */
  isExternal Boolean  @default(false) @map("is_external")
  tokenHash  String   @unique @map("token_hash")

  invitedBy String @map("invited_by") @db.Uuid
  inviter   User   @relation("invitation_invited_by", fields: [invitedBy], references: [id])

  acceptedByUserId String? @map("accepted_by_user_id") @db.Uuid
  acceptedByUser   User?   @relation("invitation_accepted_by", fields: [acceptedByUserId], references: [id])

  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  status    InvitationStatus @default(pending)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, status])
  @@index([email])
  @@map("invitation")
}

// ── Phase 2.1 — Role & Permission Catalog ──────────────────────────────────
//
// User.roleKeys (String[], set at approval/invitation/PATCH) remains the
// actual assignment mechanism — deliberately no UserRole join table. This
// mirrors the ERD's own choice for Invitation.roleKeys (denormalized
// strings, not a relation) and avoids rewiring the JWT/session code that
// already depends on `roleKeys` throughout Phase 1. `Role`/`Permission`/
// `RolePermission` here are the reference catalog: `roleKey` strings
// (e.g. "QPPV") map to a `Role.key`, whose `RolePermission` rows resolve
// to the actual `domain.action` permission set `PermissionsGuard` checks.

model Role {
  id          String  @id @db.Uuid
  key         String  @unique
  name        String
  description String
  /**
   * true for the 3 SafeMeds-internal roles (super_admin/operations/support); false for the 8 tenant roles. Matches the platform/tenant split enforced everywhere else — never mixed.
   */
  isPlatform  Boolean @default(false) @map("is_platform")

  permissions      RolePermission[]
  gatedTransitions WorkflowTransition[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("role")
}

model Permission {
  id          String @id @db.Uuid
  /**
   * `domain.action`, e.g. "users.invite", "pv.sign_icsr", "platform.registrations.review".
   */
  key         String @unique
  description String

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

// ── Phase 4.1 — Country Rules Engine ───────────────────────────────────────
//
// Every config table here shares one shape: `version` (int, starts at 1),
// `status` (draft|active|retired), `effectiveFrom`. There is deliberately
// no UPDATE path in the service layer — changing a rule creates version
// N+1 as `draft`, then an activation step retires the old `active` row and
// flips the new one, both in one transaction (see phase4_1_config_versioning
// migration for the partial unique indexes enforcing "one active version
// per natural key" at the DB level, not just in application code).
//
// `unverified` on ReportingRule exists because of a real, open question
// (`docs/safemeds-domain-knowledge.md` Q1): Kenya/PPB's actual reporting
// windows conflict between source documents (15 days flat vs. 7/15 split).
// Kenya's rows are seeded `unverified: true` and never `active`, so
// `RuleResolutionService` structurally cannot return a real deadline for
// them until a human resolves Q1 — the alternative (guessing) would
// silently compute wrong legal deadlines.

enum ConfigStatus {
  draft
  active
  retired
}

enum DayType {
  calendar
  business
}

enum SubmissionChannel {
  vigiflow
  dhis2
  portal
  paper_pdf
  /**
   * RegCloud (Phase 12) Stage 4 — some authorities accept a registration/dossier submission by email rather than a live portal or physical courier; `paper_pdf` alone would have mislabeled that.
   */
  email
}

model RegulatoryAuthority {
  id              String  @id @db.Uuid
  countryId       String  @map("country_id") @db.Uuid
  country         Country @relation(fields: [countryId], references: [id])
  /**
   * PPB, NDA, TMDA, Rwanda FDA, EFDA, NAFDAC, SAHPRA, NVIP-DHIS2 (Kenya's
   * AEFI channel is a *different* authority than PPB — see FORM F5).
   */
  code            String
  name            String
  /**
   * VigiCloud Stage 12 — official-document letterhead fields, all
   * deliberately nullable. A real, previously-flagged content gap
   * (CLAUDE.md's own domain-knowledge notes: "only Kenya has real
   * rules/forms/deadlines... data" — the other 8 seeded authorities are
   * bare name rows) extends to this too: gathering the real ministry
   * name/address/form code/emblem for Uganda's NDA, Tanzania's TMDA, etc.
   * is content-gathering work for a field expert, not an engineering
   * task. `RegulatorySubmissionPdfService` renders a complete, honest,
   * text-only letterhead (authority name + country) when these are
   * null — never a placeholder or a guessed value. Kenya's PPB row is
   * seeded with its real values, transcribed directly from the real
   * PPB E2B report sample in `vigicloud docs/E2b5318.pdf`.
   */
  formCode        String? @map("form_code")
  ministryName    String? @map("ministry_name")
  poBoxAddress    String? @map("po_box_address")
  phone           String?
  contactEmail    String? @map("contact_email")
  /**
   * A lookup key into the small set of bundled, version-controlled
   * emblem image assets (`src/modules/regulatory-submission/assets/`) —
   * the small set of emblems sourced and vetted at build time (Kenya's
   * real Coat of Arms, extracted from the real PPB E2B sample). Real,
   * previously-flagged real-usage feedback (19 Aug 2026): with a single-
   * engineer team, requiring an engineer to add every other country's
   * emblem to the codebase before it can be used isn't workable —
   * `emblemObjectKey` below is the real per-authority admin-upload path
   * every country other than Kenya should actually use. This field is
   * kept only as the one already-bundled fallback; `emblemObjectKey`
   * takes priority whenever both are set. Null renders no emblem at all
   * (never a fabricated or wrong one).
   */
  emblemAssetKey  String? @map("emblem_asset_key")
  /**
   * VigiCloud real-usage feedback, 19 Aug 2026 — an admin (including a
   * non-engineer field expert) uploads this authority's real emblem
   * image directly, server-proxied through `StorageService.putObject()`
   * exactly like the pre-existing licence-upload path (no R2 CORS
   * needed). The R2/S3 object key, not a `Document` row — a
   * `RegulatoryAuthority` is a platform-wide, not company-scoped,
   * entity, so it can't own a row in the company-scoped `Document`
   * table the way every other upload in this app does.
   */
  emblemObjectKey String? @map("emblem_object_key")

  reportingRules               ReportingRule[]
  seriousnessDefs              SeriousnessDefinition[]
  submissionFormats            SubmissionFormat[]
  productRegistrations         ProductRegistration[]
  regulatorySubmissions        RegulatorySubmission[]
  auditRequirementDefinitions  AuditRequirementDefinition[]
  inspectionChecklistTemplates InspectionChecklistTemplate[]

  // RegCloud (Phase 12) Stage 0 — country rule-set graph + deadline engine.
  regRequirements                RegulatoryRequirement[]
  regFeeSchedules                RegulatoryFeeSchedule[]
  regDeadlineRules               RegDeadlineRule[]
  regDossiers                    RegDossier[]
  regSubmissions                 RegSubmission[]
  importExportPermits            ImportExportPermit[]
  promotionalMaterialSubmissions PromotionalMaterialSubmission[]
  relianceApplicationsAsLead     RelianceApplication[]
  productClassDefinitions        ProductClassDefinition[]
  recallRuleSets                 RecallRuleSet[]
  recallCountries                RecallCountry[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([countryId, code])
  @@map("regulatory_authority")
}

model ReportType {
  id        String @id @db.Uuid
  /**
   * adr | quality_complaint | medication_error | device_incident | aefi | transfusion_reaction — the six official Kenyan PPB/MoH forms; other authorities may configure fewer or more.
   */
  typeKey   String @unique @map("type_key")
  name      String
  /**
   * VigiCloud Stage 0.10 — which domain module this report type belongs
   * to (`pv` today; `qualcloud`/`regcloud` once those modules seed their
   * own report types). Backfilled to `pv` for the six existing Kenya rows
   * — every `ReportType` seeded before this column existed was, in fact,
   * PV-only. Plain string, not an enum, so a future module can register
   * its own key without a schema migration.
   */
  moduleKey String @default("pv") @map("module_key")

  reportingRules      ReportingRule[]
  formSchemas         FormSchema[]
  submissionFormats   SubmissionFormat[]
  workflowDefinitions WorkflowDefinition[]
  pvCases             Case[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("report_type")
}

model ReportingRule {
  id                    String              @id @db.Uuid
  authorityId           String              @map("authority_id") @db.Uuid
  authority             RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  reportTypeId          String              @map("report_type_id") @db.Uuid
  reportType            ReportType          @relation(fields: [reportTypeId], references: [id])
  seriousnessClass      String              @map("seriousness_class")
  windowDays            Int                 @map("window_days")
  dayType               DayType             @default(calendar) @map("day_type")
  /**
   * What starts the clock — currently always "awareness_date" (when the company first learned of the event), per every PPB form's own convention.
   */
  clockStart            String              @default("awareness_date") @map("clock_start")
  /**
   * True for any row whose window_days is not yet confirmed against an authoritative source — see Q1. Never resolvable to `active`.
   */
  unverified            Boolean             @default(false)
  /**
   * VigiCloud Stage 0.11 — nullable, additive: an arbitrary periodic
   * reporting cadence in days (e.g. 28 for "every 4 weeks", 35 for
   * "every 5 weeks"), for report types whose obligation is a recurring
   * cadence (line listings, PSUR-family periodic reports) rather than an
   * incident-triggered deadline. Deliberately separate from `windowDays`
   * (that's the ADR/device-incident notification clock, always set,
   * always incident-triggered) — a single `ReportingRule` row is never
   * both at once; which one applies depends on the linked `ReportType`.
   */
  reportingPeriodDays   Int?                @map("reporting_period_days")
  /**
   * VigiCloud Stage 13 — "regulator" (the default, and every rule seeded
   * before this column existed) for the normal MAH-to-national-authority
   * path; "ethics_committee_and_trial_portal" for the one structurally
   * different destination this build models — a clinical-trial SAE never
   * goes to PPB. Plain string, not an enum, matching `seriousnessClass`'s
   * own precedent: a future module might add a third destination without
   * a schema migration. Purely descriptive metadata — `RuleResolutionService`
   * still resolves a rule the same way regardless of this value (by
   * authority/reportType/seriousnessClass), since the "ethics committee"
   * destination is itself modeled as its own `RegulatoryAuthority` row,
   * not a special case in the resolution query.
   */
  submissionDestination String              @default("regulator") @map("submission_destination")
  /**
   * Admin Configuration Console — plain-text citation for where this
   * exact number came from (e.g. "GUD/022 §6.1"), shown alongside the
   * rule in the admin UI. Optional/nullable: several already-confirmed
   * rules predate this field and their citation only exists in
   * CLAUDE.md's prose today; new/edited rules should always set it.
   * Never read by any resolution logic — descriptive metadata only,
   * same treatment as `submissionDestination`'s own doc comment.
   */
  sourceReference       String?             @map("source_reference")
  version               Int                 @default(1)
  status                ConfigStatus        @default(draft)
  effectiveFrom         DateTime            @map("effective_from") @db.Date
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  deadlines Deadline[]

  @@index([authorityId, reportTypeId, seriousnessClass, status])
  @@map("reporting_rule")
}

model SeriousnessDefinition {
  id            String              @id @db.Uuid
  authorityId   String              @map("authority_id") @db.Uuid
  authority     RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  /**
   * hospitalisation | disability | congenital_anomaly | life_threatening | death — per FOM001 §8.III; deliberately NOT "other medically important" (not on the Kenyan form).
   */
  criterionKey  String              @map("criterion_key")
  label         String
  version       Int                 @default(1)
  status        ConfigStatus        @default(draft)
  effectiveFrom DateTime            @map("effective_from") @db.Date
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([authorityId, criterionKey, status])
  @@map("seriousness_definition")
}

model FormSchema {
  id               String       @id @db.Uuid
  /**
   * null = global default for this report type, used until/unless a country overrides it.
   */
  countryId        String?      @map("country_id") @db.Uuid
  country          Country?     @relation(fields: [countryId], references: [id])
  reportTypeId     String       @map("report_type_id") @db.Uuid
  reportType       ReportType   @relation(fields: [reportTypeId], references: [id])
  version          Int          @default(1)
  /**
   * The digitised official form — field definitions, section grouping, checklist options — consumed by the FE's generic form-rendering engine.
   */
  jsonSchema       Json         @map("json_schema")
  /**
   * e.g. "FOM001/MIP/PMS/SOP/001" — printed on every PPB form for traceability back to the source document.
   */
  officialFormCode String?      @map("official_form_code")
  status           ConfigStatus @default(draft)
  effectiveFrom    DateTime     @map("effective_from") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([countryId, reportTypeId, status])
  @@map("form_schema")
}

model SubmissionFormat {
  id            String              @id @db.Uuid
  authorityId   String              @map("authority_id") @db.Uuid
  authority     RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  reportTypeId  String              @map("report_type_id") @db.Uuid
  reportType    ReportType          @relation(fields: [reportTypeId], references: [id])
  version       Int                 @default(1)
  /**
   * Field mapping from SafeMeds' internal case shape to the authority's expected output — VigiFlow E2B, a DHIS2 payload shape, etc.
   */
  templateRef   String              @map("template_ref")
  channel       SubmissionChannel
  status        ConfigStatus        @default(draft)
  effectiveFrom DateTime            @map("effective_from") @db.Date
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([authorityId, reportTypeId, status])
  @@map("submission_format")
}

// ── Phase 4.1 — Multi-market tenancy ───────────────────────────────────────
//
// Company.homeCountryId (Phase 1) is the country used at registration.
// CompanyMarket is every *additional* market a company operates in —
// closes the "tenant operates in multiple countries" gap: which country's
// rules/forms apply to a given case is resolved from the reporting
// Facility's own countryId, not the company's home country.

model CompanyMarket {
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  countryId   String   @map("country_id") @db.Uuid
  country     Country  @relation(fields: [countryId], references: [id])
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz(3)

  @@id([companyId, countryId])
  @@map("company_market")
}

model Facility {
  id                       String    @id @db.Uuid
  companyId                String    @map("company_id") @db.Uuid
  company                  Company   @relation(fields: [companyId], references: [id])
  /**
   * Which country's rules/forms govern cases reported from this facility.
   * A company with only `homeCountryId` set (no CompanyMarket rows yet)
   * still only ever has facilities in that one country; this field is what
   * actually generalizes to multi-market companies once they add one.
   */
  countryId                String    @map("country_id") @db.Uuid
  country                  Country   @relation(fields: [countryId], references: [id])
  name                     String
  /**
   * MFL / facility code — the "Facility Code" field on every PPB form.
   */
  facilityCode             String?   @map("facility_code")
  /**
   * Kenya-shaped admin division fields for now (county/sub-county are what every PPB form asks for); Phase 4.2+ can generalize this per-country if a non-Kenya market needs different terms.
   */
  county                   String?
  subCounty                String?   @map("sub_county")
  address                  String?
  phone                    String?
  isActive                 Boolean   @default(true) @map("is_active")
  /**
   * RegCloud (Phase 12) Stage 10 — Establishment/Premises Licensing. A
   * facility's own regulatory operating licence (e.g. a Kenyan pharmacy
   * premises licence), distinct from the rest of `Facility` (which
   * predates RegCloud and just describes *where* a facility is).
   * `licenceExpiresOn` is always the tenant's own authoritative,
   * directly-entered value — deliberately **not** auto-computed from a
   * `RegDeadlineRule` the way `ProductRegistration.expiresOn` is: a
   * facility's premises licence has no single natural `RegulatoryAuthority`
   * to key a rule off (a country can have several — Kenya's PPB, NVIP,
   * and the synthetic Ethics Committee authority all coexist), so
   * `RegLicensingExpiryService` scans this field directly instead of
   * going through `RegDeadline`/`RegDeadlineRule` at all — see that
   * service's own doc comment for the full reasoning.
   */
  licenceNumber            String?   @map("licence_number")
  licenceIssuedOn          DateTime? @map("licence_issued_on") @db.Date
  licenceExpiresOn         DateTime? @map("licence_expires_on") @db.Date
  /**
   * Plain string — `active | expired | suspended` — null until a licence is ever recorded.
   */
  licenceStatus            String?   @map("licence_status")
  licenceDocumentId        String?   @map("licence_document_id") @db.Uuid
  licenceDocument          Document? @relation("facility_licence_document", fields: [licenceDocumentId], references: [id])
  /**
   * Never-re-flag guard for the 90-day "approaching" reminder — matching `RegFeeInvoice.notifiedOverdueAt`'s own precedent, cleared whenever `licenceExpiresOn` changes (a renewal recorded) so the next cycle can notify again.
   */
  licenceRenewalNotifiedAt DateTime? @map("licence_renewal_notified_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  userLocationScopes UserLocationScope[]
  qualityEquipment   Equipment[]
  environmentalMonitoringResults EnvironmentalMonitoringResult[]

  @@index([companyId])
  @@map("facility")
}

/**
 * RegCloud (Phase 12) Stage 10 — an individual staff member's own
 * professional regulatory registration (a pharmacist's practising
 * licence, a Superintendent Pharmacist designation) — a regulatory fact
 * about a *person*, deliberately not folded into `User` itself (the
 * same reasoning `QppvNomination` already established for QPPV:
 * eligibility/status is domain data, not an auth concept). One user can
 * hold more than one licence over time (renewals) or concurrently
 * (multiple licence types) — never delete, only deactivate via `status`.
 */
model PersonnelLicence {
  id                String    @id @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  company           Company   @relation(fields: [companyId], references: [id])
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation("personnel_licence_holder", fields: [userId], references: [id])
  /**
   * Plain string, not an enum — e.g. `pharmacist`, `superintendent_pharmacist` — matching every other "the exact real category list is still a content question" field in this document (`RegVariation.variationType`, `RegulatoryFeeSchedule.feeType`).
   */
  licenceType       String    @map("licence_type")
  licenceNumber     String    @map("licence_number")
  issuedOn          DateTime  @map("issued_on") @db.Date
  /**
   * Authoritative, same reasoning as `Facility.licenceExpiresOn` above.
   */
  expiresOn         DateTime? @map("expires_on") @db.Date
  /**
   * Plain string — `active | expired | suspended | revoked`.
   */
  status            String    @default("active")
  licenceDocumentId String?   @map("licence_document_id") @db.Uuid
  licenceDocument   Document? @relation("personnel_licence_document", fields: [licenceDocumentId], references: [id])
  /**
   * Never-re-flag guard for the 90-day "approaching" reminder — same precedent as `Facility.licenceRenewalNotifiedAt`.
   */
  renewalNotifiedAt DateTime? @map("renewal_notified_at") @db.Timestamptz(3)
  createdBy         String?   @map("created_by") @db.Uuid
  creator           User?     @relation("personnel_licence_created_by", fields: [createdBy], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, userId])
  @@map("personnel_licence")
}

// ── Phase 5 — Workflow Engine & Deadlines ──────────────────────────────────
//
// `WorkflowDefinition` reuses Phase 4's exact version-on-write shape
// (`version`/`status: ConfigStatus`) for consistency, though the MVP only
// ships a seeded v1 read via list/detail — no createVersion/activate
// endpoints yet ("authoring UI is future" per the build spec).
//
// `WorkflowInstance` is deliberately `companyId`-less, matching the
// canonical ERD (`docs/safemeds-erd-v2.mermaid`) exactly — it's polymorphic
// (`recordType`/`recordId`) infrastructure sitting ahead of any module that
// has a concrete tenant-owned record yet (VigiCloud/PV_CASE is Phase 11).
// Tenant isolation is the caller's responsibility (whoever already scoped
// access to the underlying record), not Postgres RLS. `Deadline` *is*
// tenant-owned (`companyId` on the ERD) and gets a real RLS policy,
// following the phase2_3 template exactly.

model WorkflowDefinition {
  id           String       @id @db.Uuid
  recordType   String       @map("record_type")
  reportTypeId String?      @map("report_type_id") @db.Uuid
  reportType   ReportType?  @relation(fields: [reportTypeId], references: [id])
  countryId    String?      @map("country_id") @db.Uuid
  country      Country?     @relation(fields: [countryId], references: [id])
  version      Int          @default(1)
  status       ConfigStatus @default(draft)

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("workflow_definition")
}

model WorkflowState {
  id           String             @id @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id])
  stateKey     String             @map("state_key")
  name         String
  isInitial    Boolean            @default(false) @map("is_initial")
  isTerminal   Boolean            @default(false) @map("is_terminal")

  transitionsFrom WorkflowTransition[] @relation("transition_from_state")
  transitionsTo   WorkflowTransition[] @relation("transition_to_state")
  instancesHere   WorkflowInstance[]

  @@unique([definitionId, stateKey])
  @@map("workflow_state")
}

model WorkflowTransition {
  id                String             @id @db.Uuid
  definitionId      String             @map("definition_id") @db.Uuid
  definition        WorkflowDefinition @relation(fields: [definitionId], references: [id])
  fromStateId       String             @map("from_state_id") @db.Uuid
  fromState         WorkflowState      @relation("transition_from_state", fields: [fromStateId], references: [id])
  toStateId         String             @map("to_state_id") @db.Uuid
  toState           WorkflowState      @relation("transition_to_state", fields: [toStateId], references: [id])
  requiredRoleId    String             @map("required_role_id") @db.Uuid
  requiredRole      Role               @relation(fields: [requiredRoleId], references: [id])
  requiresSignature Boolean            @default(false) @map("requires_signature")

  @@unique([definitionId, fromStateId, toStateId])
  @@map("workflow_transition")
}

model WorkflowInstance {
  id             String             @id @db.Uuid
  definitionId   String             @map("definition_id") @db.Uuid
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id])
  recordType     String             @map("record_type")
  recordId       String             @map("record_id") @db.Uuid
  currentStateId String             @map("current_state_id") @db.Uuid
  currentState   WorkflowState      @relation(fields: [currentStateId], references: [id])
  enteredAt      DateTime           @default(now()) @map("entered_at") @db.Timestamptz(3)
  /**
   * Optimistic concurrency per system-wide convention — `transition()` reads
   * this, and its row-lock + update inside one transaction is what makes
   * concurrent transition attempts on the same instance safe.
   */
  version        Int                @default(1)

  @@unique([recordType, recordId])
  @@index([definitionId])
  @@map("workflow_instance")
}

enum DeadlineStatus {
  pending
  met
  missed
  recalculated
}

model Deadline {
  id              String         @id @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  company         Company        @relation(fields: [companyId], references: [id])
  recordType      String         @map("record_type")
  recordId        String         @map("record_id") @db.Uuid
  reportingRuleId String         @map("reporting_rule_id") @db.Uuid
  reportingRule   ReportingRule  @relation(fields: [reportingRuleId], references: [id])
  dueAt           DateTime       @map("due_at") @db.Timestamptz(3)
  status          DeadlineStatus @default(pending)
  /**
   * Escalation-tracking columns for the hourly BullMQ scan (5.3): each is
   * set once and never cleared, so the job never double-notifies the same
   * threshold even across restarts.
   */
  t72NotifiedAt   DateTime?      @map("t72_notified_at") @db.Timestamptz(3)
  t24NotifiedAt   DateTime?      @map("t24_notified_at") @db.Timestamptz(3)
  breachedAt      DateTime?      @map("breached_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([recordType, recordId])
  @@index([companyId, status, dueAt])
  @@map("deadline")
}

// ── Phase 6 — Electronic Signatures ────────────────────────────────────────
//
// Append-only, exactly like `AuditEntry` — same REVOKE-UPDATE/DELETE +
// immutability-trigger migration pattern (see the phase3_1_audit_immutability
// migration this one copies), and tenant-scoped via `RlsService.runAsCompany`
// at the query layer rather than a Postgres RLS policy, for the same reason
// audit_entry doesn't have one: consistency between the two sibling
// append-only tables rather than asymmetric enforcement.

model SignatureEvent {
  id               String   @id @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  company          Company  @relation(fields: [companyId], references: [id])
  recordType       String   @map("record_type")
  recordId         String   @map("record_id") @db.Uuid
  recordHashSha256 String   @map("record_hash_sha256")
  /**
   * The exact canonical (stable-key-order) payload that was hashed — stored so `verify()` can recompute `recordHashSha256` from *this* (proving the persisted hash itself hasn't been tampered with) rather than depending on the signed record's live/mutable state. Deliberately not in the source ERD, which lists only the hash column — added because several signable record types (e.g. a `WorkflowInstance`, which keeps progressing after it's signed) have no stable "current state" a hash could otherwise be meaningfully recomputed against.
   */
  canonicalPayload Json     @map("canonical_payload")
  signerId         String   @map("signer_id") @db.Uuid
  signer           User     @relation(fields: [signerId], references: [id])
  /**
   * The signer's role key at the moment of signing — copied, not looked up live, so a later role change can never rewrite what a past signature legally attested to.
   */
  roleAtSigning    String   @map("role_at_signing")
  intentStatement  String   @map("intent_statement")
  signedAt         DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)
  /**
   * Always "password_reauth" for now (+MFA when the company's security policy requires it for this role) — see Phase 1.9's re-auth token.
   */
  authMethod       String   @map("auth_method")

  @@index([companyId, recordType, recordId])
  @@map("signature_event")
}

// ── Phase 7 — Master Data ───────────────────────────────────────────────────
//
// CRUD is create/read/update only — deactivate (`isActive`/`status`), never
// delete, per the build spec — shared by all future modules so a batch
// number in a safety case links to the same row a quality record
// references. `Batch`/`ProductRegistration` denormalize `companyId`
// (the canonical ERD only puts it on `Product`) the same way `Deadline`
// and `SignatureEvent` already denormalize it despite being reachable via
// a join — needed so direct Postgres RLS policies can apply to them
// without a cross-table subquery.

enum ProductCategory {
  medicinal
  blood_product
  herbal
  cosmeceutical
  vaccine
  device_ivd
  other
}

model Product {
  id                     String          @id @db.Uuid
  companyId              String          @map("company_id") @db.Uuid
  company                Company         @relation(fields: [companyId], references: [id])
  brandName              String          @map("brand_name")
  genericName            String          @map("generic_name")
  productCategory        ProductCategory @map("product_category")
  dosageForm             String          @map("dosage_form")
  strength               String
  /**
   * VigiCloud Stage 2 — the PV-mandatory landing-page fields per the Final
   * build doc §C, plus the INN-name gap Robert's own discovery doc
   * surfaced (`docs/SafeMeds Discovery Robert QMS & Reg.docx` §8.1 — INN
   * is distinct from `genericName`, which is this company's own preferred
   * generic label, not necessarily the WHO International Nonproprietary
   * Name). All nullable, not because they're optional in principle but
   * because this table already has real rows from Phase 7 with none of
   * them populated — a NOT NULL column here would break the migration
   * against existing data. `atcCode` in particular is genuinely optional
   * in practice too, not just for migration safety: `productCategory`
   * includes `blood_product`/`herbal`/`cosmeceutical`/`device_ivd`, and
   * WHO's ATC classification only meaningfully applies to `medicinal`/
   * `vaccine` products — forcing it for every category would be wrong,
   * not just inconvenient, so `CreateProductDto` doesn't mark it
   * `@IsNotEmpty()` either, despite the source doc's "mandatory" wording.
   */
  innName                String?         @map("inn_name")
  atcCode                String?         @map("atc_code")
  /**
   * Distinct from `dosageForm` (tablet/capsule/injection, already above) — release-profile detail like "extended release" or "enteric coated", per the Final doc's own separate listing of the two.
   */
  formulation            String?
  routeOfAdministration  String?         @map("route_of_administration")
  siteOfManufacture      String?         @map("site_of_manufacture")
  /**
   * A real product often ships in more than one pack size (e.g. "10s blister", "30s bottle") — a string array, not a single field.
   */
  packSizes              String[]        @default([]) @map("pack_sizes")
  isActive               Boolean         @default(true) @map("is_active")
  /**
   * VigiCloud Stage 18 — the EURD-list anchor date for PSUR/PBRER
   * periodicity (GUD/022 §6.2's confirmed cadence: every 6 months for
   * the first 2 years on market, annually for the next 2, then every 3
   * years thereafter — all computed from this single date). Nullable,
   * additive, same reasoning as `innName`/`atcCode` above: this table
   * already has real rows from Phase 7 with nothing in this column, and
   * not every product category needs one (a `PeriodicReportService`
   * generation attempt with this unset fails with a clear, specific
   * error rather than silently guessing a date).
   */
  internationalBirthDate DateTime?       @map("international_birth_date") @db.Date
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations                  ProductRegistration[]
  batches                        Batch[]
  suspectProducts                SuspectProduct[]
  riskManagementPlans            RiskManagementPlan[]
  safetyAlerts                   SafetyAlert[]
  signals                        Signal[]
  regDossiers                    RegDossier[]
  importExportPermits            ImportExportPermit[]
  promotionalMaterialSubmissions PromotionalMaterialSubmission[]
  recalls                        Recall[]
  relianceApplications           RelianceApplication[]
  qualitySpecifications          Specification[]
  qualitySops                    Sop[]
  qualityDeviations              Deviation[]
  qualityChangeControls          ChangeControl[]
  qualityComplaints              Complaint[]
  recallScopeItems               RecallScopeItem[]
  pqrs                           Pqr[]
  wasteDisposalRecords           WasteDisposalRecord[]
  falsifiedProductReports        FalsifiedProductReport[]
  validationProtocols            ValidationProtocol[]
  stabilityStudies               StabilityStudy[]

  @@index([companyId])
  @@map("product")
}

enum ProductRegistrationStatus {
  active
  expired
  withdrawn
  suspended
}

model ProductRegistration {
  id                       String                    @id @db.Uuid
  companyId                String                    @map("company_id") @db.Uuid
  company                  Company                   @relation(fields: [companyId], references: [id])
  productId                String                    @map("product_id") @db.Uuid
  product                  Product                   @relation(fields: [productId], references: [id])
  authorityId              String                    @map("authority_id") @db.Uuid
  authority                RegulatoryAuthority       @relation(fields: [authorityId], references: [id])
  registrationNumber       String                    @map("registration_number")
  status                   ProductRegistrationStatus @default(active)
  issuedOn                 DateTime                  @map("issued_on") @db.Date
  expiresOn                DateTime                  @map("expires_on") @db.Date
  /**
   * RegCloud (Phase 12) Stage 0.2 — the Regulatory Entity & Hierarchy Model.
   * All nullable for the same migration-safety reason `Product.innName`
   * etc. are (VigiCloud Stage 2's own precedent, quoted on that field) —
   * this table already has real rows from base-engine Phase 7 with none of
   * this populated. `mahName`/`mahCountry` are plain strings, not a
   * `Company`/`Country` FK — the Marketing Authorization Holder is very
   * often a foreign principal with no SafeMeds tenant account at all, so
   * there is nothing to link to.
   */
  manufacturingSiteId      String?                   @map("manufacturing_site_id") @db.Uuid
  manufacturingSite        ManufacturingSite?        @relation(fields: [manufacturingSiteId], references: [id])
  localRepresentativeId    String?                   @map("local_representative_id") @db.Uuid
  localRepresentative      LocalRepresentative?      @relation(fields: [localRepresentativeId], references: [id])
  mahName                  String?                   @map("mah_name")
  mahCountry               String?                   @map("mah_country")
  /**
   * PPB's own 7-class taxonomy (RegCloud Stage 1's Classify & Plan output),
   * carried onto the registration once one is issued. Nullable for the same
   * pre-existing-data reason as the fields above; `RegDossier.productClass`
   * is the version captured at classification time, this is what actually
   * ended up registered — the two should agree once Stage 6 wires approval
   * through, but are deliberately separate columns rather than one shared
   * value, matching this schema's general "don't let two different lifecycle
   * moments silently share a mutable field" instinct.
   */
  productClass             String?                   @map("product_class")
  /**
   * The reverse link — `RegDossier.productRegistrationId` — is on
   * `RegDossier` itself, not here, since one registration can accumulate
   * several dossiers over its lifetime (the original application, plus a
   * new one per Stage 7 variation/renewal); a single FK here couldn't
   * represent that.
   */
  regDossiers              RegDossier[]
  regFeeInvoices           RegFeeInvoice[]
  /**
   * RegCloud (Phase 12) Stage 7 — every variation/renewal ever filed against this registration, never deleted.
   */
  regVariations            RegVariation[]
  /**
   * RegCloud (Phase 12) Stage 8 — every recurring post-market compliance cycle tracked against this registration.
   */
  regPostMarketObligations RegPostMarketObligation[]
  /**
   * RegCloud (Phase 12) Stage 11 — every import/export permit linked to this registration, once it has one.
   */
  importExportPermits      ImportExportPermit[]
  /**
   * testing-correction-explanation.md §3.3 — every yearly retention ever
   * logged against this registration, never deleted; at most one per
   * calendar `year` is enforced by a real DB-level unique constraint on
   * `RegRetention` itself (`@@unique([productRegistrationId, year])`),
   * not just an application-side check — a genuine duplicate here would
   * be a compliance record error, not something to leave to a race
   * condition.
   */
  regRetentions            RegRetention[]
  /**
   * testing-correction-explanation.md §3.6 — Withdrawal, decision #1: a
   * required reason plus an optional supporting document, signature-
   * gated, permanent. Replaces the old, un-gated `deactivateRegistration()`
   * primitive for this specific record type — reaching the exact same
   * `status: withdrawn` value, just through a real, audited, evidenced
   * action rather than a bare status flip.
   */
  withdrawnAt              DateTime?                 @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnReason          String?                   @map("withdrawn_reason")
  withdrawnBy              String?                   @map("withdrawn_by") @db.Uuid
  withdrawnByUser          User?                     @relation("product_registration_withdrawn_by", fields: [withdrawnBy], references: [id])
  withdrawalDocumentId     String?                   @map("withdrawal_document_id") @db.Uuid
  withdrawalDocument       Document?                 @relation("product_registration_withdrawal", fields: [withdrawalDocumentId], references: [id])
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /**
   * QualCloud (Phase 13) Stage 4 — every Change Control that flagged this registration as regulatorily affected.
   */
  changeControls ChangeControl[]

  @@index([companyId])
  @@index([productId])
  @@index([companyId, expiresOn])
  @@map("product_registration")
}

model Batch {
  id                  String             @id @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  company             Company            @relation(fields: [companyId], references: [id])
  productId           String             @map("product_id") @db.Uuid
  product             Product            @relation(fields: [productId], references: [id])
  batchNumber         String             @map("batch_number")
  manufacturedOn      DateTime           @map("manufactured_on") @db.Date
  expiresOn           DateTime           @map("expires_on") @db.Date
  isActive            Boolean            @default(true) @map("is_active")
  /**
   * QualCloud (Phase 13) Stage 7 — real batch quantity, kept as free-form
   * text/unit pair rather than forcing a single numeric-plus-enum shape
   * this early (a company's own pack-size conventions vary too much to
   * standardize ahead of real usage, matching this schema's own "don't
   * build ahead of confirmed need" discipline).
   */
  batchSize           String?            @map("batch_size")
  unit                String?
  /**
   * Real genealogy — the upstream batch/lot references this batch was
   * made from (e.g. the API lots that went into this finished-product
   * batch). A plain string array rather than a full graph table until
   * real usage shows a graph query is needed — `BatchTraceabilityService
   * .trace()` walks this both directions by simple lookup.
   */
  parentBatchIds      String[]           @default([]) @map("parent_batch_ids")
  manufacturingSiteId String?            @map("manufacturing_site_id") @db.Uuid
  manufacturingSite   ManufacturingSite? @relation(fields: [manufacturingSiteId], references: [id])
  /**
   * The real, standard pharma batch-status lifecycle — given any batch,
   * its current disposition. `released`/`rejected`/`reworked` are
   * normally set by `BatchRecordReviewService.recordDisposition()`
   * (e-signature-gated); `recalled` is set by the existing Recall
   * module when this batch is swept into a real recall.
   */
  qualityStatus       String             @default("quarantine") @map("quality_status")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  qualityDeviations         Deviation[]
  changeControls            ChangeControl[]
  complaints                Complaint[]
  oosRecords                Oos[]
  recordReviews             BatchRecordReview[]
  recallScopeItems          RecallScopeItem[]
  recallDistributionRecords RecallDistributionRecord[]
  recallQuarantineRecords   RecallQuarantineRecord[]
  recallReturnRecords       RecallReturnRecord[]
  wasteDisposalRecords      WasteDisposalRecord[]
  falsifiedProductReports   FalsifiedProductReport[]
  batchReleaseDecisions     BatchReleaseDecision[]
  stabilityStudies          StabilityStudy[]

  @@index([companyId])
  @@index([productId])
  @@map("batch")
}

// MedDRA is global reference data (no companyId) — shared by every tenant,
// same as Country/RegulatoryAuthority. Real MSSO release import is blocked
// on licence (flagged to CEO per the build spec); a seeded mock subset
// keeps development honest until that's resolved.

model MeddraVersion {
  id           String   @id @db.Uuid
  versionLabel String   @unique @map("version_label")
  releasedOn   DateTime @map("released_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  terms MeddraTerm[]

  @@map("meddra_version")
}

enum MeddraLevel {
  SOC
  HLGT
  HLT
  PT
  LLT
}

model MeddraTerm {
  id              String         @id @db.Uuid
  versionId       String         @map("version_id") @db.Uuid
  version         MeddraVersion  @relation(fields: [versionId], references: [id])
  code            String
  level           MeddraLevel
  name            String
  parentId        String?        @map("parent_id") @db.Uuid
  parent          MeddraTerm?    @relation("meddra_term_parent", fields: [parentId], references: [id])
  children        MeddraTerm[]   @relation("meddra_term_parent")
  pvAdverseEvents AdverseEvent[]

  @@unique([versionId, code])
  @@index([versionId, level])
  @@map("meddra_term")
}

/**
 * VigiCloud Stage 7 — the WHODrug Global counterpart to `MeddraVersion`,
 * same global-reference-data shape (no `companyId`, no RLS, shared by
 * every tenant). Real WHODrug Global is a paid UMC subscription (see
 * `needs.md` §12) — the same commercial-dependency shape already flagged
 * for MedDRA. Until that subscription exists, `who-drug.seed-data.ts`'s
 * mock subset is what the rest of the app is built and tested against,
 * mirroring the existing `meddra.seed-data.ts` mock pattern exactly.
 */
model WhoDrugVersion {
  id           String   @id @db.Uuid
  versionLabel String   @unique @map("version_label")
  releasedOn   DateTime @map("released_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  terms WhoDrugTerm[]

  @@map("who_drug_version")
}

/**
 * A deliberately simplified stand-in for WHODrug Global's real "Format B3"
 * hierarchy (Drug Record Number → Medicinal Product ID → ATC-linked
 * substance entries). Unlike `import-meddra.command.ts` — which parses a
 * format the MSSO publishes openly even without a licence — WHODrug's
 * exact B3 file layout is only documented inside UMC's own licensed
 * distribution, so there is deliberately no `import:whodrug` command in
 * this build: writing a parser against an unseen format would be
 * guesswork, not real reuse, unlike MedDRA's case. A real importer needs
 * to be built once the actual file layout has been seen firsthand.
 * `drugRecordNumber` mirrors WHODrug's own DRN concept (one entry per
 * trade-name/generic-name combination); `atcCode` deliberately reuses the
 * same convention as `Product.atcCode`/`SuspectProduct.atcCode` elsewhere
 * in this schema, not a WHODrug-specific format.
 */
model WhoDrugTerm {
  id               String           @id @db.Uuid
  versionId        String           @map("version_id") @db.Uuid
  version          WhoDrugVersion   @relation(fields: [versionId], references: [id])
  drugRecordNumber String           @map("drug_record_number")
  name             String
  substanceName    String?          @map("substance_name")
  atcCode          String?          @map("atc_code")
  suspectProducts  SuspectProduct[]

  @@unique([versionId, drugRecordNumber])
  @@index([versionId])
  @@map("who_drug_term")
}

// ── Phase 8 — Documents & Storage ────────────────────────────────────────────
//
// `Document` is the logical container (one row per "thing" attached to a
// record — a licence, an SOP, a PSMF); `DocumentVersion` is an actual
// uploaded file. Same polymorphic `recordType`/`recordId` convention as
// `AuditEntry`/`SignatureEvent` — a document can attach to any record type
// (company, product, product_registration, facility, ...) without a
// dedicated FK per type. New upload = new `DocumentVersion` row, never an
// overwrite of an existing one — mirrors the "never delete" convention used
// everywhere else in this schema, just for files instead of database rows.

enum DocumentVersionStatus {
  pending
  stored
  failed
}

model Document {
  id         String   @id @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  title      String
  /**
   * Nullable for the same reason `Case.createdBy` is (VigiCloud Stage 3) —
   * a WhatsApp-attached packaging photo is uploaded by
   * `WhatsAppIntakeService` with no logged-in human actor at all.
   */
  createdBy  String?  @map("created_by") @db.Uuid
  creator    User?    @relation(fields: [createdBy], references: [id])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions                                DocumentVersion[]
  pvSourceDocuments                       SourceDocument[]                     @relation("source_document_original")
  /**
   * VigiCloud Stage 3.7 — the redacted-copy upload slot, distinct from the original artifact this `Document` otherwise represents.
   */
  pvRedactedCopyFor                       SourceDocument[]                     @relation("source_document_redacted_copy")
  /**
   * VigiCloud Stage 12 — the three named document slots a `RegulatorySubmission` holds, mirroring `SourceDocument`'s own original/redacted-copy precedent for "a fixed, known number of document roles on one record."
   */
  regulatorySubmissionXmlFor              RegulatorySubmission[]               @relation("regulatory_submission_xml")
  regulatorySubmissionPdfFor              RegulatorySubmission[]               @relation("regulatory_submission_pdf")
  regulatorySubmissionEvidenceFor         RegulatorySubmission[]               @relation("regulatory_submission_evidence")
  /**
   * Real-usage request, 22 Sep 2026 (items 19/20) — a trial's own regulatory-authority and ethics-committee approval documents.
   */
  clinicalTrialRegulatoryApprovalFor      ClinicalTrial[]                      @relation("clinical_trial_regulatory_approval")
  clinicalTrialEthicsApprovalFor          ClinicalTrial[]                      @relation("clinical_trial_ethics_approval")
  /**
   * Real-usage request, 22 Sep 2026 (item 18) — a document a reporter sent in as part of a follow-up response.
   */
  caseFollowUpAttempts                    CaseFollowUpAttempt[]
  psmfs                                   Psmf[]
  auditRequirementRecords                 AuditRequirementRecord[]
  auditPacks                              AuditPack[]
  /**
   * VigiCloud Stage 16.4 — two distinct document roles on the same
   * `QppvNomination` row (the generated letter vs. the manually
   * uploaded regulator confirmation), named exactly like
   * `SourceDocument`'s own original/redacted-copy precedent.
   */
  qppvNominationLetterFor                 QppvNomination[]                     @relation("qppv_nomination_letter")
  qppvNominationConfirmationFor           QppvNomination[]                     @relation("qppv_nomination_confirmation")
  generatedReportEvidenceFor              GeneratedReport[]                    @relation("generated_report_evidence")
  sdeas                                   Sdea[]
  trainingRecords                         TrainingRecord[]
  distributorTrainingRecords              DistributorTrainingRecord[]
  riskManagementPlans                     RiskManagementPlan[]
  /**
   * VigiCloud Stage 21 — the optional voicemail-audio upload slot on a missed-call log row.
   */
  callLogAudios                           CallLog[]
  /**
   * RegCloud (Phase 12) Stage 0.3 — the dossier-slot attachment, mirroring
   * `SourceDocument`'s own "a slot points at a specific `Document` row"
   * precedent exactly.
   */
  regDossierSlotFor                       RegDossierDocumentSlot[]             @relation("reg_dossier_document_slot")
  /**
   * QualCloud (Phase 13) Stage 14 — the DQ/IQ/OQ/PQ protocol/report
   * evidence slots, named like `SourceDocument`'s own original/redacted
   * pair precedent.
   */
  equipmentQualificationProtocolFor       EquipmentQualificationEvent[]        @relation("equipment_qualification_protocol")
  equipmentQualificationReportFor         EquipmentQualificationEvent[]        @relation("equipment_qualification_report")
  /**
   * RegCloud (Phase 12) Stage 4 — the generated cover-sheet PDF and the
   * (nullable-until-uploaded) dispatch-evidence upload, mirroring
   * `RegulatorySubmission`'s own xml/pdf/evidence document-role split.
   */
  regSubmissionCoverSheetFor              RegSubmission[]                      @relation("reg_submission_cover_sheet")
  regSubmissionEvidenceFor                RegSubmission[]                      @relation("reg_submission_evidence")
  /**
   * RegCloud (Phase 12) Stage 5 — the regulator's own query letter (if
   * uploaded as a scanned document rather than just transcribed into
   * `RegQuery.queryTextEncrypted`) and the tenant's own response document.
   */
  regQueryLetterFor                       RegQuery[]                           @relation("reg_query_letter")
  regQueryResponseFor                     RegQuery[]                           @relation("reg_query_response")
  regQueryCorrespondenceFor               RegQueryCorrespondence[]             @relation("reg_query_correspondence_document")
  regulatoryInspectionResponseEvidenceFor RegulatoryInspectionResponse[]       @relation("regulatory_inspection_response_evidence")
  inspectionReadinessPackPdfFor           InspectionReadinessPack[]
  recallSubmissionDocumentFor             RecallSubmission[]                   @relation("recall_submission_document")
  recallSubmissionProofFor                RecallSubmission[]                   @relation("recall_submission_proof")
  recallImportJobDocumentFor              RecallImportJob[]                    @relation("recall_import_job_document")
  recallSightingEvidenceFor               RecallSighting[]                     @relation("recall_sighting_evidence")
  recallDestructionDisposalApprovalFor    RecallDestructionRecord[]            @relation("recall_destruction_disposal_approval")
  recallDestructionCertificateFor         RecallDestructionRecord[]            @relation("recall_destruction_certificate")
  /**
   * RegCloud (Phase 12) Stage 10 — a facility's or a staff member's own
   * scanned operating/professional licence.
   */
  facilityLicenceFor                      Facility[]                           @relation("facility_licence_document")
  personnelLicenceFor                     PersonnelLicence[]                   @relation("personnel_licence_document")
  /**
   * RegCloud (Phase 12) Stage 8 — the tenant's own proof of having filed
   * a post-market obligation with the regulator.
   */
  regPostMarketObligationEvidenceFor      RegPostMarketObligationFulfillment[] @relation("reg_post_market_obligation_evidence")
  /**
   * RegCloud (Phase 12) Stage 11 — the actual issued import/export permit
   * artifact.
   */
  importExportPermitFor                   ImportExportPermit[]                 @relation("import_export_permit_document")
  /**
   * RegCloud (Phase 12) Stage 13 — the actual promotional material artifact under review.
   */
  promotionalMaterialFor                  PromotionalMaterialSubmission[]      @relation("promotional_material_document")
  /**
   * testing-correction-explanation.md §2.2/§2.4/§3.3/§3.6 — every new
   * document role this pass introduces, each named exactly like the
   * existing precedents above (a fixed, known document role on one
   * record — never a second general-purpose upload bucket).
   */
  regDossierApprovalPaymentProofFor       RegDossier[]                         @relation("reg_dossier_approval_payment_proof")
  regDossierApprovalInvoiceFor            RegDossier[]                         @relation("reg_dossier_approval_invoice")
  regDossierApprovalEvidenceFor           RegDossier[]                         @relation("reg_dossier_approval_evidence")
  regVariationPaymentProofFor             RegVariation[]                       @relation("reg_variation_payment_proof")
  regVariationInvoiceFor                  RegVariation[]                       @relation("reg_variation_invoice")
  regRetentionInvoiceFor                  RegRetention[]                       @relation("reg_retention_invoice")
  regRetentionProofOfPaymentFor           RegRetention[]                       @relation("reg_retention_proof_of_payment")
  regRetentionCertificateFor              RegRetention[]                       @relation("reg_retention_certificate")
  productRegistrationWithdrawalFor        ProductRegistration[]                @relation("product_registration_withdrawal")
  /**
   * QualCloud (Phase 13) Stage 7 — the executed Master Batch Record
   * uploaded against a `BatchRecordReview`, distinct from `Sop`'s own
   * MBR *template* register entry.
   */
  batchRecordReviewMbrFor                 BatchRecordReview[]                  @relation("batch_record_review_mbr")
  wasteDisposalCertificateFor             WasteDisposalRecord[]                @relation("waste_disposal_certificate")
  validationReportDocumentFor             ValidationReport[]                   @relation("validation_report_document")

  @@index([companyId, recordType, recordId])
  @@map("document")
}

model DocumentVersion {
  id          String                @id @db.Uuid
  documentId  String                @map("document_id") @db.Uuid
  document    Document              @relation(fields: [documentId], references: [id])
  /**
   * 1, 2, 3... per document — never reused, even if an earlier version's upload failed.
   */
  version     Int
  filename    String
  contentType String                @map("content_type")
  /**
   * The R2/S3 object key — includes the version number so two versions of the same document never collide in the bucket either.
   */
  key         String
  /**
   * Populated only once `complete()` has re-downloaded the object and
   * verified it server-side — never trusts a client-reported hash. Null
   * while `status` is `pending`.
   */
  sha256      String?
  sizeBytes   Int?                  @map("size_bytes")
  status      DocumentVersionStatus @default(pending)
  /**
   * Nullable for the same reason `Document.createdBy` is — see its own doc comment.
   */
  uploadedBy  String?               @map("uploaded_by") @db.Uuid
  uploader    User?                 @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([documentId, version])
  @@map("document_version")
}

// ── Phase 9 — Task Inbox & Notifications ─────────────────────────────────────
//
// `Task` is born from a workflow event: entering a state creates the
// acting-role's (or a specific user's) task; completing the transition out
// of that state closes it; a deadline escalation bumps an existing open
// task's urgency (or creates a fallback one) rather than piling up a
// second task for the same thing. `Notification` is the separate,
// lower-level "something happened, here's a line in your inbox" concept —
// a Task creation is *one* of several things that can trigger a
// Notification, not the same object.

enum TaskStatus {
  open
  claimed
  closed
}

model Task {
  id              String     @id @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  company         Company    @relation(fields: [companyId], references: [id])
  recordType      String     @map("record_type")
  recordId        String     @map("record_id")
  title           String
  status          TaskStatus @default(open)
  /**
   * Role-queue task — any user holding this role may claim it. Exactly one of assignedRoleKey/assignedUserId is set (never both, never neither).
   */
  assignedRoleKey String?    @map("assigned_role_key")
  assignedUserId  String?    @map("assigned_user_id") @db.Uuid
  assignedUser    User?      @relation("task_assigned_user", fields: [assignedUserId], references: [id])
  claimedBy       String?    @map("claimed_by") @db.Uuid
  claimant        User?      @relation("task_claimed_by", fields: [claimedBy], references: [id])
  claimedAt       DateTime?  @map("claimed_at") @db.Timestamptz(3)
  /**
   * Set at creation from *why* the task exists, not recomputed on every
   * read — 'normal' (a plain workflow-state task) | 'due_soon' (bumped by
   * a 72h/24h deadline escalation) | 'overdue' (bumped by a breach). A
   * later escalation on the same open task only ever raises this, never
   * lowers it.
   */
  urgency         String     @default("normal")
  closedAt        DateTime?  @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, status, assignedRoleKey])
  @@index([companyId, status, assignedUserId])
  @@index([companyId, recordType, recordId, status])
  @@index([companyId, createdAt])
  @@map("task")
}

enum NotificationCategory {
  task_assigned
  deadline_approaching
  deadline_breached
  workflow_update
  /**
   * VigiCloud Stage 11 — a follow-up trigger fired (attempt 1 or 2) on a case, or a follow-up cycle closed.
   */
  case_follow_up
  /**
   * Real-usage request, 22 Sep 2026 (item 13) — a draft-review-queue case is due (or overdue) for a human to confirm or reject it.
   */
  draft_review
}

model Notification {
  id         String               @id @db.Uuid
  companyId  String               @map("company_id") @db.Uuid
  company    Company              @relation(fields: [companyId], references: [id])
  userId     String               @map("user_id") @db.Uuid
  user       User                 @relation(fields: [userId], references: [id])
  category   NotificationCategory
  title      String
  body       String?
  recordType String?              @map("record_type")
  recordId   String?              @map("record_id")
  readAt     DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, userId, readAt, createdAt])
  @@map("notification")
}

/**
 * Minimal per-user, per-category email on/off — no in-app toggle, in-app rows always get written regardless (that's the inbox itself).
 */
model NotificationPreference {
  userId              String   @id @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id])
  emailTaskAssigned   Boolean  @default(true) @map("email_task_assigned")
  emailDeadline       Boolean  @default(true) @map("email_deadline")
  emailWorkflowUpdate Boolean  @default(false) @map("email_workflow_update")
  emailCaseFollowUp   Boolean  @default(true) @map("email_case_follow_up")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_preference")
}

// ── Phase 11, Stage 0 — VigiCloud cross-cutting base-engine primitives ────
//
// Per `todo-vigicloud.md` Stage 0: platform primitives that VigiCloud
// Stage 1+ (and, eventually, QualCloud/RegCloud) all lean on. Built once,
// generically, here — polymorphic `recordType`/`recordId` throughout,
// exactly the same convention as `AuditEntry`/`Document`/`Deadline`, so a
// future `Case`/`Deviation`/`ProductRegistration` row can carry a consent
// record, a version history, or a data-subject request without a
// dedicated FK per record type. `companyId` denormalized on every one of
// these tables (reachable via a join in each case) for the same reason
// `Deadline`/`SignatureEvent`/`Document` already denormalize it: so a
// direct Postgres RLS policy can apply without a cross-table subquery.

enum ConsentType {
  report
  contact
  data_privacy
}

enum ConsentMethod {
  verbal
  written
  implied
}

model ConsentRecord {
  id             String        @id @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  recordType     String        @map("record_type")
  recordId       String        @map("record_id")
  consentType    ConsentType   @map("consent_type")
  granted        Boolean
  method         ConsentMethod
  /**
   * Which version of the consent-form wording/checklist was in effect
   * when this was captured — a future change to what the form actually
   * asks shouldn't retroactively reinterpret an old capture.
   */
  formVersion    Int           @default(1) @map("form_version")
  /**
   * Null for a self-service capture (e.g. a patient consenting directly
   * through a future public reporting form) rather than staff-mediated.
   */
  capturedBy     String?       @map("captured_by") @db.Uuid
  capturedByUser User?         @relation(fields: [capturedBy], references: [id])
  grantedAt      DateTime?     @map("granted_at") @db.Timestamptz(3)
  /**
   * Set by `withdraw()` — the row is never deleted or replaced, per the
   * platform's never-delete convention; a withdrawn consent is still a
   * fact that happened and must remain in the record.
   */
  withdrawnAt    DateTime?     @map("withdrawn_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, recordType, recordId, consentType])
  @@map("consent_record")
}

enum DataSubjectRequestType {
  export
  erasure
}

enum DataSubjectRequestStatus {
  pending
  completed
  blocked
}

model DataSubjectRequest {
  id              String                   @id @db.Uuid
  companyId       String                   @map("company_id") @db.Uuid
  company         Company                  @relation(fields: [companyId], references: [id])
  recordType      String                   @map("record_type")
  recordId        String                   @map("record_id")
  requestType     DataSubjectRequestType   @map("request_type")
  status          DataSubjectRequestStatus @default(pending)
  requestedBy     String                   @map("requested_by") @db.Uuid
  requestedByUser User                     @relation(fields: [requestedBy], references: [id])
  /**
   * Populated only when `status: blocked` — e.g. "an open regulatory
   * deadline exists for this record" (checked against the real `Deadline`
   * table, itself polymorphic on the same recordType/recordId).
   */
  blockedReason   String?                  @map("blocked_reason")
  completedAt     DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, recordType, recordId])
  @@index([companyId, status])
  @@map("data_subject_request")
}

/**
 * Cross-module version history — distinct from the optimistic-concurrency
 * `version Int` column every other table already carries (that's a lock
 * counter for 409-on-conflict, not a queryable history). Each row is one
 * captured snapshot; `previousVersionId` chains them so a record's full
 * history can be walked without relying on `versionNumber` alone.
 */
model RecordVersion {
  id                String          @id @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  company           Company         @relation(fields: [companyId], references: [id])
  recordType        String          @map("record_type")
  recordId          String          @map("record_id")
  versionNumber     Int             @map("version_number")
  reason            String?
  snapshot          Json
  previousVersionId String?         @map("previous_version_id") @db.Uuid
  previousVersion   RecordVersion?  @relation("record_version_chain", fields: [previousVersionId], references: [id])
  nextVersions      RecordVersion[] @relation("record_version_chain")
  capturedBy        String?         @map("captured_by") @db.Uuid
  capturedByUser    User?           @relation(fields: [capturedBy], references: [id])
  capturedAt        DateTime        @default(now()) @map("captured_at") @db.Timestamptz(3)

  @@unique([recordType, recordId, versionNumber])
  @@index([companyId, recordType, recordId])
  @@map("record_version")
}

/**
 * The monetisation layer — gates paid module/feature provisioning per
 * company. `featureKey` defaults to the sentinel `"*"` (never null) for a
 * module-level row: Postgres treats every NULL in a unique index as
 * distinct from every other NULL, which would silently let two
 * module-level rows coexist for the same company/module if this were
 * nullable instead. `EntitlementsService.isEnabled()` checks the exact
 * `featureKey` first, falling back to the `"*"` module-level row.
 */
model Entitlement {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id])
  moduleKey     String   @map("module_key")
  featureKey    String   @default("*") @map("feature_key")
  enabled       Boolean  @default(true)
  grantedBy     String   @map("granted_by") @db.Uuid
  grantedByUser User     @relation(fields: [grantedBy], references: [id])
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, moduleKey, featureKey])
  @@map("entitlement")
}

// ── Phase 11, Stage 0.8 — Org-structure location scoping ──────────────────
//
// "Permissions follow org structure": a user with zero scope rows is
// unrestricted (sees the whole company, matching the earlier planning
// decision "Admins always see everything" / "Unrestricted (see
// everything)" as the no-rows default) — adding one or more rows narrows
// them to exactly that set of markets/facilities. `SYSTEM_ADMINISTRATOR`
// bypasses this entirely regardless of rows present (enforced in
// `LocationScopeService`, not here — a role check isn't a schema concern).
// Deliberately a plain non-unique table with app-level duplicate
// prevention rather than a partial unique index — `level` decides which
// of `countryId`/`facilityId` is meaningful for a given row (exactly one
// of them is set), and a clean partial-unique-index shape for "unique per
// whichever of two nullable columns is populated" isn't worth the
// complexity at this scale.

enum LocationScopeLevel {
  market
  facility
}

model UserLocationScope {
  id            String             @id @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  company       Company            @relation(fields: [companyId], references: [id])
  userId        String             @map("user_id") @db.Uuid
  user          User               @relation("user_location_scope_user", fields: [userId], references: [id])
  level         LocationScopeLevel
  countryId     String?            @map("country_id") @db.Uuid
  country       Country?           @relation(fields: [countryId], references: [id])
  facilityId    String?            @map("facility_id") @db.Uuid
  facility      Facility?          @relation(fields: [facilityId], references: [id])
  grantedBy     String             @map("granted_by") @db.Uuid
  grantedByUser User               @relation("user_location_scope_granted_by", fields: [grantedBy], references: [id])
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, userId])
  @@map("user_location_scope")
}

// ── Phase 11, Stage 0.10 — Generic Reports primitive ───────────────────────
//
// Not the intake-form-type catalog above (`ReportType` — what *kind of
// incident* is being reported: ADR, device incident, ...) — this is the
// generic *output* side: wherever a module's generated report (a PV
// PSUR, a QualCloud batch-release report, a RegCloud renewal report)
// gets created, tracked through draft -> final -> submitted, and stored.
// Built once, generically, here, the same way Consent/Versioning/
// Entitlements are Stage 0 primitives with no real content behind them
// yet — VigiCloud Stage 18's actual PSUR/line-listing *generation logic*
// is what will populate this later; this is just where the result lives.
// The generated file itself reuses the existing polymorphic `Document`
// storage (`Document.recordType = 'generated_report'`, `recordId = this
// row's id`) rather than a dedicated FK — no new storage mechanism
// needed, `POST /records/generated_report/:id/documents` already works.

enum ReportStatus {
  draft
  final
  submitted
  /**
   * Real-usage request, 11 Sep 2026 ("Periodic and aggregate reports...
   * as proper workflows: data-lock point, generate, review, QPPV
   * sign-off, submit, evidence") — the new real state between `draft`
   * and `submitted` for a periodic report (`PeriodicReportService`) that
   * has passed its QC review, awaiting the QPPV sign-off+submit
   * transition. Never used by any other `reportTypeKey` — every other
   * report type keeps the plain draft→final→submitted flip through
   * `ReportsService.finalize()`/`.submit()`.
   */
  qc_reviewed
}

model GeneratedReport {
  id                 String       @id @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  company            Company      @relation(fields: [companyId], references: [id])
  /**
   * `pv` | `qualcloud` | `regcloud` — plain string, matching `ReportType.moduleKey`'s own reasoning (a future module registers its own key without a migration).
   */
  moduleKey          String       @map("module_key")
  /**
   * Free-form for now (e.g. `psur`, `line_listing`, `batch_release`, `registration_renewal`) — the universe of periodic report types isn't finalized yet (Stage 18+); a reference catalog can be added later without breaking this column.
   */
  reportTypeKey      String       @map("report_type_key")
  title              String
  periodStart        DateTime?    @map("period_start") @db.Date
  periodEnd          DateTime?    @map("period_end") @db.Date
  /**
   * What this report is about, if it's about one specific thing (e.g. a `product` for a per-product PSUR) — polymorphic like every other cross-cutting primitive; null for a company-wide report.
   */
  recordType         String?      @map("record_type")
  recordId           String?      @map("record_id")
  status             ReportStatus @default(draft)
  dueAt              DateTime?    @map("due_at") @db.Timestamptz(3)
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  generatedBy        String?      @map("generated_by") @db.Uuid
  generatedByUser    User?        @relation(fields: [generatedBy], references: [id])
  /**
   * Generic structured content for a report type that needs more than the
   * plain fields above — first used by the DHCP/DIL safety-letter rebuild
   * (11 Sep 2026, matching the real `Draft Kenya DHCPL.docx` sample's exact
   * structure): `ppbApprovalReference`, `backgroundInformation`,
   * `actionableGuidance`, `signatoryName`, `signatoryTitle`. Nullable/unused
   * for every other `reportTypeKey` — matches `Psmf.content`'s own precedent
   * for a version-on-write-adjacent record whose real-world source document
   * has a specific required shape.
   */
  content            Json?
  /**
   * Real-usage request, 11 Sep 2026 — the workflow map's "Submit ▶
   * Track" pipeline step: proof the report was actually dispatched
   * (a portal confirmation, an email receipt), distinct from the
   * report's own generated PDF (which is a separate `Document`,
   * uploaded at generation time against `recordType: 'generated_report'`,
   * `recordId: this.id`). Generic and nullable on this shared model — no
   * report type is required to have one; `PeriodicReportService`'s
   * `attachEvidence()` is the first (and, for now, only) writer.
   */
  evidenceDocumentId String?      @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document?    @relation("generated_report_evidence", fields: [evidenceDocumentId], references: [id])
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  safetyLetterRecipients              SafetyLetterRecipient[]
  regPostMarketObligationFulfillments RegPostMarketObligationFulfillment[]
  pqrFor                              Pqr[]

  @@index([companyId, moduleKey, reportTypeKey])
  @@index([companyId, status])
  @@index([companyId, dueAt])
  // Serves the default "list every report, newest first, no filter" view —
  // the filtered indexes above don't substitute for this (see CLAUDE.md's
  // audit_entry/task pagination gotcha).
  @@index([companyId, createdAt])
  @@map("generated_report")
}

/**
 * QualCloud (Phase 13) Stage 13 — Product Quality Review. One row per
 * `(product, period)` — never overwritten (a re-review of the same
 * period is a new row, matching every other archived-output precedent
 * in this schema: `RegulatorySubmission`, `ReconciliationReport`).
 * `assembledData` freezes the live cross-module pull at assemble() time
 * (ALCOA+ "contemporaneous," the same discipline `ManagementReview`'s
 * own frozen metrics snapshot already established) — `review()` never
 * re-pulls it, it only adds the human judgment layer on top.
 */
model Pqr {
  id                   String           @id @db.Uuid
  companyId            String           @map("company_id") @db.Uuid
  company              Company          @relation(fields: [companyId], references: [id])
  productId            String           @map("product_id") @db.Uuid
  product              Product          @relation(fields: [productId], references: [id])
  periodStart          DateTime         @map("period_start") @db.Date
  periodEnd            DateTime         @map("period_end") @db.Date
  /**
   * `draft | reviewed`.
   */
  status               String           @default("draft")
  /**
   * The frozen live pull at `assemble()` time — batches, deviations,
   * CAPAs, OOS, complaints, changes, a stability placeholder (honestly
   * `"not_yet_applicable"` — no stability module exists yet, Stage 19
   * is deferred), regulatory submissions/variations in-period, and open
   * `QualityTrendFlag` rows. See `PqrService.assemble()`'s own doc
   * comment for the exact shape.
   */
  assembledData        Json?            @map("assembled_data")
  conclusionsNarrative String?          @map("conclusions_narrative")
  trendsNarrative      String?          @map("trends_narrative")
  /**
   * `[{ description, ownerUserId?, capaId? }]` — each optionally opening a real `Capa` via `createFrom('pqr_action', ...)`.
   */
  recommendedActions   Json?            @map("recommended_actions")
  reviewedBy           String?          @map("reviewed_by") @db.Uuid
  reviewer             User?            @relation("pqr_reviewed_by", fields: [reviewedBy], references: [id])
  reviewedAt           DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  nextReviewDueAt      DateTime?        @map("next_review_due_at") @db.Timestamptz(3)
  generatedReportId    String?          @map("generated_report_id") @db.Uuid
  generatedReport      GeneratedReport? @relation(fields: [generatedReportId], references: [id])
  createdBy            String?          @map("created_by") @db.Uuid
  creator              User?            @relation("pqr_created_by", fields: [createdBy], references: [id])
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, productId])
  @@index([companyId, status])
  @@map("pqr")
}

/**
 * Real-usage request, 11 Sep 2026 — "A proper report generator so clients
 * can build their own customised reports... pick the fields, filter,
 * group, save, schedule and export." A saved self-service report
 * definition — one row per named report a user builds, not a regulated
 * artifact the way `GeneratedReport` rows are (no version-on-write, no
 * append-only audit precedent — this is a saved search/view, closer to
 * `UserLocationScope` than to `Psmf`; hard-deletable). `dataSource` picks
 * a fixed, pre-vetted field catalog (`report-builder.data-sources.ts`) —
 * `fields`/`filters`/`groupByField` are always validated against that
 * catalog server-side before any query runs, never accepted as an
 * arbitrary path or raw SQL fragment. Cross-module joins (one report
 * spanning PV + Reg + Quality data at once) are explicitly out of scope
 * for this pass — each definition picks exactly one `dataSource`; a
 * client reports on each module separately, not yet in one unified
 * query. `scheduleCadenceDays` (nullable) is the "schedule" half —
 * `ReportBuilderScheduleProcessor` (a daily BullMQ scan, mirroring
 * `LineListingScheduleProcessor`'s exact shape) re-runs and re-exports
 * any definition due since `lastRunAt`.
 */
model ReportDefinition {
  id                  String    @id @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  company             Company   @relation(fields: [companyId], references: [id])
  name                String
  /**
   * `pv_case` | `reg_dossier` — see `REPORT_BUILDER_DATA_SOURCES`.
   */
  dataSource          String    @map("data_source")
  /**
   * Ordered array of field keys from the chosen data source's catalog.
   */
  fields              Json
  /**
   * `{field, operator, value}[]` — every `field`/`operator` re-validated against the catalog on every run, not trusted from a stale save.
   */
  filters             Json
  groupByField        String?   @map("group_by_field")
  scheduleCadenceDays Int?      @map("schedule_cadence_days")
  lastRunAt           DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  creator             User?     @relation(fields: [createdBy], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@map("report_definition")
}

// ── Phase 11, Stage 18 — Reporting & Periodic Outputs ──────────────────────
//
// Dashboards and benefit-risk views are pure read aggregations (no new
// tables — `DashboardService`/`BenefitRiskService` query `Case`/
// `AdverseEvent`/`CausalityAssessment`/`Signal`/`Deadline` directly).
// Line listings and PSUR/PBRER/DSUR/PADER/CIOMS-II periodic reports both
// reuse Stage 0.10's `GeneratedReport` primitive above exactly as its own
// doc comment anticipated — no schema change needed for either. What
// this stage's schema actually adds: a per-product RMP (version-on-write,
// same shape as `Psmf`/`Sdea`), a manual safety-alert log (the daily
// external-scan half of Stage 18's "safety-signal notifications" is
// explicitly deferred — see `needs.md` item 13 and `SafetyAlertService`'s
// own doc comment), and a join table tracking who a generated DHCP/DIL
// letter was actually sent to (`GeneratedReport` has no notion of "sent
// to whom," unlike a self-generated PSUR that's never distributed
// in-app).

enum RiskManagementPlanStatus {
  draft
  active
  retired
}

/**
 * VigiCloud Stage 18 — per-product RMP, version-on-write exactly like
 * `Psmf`/`Sdea` (no UPDATE endpoint; `POST` inserts a new `draft` at
 * `(max version for this product) + 1`; `.../activate` retires whatever
 * was previously active for this *product* and flips the target,
 * enforced by a hand-added partial unique index
 * `rmp_one_active_per_product`, scoped by `productId` not `companyId`
 * since a company can have many products each with their own RMP
 * lifecycle). `nextRenewalDueAt` is a real field a QPPV sets directly,
 * not auto-computed the way `ClinicalTrialAnnualReminderService`'s own
 * due-ness check derives from `Task` history — an RMP's renewal cadence
 * is a genuine regulatory judgment call (varies by product/authority),
 * not a fixed formula like PSMF/trial-annual-review, so there is no
 * honest way to derive it instead of asking.
 */
model RiskManagementPlan {
  id               String                   @id @db.Uuid
  companyId        String                   @map("company_id") @db.Uuid
  company          Company                  @relation(fields: [companyId], references: [id])
  productId        String                   @map("product_id") @db.Uuid
  product          Product                  @relation(fields: [productId], references: [id])
  version          Int
  status           RiskManagementPlanStatus @default(draft)
  title            String
  summary          String?
  documentId       String?                  @map("document_id") @db.Uuid
  document         Document?                @relation(fields: [documentId], references: [id])
  /**
   * Real-document-fidelity request, 12 Sep 2026 — the real
   * `Drat Kenya RMP.docx` sample's own 6-part structure (Product
   * Overview; Safety Specification — Modules SI/SIV/SVII; Pharmacovigilance
   * Plan; Post-Authorisation Efficacy Studies; Risk Minimisation
   * Measures; Summary), transcribed field-by-field, exactly mirroring
   * `Psmf.content`'s own precedent for a version-on-write document that
   * now supports create-from-scratch as well as upload.
   */
  content          Json?
  nextRenewalDueAt DateTime?                @map("next_renewal_due_at") @db.Date
  submittedAt      DateTime?                @map("submitted_at") @db.Timestamptz(3)
  createdBy        String?                  @map("created_by") @db.Uuid
  creator          User?                    @relation("rmp_created_by", fields: [createdBy], references: [id])
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt      DateTime?                @map("activated_at") @db.Timestamptz(3)
  retiredAt        DateTime?                @map("retired_at") @db.Timestamptz(3)

  @@unique([productId, version])
  @@index([companyId, status])
  @@index([companyId, nextRenewalDueAt])
  @@map("risk_management_plan")
}

enum SafetyAlertStatus {
  open
  reviewed
  actioned
  dismissed
}

/**
 * VigiCloud Stage 18 — the manual, audit-trailed half of "safety-signal
 * notifications." The Final doc's own spec calls for a daily scan of
 * external regulator/WHO alert sources feeding this automatically —
 * `needs.md` item 13 frames that as a genuine build-vs-buy decision
 * (no unified structured feed exists across WHO/FDA/MHRA/EMA/Swissmedic),
 * not a pure engineering task, so it is deliberately **not** built here
 * (matching this project's own precedent for Stage 19's literature-run
 * log: ship the audit-trailed manual log first, leave the automated
 * aggregation genuinely open pending that decision). A human — QPPV or
 * whoever is monitoring external sources today — logs what they found
 * here; this is also the record a DHCP/DIL letter (`SafetyLetterRecipient`
 * below) is generated in response to, via `GeneratedReport.recordType =
 * 'safety_alert'`.
 */
model SafetyAlert {
  id                String            @id @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  company           Company           @relation(fields: [companyId], references: [id])
  title             String
  source            String
  sourceUrl         String?           @map("source_url")
  summary           String
  affectedProductId String?           @map("affected_product_id") @db.Uuid
  affectedProduct   Product?          @relation(fields: [affectedProductId], references: [id])
  status            SafetyAlertStatus @default(open)
  reviewNote        String?           @map("review_note")
  loggedBy          String?           @map("logged_by") @db.Uuid
  loggedByUser      User?             @relation(fields: [loggedBy], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("safety_alert")
}

/**
 * VigiCloud Stage 18 — a real DHCP (Dear Healthcare Professional) or DIL
 * (Dear Investigator Letter) is a `GeneratedReport` row
 * (`reportTypeKey: 'dhcp_letter' | 'dil_letter'`) whose file is the
 * usual polymorphic `Document`, exactly like every other generated
 * report — but a letter, unlike a self-generated PSUR, is actually
 * *distributed*, and nothing on `GeneratedReport` tracks who it went to.
 * This is that missing per-recipient dispatch record, one row per
 * addressee, `sentAt` set only once the existing notification engine
 * (`NotificationsService.sendExternalEmail()` — the same mechanism
 * Stage 11's reporter follow-up and Stage 16's reachability reminders
 * already use for an external, non-`User` recipient) confirms the send
 * was queued.
 */
model SafetyLetterRecipient {
  id                String          @id @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  company           Company         @relation(fields: [companyId], references: [id])
  generatedReportId String          @map("generated_report_id") @db.Uuid
  generatedReport   GeneratedReport @relation(fields: [generatedReportId], references: [id])
  recipientName     String          @map("recipient_name")
  recipientEmail    String          @map("recipient_email")
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, generatedReportId])
  @@map("safety_letter_recipient")
}

// ── Phase 11, Stage 1 — Core PV Domain Schema ──────────────────────────────
//
// The actual "cannot be retrofitted" moment for VigiCloud: `Case` and its
// children, with consent/versioning/duplicate-linking designed in from day
// one. `recordType` passed to `ConsentService`/`RecordVersioningService`/
// `WorkflowService`/`AuditService` for a case is always the literal string
// `"pv_case"` — matching `PV_CASE_WORKFLOW_RECORD_TYPE` in
// `workflow.seed-data.ts` exactly, so the already-seeded 8-state workflow
// definition (Intake → Triage → Medical Review → Coding → Narrative →
// Quality Check → Submission Ready → Submitted) applies without any new
// seed data. Neither `ConsentRecord` nor `RecordVersion` gets a dedicated
// FK on `Case` — both are already polymorphic (`recordType`/`recordId`)
// per their own Stage 0 design; a case is just another record they can
// point at, and adding a redundant FK would only create a second way to
// express the same relationship.
//
// `SuspectProduct` captures product identity inline (brand name, INN/
// active substance, ATC code, batch) rather than FK'ing to a normalized
// product catalog — Stage 2 introduces that catalog; adding an optional
// `productId` FK to `SuspectProduct` at that point is a purely additive
// migration, not a retrofit of anything built here. Field shapes for
// `SuspectProduct`/`AdverseEvent` are modelled directly against the real
// Kenya E2B(R3) sample in `vigicloud docs/`
// (`Kenya33716702_ENIP131PFIZER_20260731065733.xml`) — `drugCharacterization`
// mirrors its `drugcharacterization` (1=suspect/2=concomitant), the six
// `seriousnessX` booleans on `AdverseEvent` mirror its `seriousnessX`
// fields verbatim, not guessed at.
//
// Every table below is prefixed `pv_` (vs. the base engine's unprefixed
// `company`/`task`/`document`, ...) — the first VigiCloud-owned tables in
// the schema, and "case" in particular is generic enough a word that an
// unprefixed table would invite confusion against a future QualCloud/
// RegCloud table of the same natural name.
//
// Free-text fields likely to contain patient-identifying narrative
// (`Case.additionalInformationEncrypted`, `Patient.medicalHistoryEncrypted`,
// `AdverseEvent.narrativeEncrypted`) are encrypted at the service layer via
// Stage 0.3's `TextEncryptionService` before ever reaching Postgres — the
// column itself just holds opaque ciphertext (base64: iv || authTag ||
// ciphertext), never plaintext. This is that primitive's first real
// consumer.

enum CaseChannel {
  form
  drug_safety_email
  hotline_phone
  post
  whatsapp_qr
  public_url
  hcp_direct
  literature
  clinical_study
  /**
   * QualCloud (Phase 13) Stage 5 — a case auto-created by `ComplaintService.classify()` routing a quality complaint that describes a possible adverse event.
   */
  quality_complaint_routed
}

enum ReporterType {
  consumer
  healthcare_professional
}

enum PatientSex {
  male
  female
  unknown
}

enum DrugCharacterization {
  suspect
  concomitant
  interacting
}

enum ReactionOutcome {
  recovered
  recovering
  not_recovered
  recovered_with_sequelae
  fatal
  unknown
}

/**
 * WHO-UMC standardised causality categories, verbatim from
 * `vigicloud docs/who causality-assessment.pdf` Table 2 — not a
 * paraphrase. `conditional_unclassified` and `unassessable_unclassifiable`
 * are deliberately two distinct terminal states (more data needed and
 * being sought, vs. information that can never be supplemented), per the
 * source document's own distinction.
 */
enum WhoUmcCausality {
  certain
  probable_likely
  possible
  unlikely
  conditional_unclassified
  unassessable_unclassifiable
}

/**
 * VigiCloud Stage 14 — a clinical trial a tenant is running (or is the
 * local safety contact for), the anchor a "solicited" SAE case links
 * back to. Never deleted — `status` moves through its own lifecycle
 * instead, matching every other master-data model in this schema.
 */
model ClinicalTrial {
  id                           String                    @id @db.Uuid
  companyId                    String                    @map("company_id") @db.Uuid
  company                      Company                   @relation(fields: [companyId], references: [id])
  /**
   * The protocol/registration number — e.g. an NCT number or the sponsor's own protocol ID. Unique per company, not globally (two tenants could each be a local contact for the same multinational trial under their own account).
   */
  trialReference               String                    @map("trial_reference")
  trialName                    String                    @map("trial_name")
  sponsor                      String?
  /**
   * Free text ("Phase I", "Phase II/III", "Phase IV") — not an enum, since real trials sometimes span two adjacent phases.
   */
  phase                        String?
  blindingType                 ClinicalTrialBlindingType @default(open_label) @map("blinding_type")
  ethicsCommitteeName          String?                   @map("ethics_committee_name")
  ethicsCommitteeContactEmail  String?                   @map("ethics_committee_contact_email")
  /**
   * A reference into the sponsor's own clinical-trial portal (a URL, a submission ID) — SafeMeds never integrates with it directly, per this stage's own "no live gateway" scoping, same posture as Stage 12's E2B submissions.
   */
  clinicalTrialPortalReference String?                   @map("clinical_trial_portal_reference")
  countryId                    String                    @map("country_id") @db.Uuid
  country                      Country                   @relation(fields: [countryId], references: [id])
  status                       ClinicalTrialStatus       @default(active)
  startDate                    DateTime                  @map("start_date") @db.Date
  version                      Int                       @default(1)
  /**
   * Real-usage request, 22 Sep 2026 (items 19/20) — `create()` now
   * *requires* both a regulatory-authority approval and an
   * ethics-committee approval document + date at the DTO/application
   * level for every new trial. Nullable at the schema level only to
   * avoid retroactively breaking the real trials already in this
   * database created before this requirement existed (backfillable via
   * `renewApproval()`, never a silent auto-fill). Expiry is optional
   * (some approvals are open-ended) but when set drives the same
   * expiring/expired flag `SdeaService.getStatusForDistributor()`
   * already established for a distributor agreement — renewed via a
   * dedicated `renewApproval()` action, never a plain field overwrite,
   * so each renewal is its own audited event.
   */
  regulatoryApprovalDocumentId String?                   @map("regulatory_approval_document_id") @db.Uuid
  regulatoryApprovalDocument   Document?                 @relation("clinical_trial_regulatory_approval", fields: [regulatoryApprovalDocumentId], references: [id])
  regulatoryApprovalDate       DateTime?                 @map("regulatory_approval_date") @db.Date
  regulatoryApprovalExpiryDate DateTime?                 @map("regulatory_approval_expiry_date") @db.Date
  ethicsApprovalDocumentId     String?                   @map("ethics_approval_document_id") @db.Uuid
  ethicsApprovalDocument       Document?                 @relation("clinical_trial_ethics_approval", fields: [ethicsApprovalDocumentId], references: [id])
  ethicsApprovalDate           DateTime?                 @map("ethics_approval_date") @db.Date
  ethicsApprovalExpiryDate     DateTime?                 @map("ethics_approval_expiry_date") @db.Date
  createdAt                    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  subjects            ClinicalTrialSubject[]
  cases               Case[]
  /**
   * RegCloud (Phase 12) Stage 12 — every Clinical Trial Application dossier ever filed for this trial (initial + any amendment).
   */
  regDossiers         RegDossier[]
  /**
   * RegCloud (Phase 12) Stage 12 — IMP (Investigational Medicinal Product) import/export permits linked to this trial.
   */
  importExportPermits ImportExportPermit[]

  @@unique([companyId, trialReference])
  @@index([companyId, status])
  @@map("clinical_trial")
}

enum ClinicalTrialBlindingType {
  open_label
  single_blind
  double_blind
}

enum ClinicalTrialStatus {
  active
  completed
  terminated
}

/**
 * VigiCloud Stage 14 — a pre-registered trial subject (bulk-importable,
 * Stage 0.6's importer framework), identified only by a blinded
 * `subjectCode` — never a name, same "never a full name" discipline as
 * `Patient.initials`. `treatmentArmEncrypted` is the actual randomization
 * assignment, sponsor-provided, blinded by default: nothing decrypts or
 * returns it except `ClinicalTrialService.revealTreatmentArm()`'s own
 * signature-gated action, reusing the existing electronic-signature
 * engine exactly as this stage's own build-spec text calls for.
 * `blindingBroken` is a one-way flag — once true, it stays true forever
 * (an unblinding event can't be undone in reality, so this model doesn't
 * pretend otherwise), but every *reveal* of the plaintext value still
 * requires its own fresh signature and is its own distinctly audited
 * event, whether or not the blind was already broken by an earlier one.
 */
model ClinicalTrialSubject {
  id                        String                     @id @db.Uuid
  companyId                 String                     @map("company_id") @db.Uuid
  company                   Company                    @relation(fields: [companyId], references: [id])
  clinicalTrialId           String                     @map("clinical_trial_id") @db.Uuid
  clinicalTrial             ClinicalTrial              @relation(fields: [clinicalTrialId], references: [id])
  subjectCode               String                     @map("subject_code")
  sex                       PatientSex                 @default(unknown)
  ageYears                  Int?                       @map("age_years")
  enrolledAt                DateTime                   @map("enrolled_at") @db.Date
  status                    ClinicalTrialSubjectStatus @default(enrolled)
  treatmentArmEncrypted     String?                    @map("treatment_arm_encrypted")
  blindingBroken            Boolean                    @default(false) @map("blinding_broken")
  unblindedBy               String?                    @map("unblinded_by") @db.Uuid
  unblindedByUser           User?                      @relation(fields: [unblindedBy], references: [id])
  unblindedAt               DateTime?                  @map("unblinded_at") @db.Timestamptz(3)
  /**
   * Captured on every reveal (not just the first), encrypted like every other free-text field — "why was this looked at" matters as ongoing evidence, not just the first break. Holds the most recent reveal's reason; every reveal is independently in `audit_entry` regardless.
   */
  unblindingReasonEncrypted String?                    @map("unblinding_reason_encrypted")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  cases Case[]

  @@unique([clinicalTrialId, subjectCode])
  @@index([companyId, clinicalTrialId])
  @@map("clinical_trial_subject")
}

enum ClinicalTrialSubjectStatus {
  enrolled
  withdrawn
  completed
}

model Case {
  id                              String                @id @db.Uuid
  companyId                       String                @map("company_id") @db.Uuid
  company                         Company               @relation(fields: [companyId], references: [id])
  /**
   * Human-referenceable, unique per company (not globally) — e.g.
   * `CASE-2026-000123` — enables the "follow up for the same case, by the
   * same person, #reference number" requirement (Stage 3/10) without
   * exposing the internal UUID.
   */
  referenceNumber                 String                @map("reference_number")
  reportTypeId                    String                @map("report_type_id") @db.Uuid
  reportType                      ReportType            @relation(fields: [reportTypeId], references: [id])
  countryOfOccurrenceId           String                @map("country_of_occurrence_id") @db.Uuid
  countryOfOccurrence             Country               @relation("case_country_of_occurrence", fields: [countryOfOccurrenceId], references: [id])
  /**
   * Selects the applicable reporting clock (Stage 13) — deliberately a separate field from country of occurrence, per Final doc §D.
   */
  countryOfReportId               String                @map("country_of_report_id") @db.Uuid
  countryOfReport                 Country               @relation("case_country_of_report", fields: [countryOfReportId], references: [id])
  channel                         CaseChannel           @default(form)
  /**
   * VigiCloud Stage 14 — set (and required by `PvCaseService.create()`'s
   * own validation) whenever `channel` is `clinical_study`: a
   * clinical-trial SAE is *solicited*, not spontaneous, and always
   * traces back to a specific trial. Nullable because every other
   * channel has no trial to link to.
   */
  clinicalTrialId                 String?               @map("clinical_trial_id") @db.Uuid
  clinicalTrial                   ClinicalTrial?        @relation(fields: [clinicalTrialId], references: [id])
  /**
   * VigiCloud Stage 14 — optional even on a clinical-trial case: a case
   * can be filed against a pre-enrolled subject (bulk-imported via
   * Stage 0.6's importer framework) or, just as legitimately, describe a
   * subject who was never pre-registered. When set, this is also the
   * blinding boundary — `ClinicalTrialSubject.treatmentArmEncrypted`
   * lives on the subject, never duplicated onto the case, so there is
   * exactly one place a treatment-arm reveal can ever act.
   */
  clinicalTrialSubjectId          String?               @map("clinical_trial_subject_id") @db.Uuid
  clinicalTrialSubject            ClinicalTrialSubject? @relation(fields: [clinicalTrialSubjectId], references: [id])
  /**
   * When the company first learned of the event — the reporting-clock start (Stage 13), per every PPB form's own convention.
   */
  awarenessDate                   DateTime              @map("awareness_date") @db.Date
  receivedDate                    DateTime              @map("received_date") @db.Date
  additionalInformationEncrypted  String?               @map("additional_information_encrypted")
  /**
   * VigiCloud Stage 10 — set exactly once a `DuplicateReview` pair is
   * **confirmed** as a duplicate (never for a merely "possible" flagged
   * pair — those live only in `DuplicateReview.status: possible`), so
   * its mere presence unambiguously means "this case is a subordinate
   * duplicate, invalidated, excluded from every other PV activity" —
   * per the EMA guideline's own "Allocation of a Master Case" pattern.
   * One field serves **both** of the guideline's Master Case patterns,
   * not two separate mechanisms as an earlier planning pass assumed:
   * Allocation points this at an *existing* case; Creation points it at
   * a brand-new `Case` row created specifically to be the master — both
   * are just "this case's `duplicateOfCaseId`," the master side is
   * whichever `Case` other rows point at (see `duplicates` below).
   */
  duplicateOfCaseId               String?               @map("duplicate_of_case_id") @db.Uuid
  duplicateOfCase                 Case?                 @relation("case_duplicate_of", fields: [duplicateOfCaseId], references: [id])
  duplicates                      Case[]                @relation("case_duplicate_of")
  duplicateReviewsAsCase          DuplicateReview[]     @relation("duplicate_review_case")
  duplicateReviewsAsMatched       DuplicateReview[]     @relation("duplicate_review_matched_case")
  followUp                        CaseFollowUp?
  /**
   * Denormalized workflow-state key (e.g. "intake", "triage", ...),
   * mirroring the real `WorkflowInstance.currentState.stateKey` this case
   * is instantiated against — kept in sync by whatever service calls
   * `WorkflowService.transition()`, so list/filter queries ("show me
   * every case in Triage") don't need a join for the common case. The
   * `WorkflowInstance` row (found via `recordType:"pv_case"`,
   * `recordId:case.id`) remains the source of truth for role-gating and
   * signature requirements.
   */
  status                          String                @default("intake")
  version                         Int                   @default(1)
  /**
   * VigiCloud Stage 3 — nullable, not required. Every case created through
   * an authenticated wizard (Stage 1's `POST /pv/cases`) still has a real
   * `createdBy`; a case created through an unauthenticated channel (the
   * public reporting URL, inbound-email parsing, the WhatsApp chatbot —
   * `PvCaseService.createFromSystemChannel()`) genuinely has no logged-in
   * human actor, so forcing a fake/system `User` row here would misrepresent
   * who actually created it. `PvCaseService`'s own-only visibility filter
   * already treats a case with no creator as belonging to nobody's
   * personal queue — exactly the right behavior, since an anonymously-
   * submitted case needs a human to claim/triage it via `requiresDraftReview`
   * below, not to silently "belong" to whichever pharmacist happens to look.
   */
  createdBy                       String?               @map("created_by") @db.Uuid
  createdByUser                   User?                 @relation("case_created_by", fields: [createdBy], references: [id])
  /**
   * A `Case` flag, not a separate intake path — per the Final doc's own
   * framing, falsified/substandard product monitoring enters through the
   * exact same intake as every other case, just flagged. Independent of
   * `reportType` (a case can be an ADR report that *also* raises a
   * falsified-product concern about the product involved).
   */
  suspectedFalsifiedOrSubstandard Boolean               @default(false) @map("suspected_falsified_or_substandard")
  /**
   * True for every case created via `createFromSystemChannel()` (public
   * URL, inbound email, WhatsApp) until a human with `pv.triage_case`
   * reviews the auto-extracted/auto-submitted data and calls
   * `PvCaseService.confirmDraft()` — per the Final doc's "always lands for
   * human triage" requirement for email/WhatsApp-sourced cases, extended
   * here to every unauthenticated channel for the same reason: nothing a
   * system extracted or a member of the public typed should enter normal
   * triage unconfirmed.
   */
  requiresDraftReview             Boolean               @default(false) @map("requires_draft_review")
  /**
   * Real-usage feedback, 19 Aug 2026 — "more people should see, claim it
   * and then work on them... if not, then what's the use of claiming."
   * Meaningful only while `requiresDraftReview` is true; a claim is a
   * lightweight ownership marker, not a workflow-engine state, matching
   * this schema's own precedent that not every actor→record relationship
   * needs a full `WorkflowInstance` (see `PregnancyContext`'s own
   * "derived field, not a workflow" reasoning). `confirmDraft()` requires
   * the calling actor to hold the current claim; a separate "release"
   * action clears both fields so someone else can claim it.
   */
  draftClaimedBy                  String?               @map("draft_claimed_by") @db.Uuid
  draftClaimedByUser              User?                 @relation("case_draft_claimed_by", fields: [draftClaimedBy], references: [id])
  draftClaimedAt                  DateTime?             @map("draft_claimed_at") @db.Timestamptz(3)
  /**
   * Real-usage request, 22 Sep 2026 (item 13) — a reviewer's alternative
   * to `confirmDraft()`: this draft never should have become a case at
   * all (spam, an obvious duplicate submission, unusable content). Never
   * deletes the row (this schema's own "never delete, always deactivate/
   * withdraw" convention) — `requiresDraftReview` flips to `false` (it
   * leaves the queue) and these two fields record the decision, exactly
   * mirroring `CaseFollowUp.closedReason`'s own plain-text precedent.
   */
  draftRejectedAt                 DateTime?             @map("draft_rejected_at") @db.Timestamptz(3)
  draftRejectionReason            String?               @map("draft_rejection_reason")
  /**
   * Real-usage request (11 Sep 2026), "SafeMeds VigiCloud Workflow Map"
   * — stage 9 of the master case lifecycle ("Close & Archive": lock,
   * e-sign, archive; feed signals and trends). Set by the new
   * `pv_case` transition `submitted → closed_archived`
   * (`WorkflowStatusSyncRegistryService`, `pv-workflow-guards.service.ts`),
   * gated by the same signature the transition itself already requires
   * — no separate e-sign field needed, `SignatureEvent` already carries
   * that. **The map's own "retention clock" is deliberately not modeled
   * here** — no real, sourced retention-period number exists for any
   * seeded country yet (matching this schema's own established
   * discipline of never fabricating an unconfirmed regulatory number,
   * see CLAUDE.md's Q1–Q7 notes) — a future country-config-driven
   * retention rule can compute a real due-date off this timestamp once
   * that number is confirmed by a field expert.
   */
  closedAt                        DateTime?             @map("closed_at") @db.Timestamptz(3)
  /**
   * Free-text provenance pointer back to the originating artifact outside
   * this system — an inbound email's `Message-ID` header, a WhatsApp
   * message/contact ID — kept for audit traceability ("which email/WhatsApp
   * thread did this case come from"), never parsed/relied on structurally.
   */
  sourceChannelReference          String?               @map("source_channel_reference")
  /**
   * VigiCloud Stage 5 — `fatal | serious | non_serious` (the three-tier
   * scheme `ReportingRule.seriousnessClass` already uses; a plain string,
   * not an enum, since not every report type's scheme is three-tier —
   * device incidents only ever resolve to `serious`/`non_serious`, never
   * `fatal`). Null until `TriageService.classify()` runs — a case with no
   * seriousness classification yet has no resolvable reporting deadline
   * either, which is the honest, literal state until a human (or the
   * auto-derivation `classify()` runs on their behalf) actually looks at
   * what was captured.
   */
  seriousnessClass                String?               @map("seriousness_class")
  /**
   * VigiCloud Stage 6 — a manual flag set by a reviewer, per Reconciliation
   * Note 3: Tier 1 cannot honestly ship automated expectedness comparison
   * against a Company Core Data Sheet that Tier 2's label-version-management
   * feature hasn't built yet, so this is the Tier-1-honest version — a
   * human judgment call, not a computed one. `not_assessed` is the only
   * valid default; there is no inferred "probably listed."
   */
  expectednessFlag                ExpectednessFlag      @default(not_assessed) @map("expectedness_flag")
  /**
   * The reviewer's own reasoning — e.g. which label version they checked against, why they landed on this flag. Encrypted at rest like every other free-text case field (Stage 0.3).
   */
  expectednessNoteEncrypted       String?               @map("expectedness_note_encrypted")
  expectednessAssessedBy          String?               @map("expectedness_assessed_by") @db.Uuid
  expectednessAssessedByUser      User?                 @relation("case_expectedness_assessed_by", fields: [expectednessAssessedBy], references: [id])
  expectednessAssessedAt          DateTime?             @map("expectedness_assessed_at") @db.Timestamptz(3)
  createdAt                       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter               Reporter?
  patient                Patient?
  suspectProducts        SuspectProduct[]
  adverseEvents          AdverseEvent[]
  causalityAssessments   CausalityAssessment[]
  sourceDocuments        SourceDocument[]
  pregnancyContext       PregnancyContext?
  callLogs               CallLog[]
  regulatorySubmissions  RegulatorySubmission[]
  caseDistributorMapping CaseDistributorMapping?
  signalLinks            SignalCase[]
  /**
   * RegCloud (Phase 12) Stage 14 — recalls this case triggered or resulted from.
   */
  recallLinks            RecallCase[]
  /**
   * QualCloud (Phase 13) Stage 5 — the (at most one) Complaint that routed to this case via `ComplaintService.classify()` when found to describe a possible adverse event.
   */
  routedFromComplaint    Complaint?

  @@unique([companyId, referenceNumber])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, createdBy])
  @@index([companyId, requiresDraftReview])
  @@index([companyId, clinicalTrialId])
  @@map("pv_case")
}

/**
 * VigiCloud Stage 6 — see `Case.expectednessFlag`'s own doc comment.
 */
enum ExpectednessFlag {
  listed
  unlisted
  not_assessed
}

enum PregnancyOutcome {
  ongoing
  live_birth_normal
  live_birth_congenital_anomaly
  spontaneous_abortion
  elective_termination
  stillbirth
  ectopic_pregnancy
  unknown
}

/**
 * VigiCloud Stage 3.1 — one of the special-situation field sets the Final
 * doc calls for "built directly into intake, not bolted on afterward":
 * pregnancy exposure, with outcome follow-up and a congenital-anomaly flag
 * that will drive Stage 11's follow-up cadence once that stage exists.
 * Optional 1:1 with `Case` (most cases have no pregnancy angle at all) —
 * created only when the intake wizard's "Pregnancy exposure" toggle is on.
 */
model PregnancyContext {
  id                       String           @id @db.Uuid
  companyId                String           @map("company_id") @db.Uuid
  company                  Company          @relation(fields: [companyId], references: [id])
  caseId                   String           @unique @map("case_id") @db.Uuid
  case                     Case             @relation(fields: [caseId], references: [id])
  expectedDeliveryDate     DateTime?        @map("expected_delivery_date") @db.Date
  gestationWeeksAtExposure Int?             @map("gestation_weeks_at_exposure")
  outcome                  PregnancyOutcome @default(ongoing)
  congenitalAnomalyDetail  String?          @map("congenital_anomaly_detail")
  /**
   * Not consumed yet — Stage 11 (Case Follow-Up) doesn't exist as a
   * mechanism yet, but the field is populated at capture time (a sensible
   * default follow-up window past the expected delivery date) so Stage 11
   * has real data to schedule against on day one rather than a second
   * migration to backfill it.
   */
  followUpDueAt            DateTime?        @map("follow_up_due_at") @db.Timestamptz(3)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, caseId])
  @@map("pv_pregnancy_context")
}

enum DuplicateReviewStatus {
  possible
  confirmed_duplicate
  not_duplicate
}

/**
 * The two Master Case patterns from the EMA guideline (§2.3.1) — see `Case.duplicateOfCaseId`'s own doc comment for how one field implements both.
 */
enum DuplicateResolutionPattern {
  allocation
  creation
}

/**
 * VigiCloud Stage 10 — one row per **compared pair** of cases, matching
 * the EMA Guideline on Detection and Management of Duplicate ICSRs'
 * three-step process (detection → confirmation → management) and its
 * "duplicate cluster" terminology. `status: possible` is the automated
 * detector's own proposal, never an auto-merge (the guideline is
 * explicit: "a manual confirmation will always be necessary"). A
 * reviewer's decision — confirm as a real duplicate, or document that
 * it genuinely isn't one — moves this to `confirmed_duplicate` or
 * `not_duplicate` and is never revisited by periodic re-screening
 * again for this exact pair (the guideline's own flowchart step 4.1:
 * "Document absence of duplicate... to avoid re-assessing these
 * potential duplicate clusters during periodic duplicate screening").
 * `(caseId, matchedCaseId)` is unique — detection always canonicalises
 * the pair (lower case id first) so periodic re-screening can never
 * create a second row for the same pair scanned in the other direction.
 */
model DuplicateReview {
  id                  String                      @id @db.Uuid
  companyId           String                      @map("company_id") @db.Uuid
  company             Company                     @relation(fields: [companyId], references: [id])
  caseId              String                      @map("case_id") @db.Uuid
  case                Case                        @relation("duplicate_review_case", fields: [caseId], references: [id])
  matchedCaseId       String                      @map("matched_case_id") @db.Uuid
  matchedCase         Case                        @relation("duplicate_review_matched_case", fields: [matchedCaseId], references: [id])
  status              DuplicateReviewStatus       @default(possible)
  /**
   * Which similarity criteria matched, e.g. `["country","sex","age","product","reaction"]` or `["cited_reference_number"]` — reviewer context, not re-derived from scratch on every view.
   */
  matchedFields       Json                        @map("matched_fields")
  detectedAt          DateTime                    @map("detected_at") @db.Timestamptz(3)
  reviewedBy          String?                     @map("reviewed_by") @db.Uuid
  reviewedByUser      User?                       @relation(fields: [reviewedBy], references: [id])
  reviewedAt          DateTime?                   @map("reviewed_at") @db.Timestamptz(3)
  /**
   * The reviewer's own reasoning — encrypted at rest like every other free-text case field (Stage 0.3).
   */
  reviewNoteEncrypted String?                     @map("review_note_encrypted")
  resolutionPattern   DuplicateResolutionPattern? @map("resolution_pattern")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([caseId, matchedCaseId])
  @@index([companyId, status])
  @@map("pv_duplicate_review")
}

enum CaseFollowUpStatus {
  pending_attempt_1
  pending_attempt_2
  closed_resolved
  closed_failed
}

enum FollowUpChannel {
  email
  phone
}

enum FollowUpAttemptOutcome {
  pending
  responded_resolved
  responded_new_information
  no_response
}

/**
 * VigiCloud Stage 11 — one active follow-up cycle per case (`caseId` is
 * unique; a resolved/failed cycle stays as history, a genuinely new
 * follow-up need after that would be a deliberate product decision to
 * revisit, not built here). Per the Final doc §D: "Follow-up begins at
 * intake, needs consent before contact, runs at least two attempts
 * (email window five working days), and any new update resets the
 * seven-day cycle; close within 28 days." **Reconciliation, since that
 * sentence genuinely underspecifies the exact mechanics**: `closesByDate`
 * (= `cycleStartedAt` + 28 calendar days) is a hard ceiling that never
 * moves. `nextCheckDueAt` is the "seven-day cycle" — set to
 * `lastResponseAt` + 7 calendar days whenever a `responded_new_information`
 * attempt is logged, giving the case a fresh, genuine week before the
 * periodic job is willing to escalate/close it again, without ever
 * extending past `closesByDate`. This is a defensible reading of a
 * one-sentence spec, not the only possible one — flagged here so a
 * future session can revisit if real usage shows it's wrong.
 */
model CaseFollowUp {
  id             String             @id @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  company        Company            @relation(fields: [companyId], references: [id])
  caseId         String             @unique @map("case_id") @db.Uuid
  case           Case               @relation(fields: [caseId], references: [id])
  status         CaseFollowUpStatus @default(pending_attempt_1)
  cycleStartedAt DateTime           @map("cycle_started_at") @db.Timestamptz(3)
  closesByDate   DateTime           @map("closes_by_date") @db.Timestamptz(3)
  lastResponseAt DateTime?          @map("last_response_at") @db.Timestamptz(3)
  nextCheckDueAt DateTime?          @map("next_check_due_at") @db.Timestamptz(3)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(3)
  closedReason   String?            @map("closed_reason")
  /**
   * Nullable — a follow-up cycle can be system-triggered (the periodic
   * job auto-starting one off a `PregnancyContext.followUpDueAt` that's
   * come due, with no human actor involved), mirroring the exact
   * precedent `Case.createdBy`/`Document.createdBy` already set for a
   * system-originated record with nobody to attribute it to.
   */
  startedBy      String?            @map("started_by") @db.Uuid
  startedByUser  User?              @relation(fields: [startedBy], references: [id])
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts CaseFollowUpAttempt[]

  @@index([companyId, status])
  @@map("pv_case_follow_up")
}

/**
 * One row per contact attempt — both system-triggered email reminders
 * (created by `CaseFollowUpService`/its scheduled job) and manually
 * logged phone contacts (the FE's own "log a follow-up contact"
 * action), matching Stage 3.5's `CallLog` precedent for a real,
 * append-only per-contact history rather than just two columns on the
 * parent row.
 */
model CaseFollowUpAttempt {
  id            String                 @id @db.Uuid
  companyId     String                 @map("company_id") @db.Uuid
  company       Company                @relation(fields: [companyId], references: [id])
  followUpId    String                 @map("follow_up_id") @db.Uuid
  followUp      CaseFollowUp           @relation(fields: [followUpId], references: [id])
  attemptNumber Int                    @map("attempt_number")
  channel       FollowUpChannel        @default(email)
  outcome       FollowUpAttemptOutcome @default(pending)
  triggeredAt   DateTime               @map("triggered_at") @db.Timestamptz(3)
  dueAt         DateTime               @map("due_at") @db.Timestamptz(3)
  respondedAt   DateTime?              @map("responded_at") @db.Timestamptz(3)
  loggedBy      String?                @map("logged_by") @db.Uuid
  loggedByUser  User?                  @relation(fields: [loggedBy], references: [id])
  /**
   * What was discussed/received — encrypted at rest like every other free-text case field (Stage 0.3).
   */
  noteEncrypted String?                @map("note_encrypted")
  /**
   * Real-usage request, 22 Sep 2026 (item 18) — a reporter can send a document (a photo, a lab result, a discharge letter) as part of their follow-up response; attached the same way any other case document is, via the generic Documents pipeline, never a bespoke upload path.
   */
  documentId    String?                @map("document_id") @db.Uuid
  document      Document?              @relation(fields: [documentId], references: [id])
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, followUpId])
  @@map("pv_case_follow_up_attempt")
}

/**
 * VigiCloud Stage 12 — one row per generated E2B submission attempt for a
 * case, per the build-spec's own "for the initial submission and every
 * follow-up resubmission separately" instruction — a real list, not a
 * single `Case.submissionEvidence` field as an earlier planning pass
 * assumed, since a case can legitimately be resubmitted (an amended
 * report, an initial submission that failed to upload). `submissionNumber`
 * is 1 for the first, 2+ for each resubmission — never reused, never
 * updated in place once created; only the evidence fields below get
 * written after the fact, matching the natural two-step real-world flow
 * (generate the artifacts, then — once actually uploaded to the
 * authority's own portal outside this system — come back and attach
 * proof). Never deleted, per the platform's own never-delete rule.
 */
model RegulatorySubmission {
  id                  String              @id @db.Uuid
  companyId           String              @map("company_id") @db.Uuid
  company             Company             @relation(fields: [companyId], references: [id])
  caseId              String              @map("case_id") @db.Uuid
  case                Case                @relation(fields: [caseId], references: [id])
  submissionNumber    Int                 @map("submission_number")
  authorityId         String              @map("authority_id") @db.Uuid
  authority           RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  /**
   * Real-usage request, 22 Sep 2026 (item 25) — which ICH E2B format the
   * XML below was generated in. R2 is the older, DTD-based, flat-XML
   * format WHO-UMC's VigiFlow (what PPB, and most African NRAs, actually
   * run) still requires; R3 is a structurally different, HL7 v3-based
   * message, offered for future clients outside Africa whose receiving
   * gateway expects it. Chosen explicitly by the generating user, never
   * inferred — see `E2bXmlBuilderService.buildR3()`'s own doc comment for
   * how completely that generator has (and hasn't) been validated.
   */
  format              String              @default("R2")
  /**
   * `ReportabilityService`'s own verdict at generation time, snapshotted
   * (not re-derived later) — per CLAUDE.md's confirmed domain rule, a
   * "foreign" case (occurrence country ≠ report country) is never
   * individually reportable, only folded into the periodic PBRER/PSUR;
   * generation is still allowed either way (a QPPV may want the PDF for
   * their own internal file even when it won't be individually
   * submitted), but the reason is always recorded plainly.
   */
  reportable          Boolean
  reportabilityReason String              @map("reportability_reason")
  xmlDocumentId       String              @map("xml_document_id") @db.Uuid
  xmlDocument         Document            @relation("regulatory_submission_xml", fields: [xmlDocumentId], references: [id])
  pdfDocumentId       String              @map("pdf_document_id") @db.Uuid
  pdfDocument         Document            @relation("regulatory_submission_pdf", fields: [pdfDocumentId], references: [id])
  generatedBy         String              @map("generated_by") @db.Uuid
  generatedByUser     User                @relation("regulatory_submission_generated_by", fields: [generatedBy], references: [id])
  generatedAt         DateTime            @map("generated_at") @db.Timestamptz(3)
  /**
   * Null until a human confirms the actual upload to the authority's own portal (VigiFlow/PvERS) happened outside this system — see Stage 12's own "No live PPB gateway integration" scope note.
   */
  evidenceDocumentId  String?             @map("evidence_document_id") @db.Uuid
  evidenceDocument    Document?           @relation("regulatory_submission_evidence", fields: [evidenceDocumentId], references: [id])
  submittedAt         DateTime?           @map("submitted_at") @db.Timestamptz(3)
  submittedBy         String?             @map("submitted_by") @db.Uuid
  submittedByUser     User?               @relation("regulatory_submission_submitted_by", fields: [submittedBy], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([caseId, submissionNumber])
  @@index([companyId, caseId])
  @@map("regulatory_submission")
}

enum CallOutcome {
  case_created
  information_only
  follow_up_required
  unable_to_reach
}

/**
 * VigiCloud Stage 3.5 — a CRM-style action log for a phone/hotline
 * report, not a full case by itself. `caseId` is null when the call
 * didn't result in a reportable case (e.g. `information_only`,
 * `unable_to_reach`) — deliberately optional, since the actual
 * telephony/VOIP infrastructure to receive calls is a real open
 * infra dependency (see `needs.md` §2); this table only ever records
 * what a staff member manually typed up *after* a call, exactly like
 * the "Log a call" quick-entry screen it's built for.
 */
model CallLog {
  id                         String      @id @db.Uuid
  companyId                  String      @map("company_id") @db.Uuid
  company                    Company     @relation(fields: [companyId], references: [id])
  callerNumber               String      @map("caller_number")
  occurredAt                 DateTime    @map("occurred_at") @db.Timestamptz(3)
  durationSeconds            Int?        @map("duration_seconds")
  outcome                    CallOutcome
  notes                      String?
  caseId                     String?     @map("case_id") @db.Uuid
  case                       Case?       @relation(fields: [caseId], references: [id])
  loggedBy                   String      @map("logged_by") @db.Uuid
  logger                     User        @relation(fields: [loggedBy], references: [id])
  /**
   * VigiCloud Stage 21 — true when this row logs a missed call or
   * voicemail rather than a call actually answered live. Per Final doc
   * §J: audio recording is encouraged, but audio-to-text auto-fill is
   * explicitly deferred to Tier 3 — this build only ever stores the raw
   * audio artifact (if the staff member has one to upload, e.g. their
   * own phone's voicemail export) and a manual transcription/summary,
   * never an automated transcript.
   */
  isVoicemail                Boolean     @default(false) @map("is_voicemail")
  audioDocumentId            String?     @map("audio_document_id") @db.Uuid
  audioDocument              Document?   @relation(fields: [audioDocumentId], references: [id])
  /**
   * A human's own summary/transcription of the voicemail — encrypted like every other free-text field that could carry a reporter's own account of an adverse event (Stage 0.3).
   */
  transcriptionNoteEncrypted String?     @map("transcription_note_encrypted")
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, occurredAt])
  @@map("pv_call_log")
}

/**
 * VigiCloud Stage 19 — a manually-logged screening event, per the user's
 * own explicit call: "it would not be an api search but a
 * manually-logged screening event." This table exists purely to satisfy
 * Stage 16.2 requirement row 12 ("literature-monitoring evidence") —
 * proving the company *does* literature searches, not running one. A
 * staff member performs their own search (PubMed, a journal, etc.)
 * outside this system and logs what they did here afterward; there is
 * no search-API integration anywhere in this model, deliberately.
 */
model LiteratureMonitoringRun {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  runAt       DateTime @map("run_at") @db.Timestamptz(3)
  /**
   * e.g. "PubMed manual search", "Monthly journal review — Drug Safety". Free text, not an enum — real screening methods vary too much per tenant to close-list.
   */
  method      String
  searchTerms String   @map("search_terms")
  hitsCount   Int      @map("hits_count")
  /**
   * What was actually found, in the reviewer's own words — literature content, not patient data, so this is plain text, not encrypted (unlike every patient-narrative field elsewhere in this schema).
   */
  hitsSummary String?  @map("hits_summary")
  loggedBy    String   @map("logged_by") @db.Uuid
  logger      User     @relation(fields: [loggedBy], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, runAt])
  @@map("pv_literature_monitoring_run")
}

/**
 * Consumer or professional — captured at intake; exactly one per case.
 */
model Reporter {
  id            String       @id @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id])
  caseId        String       @unique @map("case_id") @db.Uuid
  case          Case         @relation(fields: [caseId], references: [id])
  reporterType  ReporterType @map("reporter_type")
  fullName      String?      @map("full_name")
  email         String?
  phone         String?
  /**
   * Matches the E2B `qualification` field's real-world values: physician, pharmacist, other HCP, consumer/non-HCP — free text for now, not yet a coded list.
   */
  qualification String?
  countryId     String?      @map("country_id") @db.Uuid
  country       Country?     @relation(fields: [countryId], references: [id])
  /**
   * Distributor-sourced reports need this for the manufacturer-distributor reconciliation mapping (Stage 15).
   */
  organization  String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("pv_reporter")
}

/**
 * VigiCloud Stage 15.1 — a manufacturer tenant's own list of its
 * distributors, per the user's own note: "All our manufacturers would
 * have a list of their distributors on accounts." `distributorCompanyId`
 * is set only when the distributor is itself a SafeMeds tenant — the
 * precondition for Stage 15.1's cross-tenant auto-reconciliation
 * (`ReconciliationService.crossTenantSummary()`); most distributors are
 * not SafeMeds tenants, so this stays null for them. Never deleted —
 * `status` moves through its own lifecycle instead.
 * **Forward dependency for whoever builds Stage 16.5 (SDEA management)**:
 * that stage's own build-spec text calls for "renewal reminders" tied to
 * the SDEA record "that governs each manufacturer-distributor
 * relationship" — SDEA doesn't exist yet, so no FK exists here for it on
 * purpose. When Stage 16.5 is built, its own SDEA model should carry the
 * `distributorId` FK pointing *into* this table (the dependency runs
 * Stage 16 → Stage 15, not the other way — this table must not be
 * speculatively extended for a model that doesn't exist yet), and its
 * renewal-reminder job should follow the exact same "derive due-ness
 * from `Task` history, no parallel tracking column" pattern
 * `ProductReviewReminderService`/`ClinicalTrialAnnualReminderService`
 * already established.
 */
model Distributor {
  id                   String            @id @db.Uuid
  companyId            String            @map("company_id") @db.Uuid
  company              Company           @relation("distributor_owner", fields: [companyId], references: [id])
  name                 String
  contactEmail         String?           @map("contact_email")
  contactPhone         String?           @map("contact_phone")
  countryId            String?           @map("country_id") @db.Uuid
  country              Country?          @relation(fields: [countryId], references: [id])
  distributorCompanyId String?           @map("distributor_company_id") @db.Uuid
  distributorCompany   Company?          @relation("distributor_tenant", fields: [distributorCompanyId], references: [id])
  status               DistributorStatus @default(active)
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  caseMappings          CaseDistributorMapping[]
  reconciliationReports ReconciliationReport[]
  sdeas                 Sdea[]
  trainingRecords       DistributorTrainingRecord[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("distributor")
}

enum DistributorStatus {
  active
  inactive
}

/**
 * VigiCloud Stage 15.1 — persisted only for a case that needed a human's
 * attention: `Reporter.organization` cleanly matching a listed
 * `Distributor.name` (case-insensitive, trimmed) is resolved *live* at
 * report-generation time by `ReconciliationService` and never
 * redundantly persisted here — this table exists only for the cases
 * that didn't cleanly auto-match (or where a human deliberately
 * overrides an auto-match), so its mere presence for a case means
 * "a human looked at this." `distributorId: null` is itself a real,
 * meaningful answer — "confirmed not distributor-sourced" — distinct
 * from no row existing at all ("not yet reconciled").
 */
model CaseDistributorMapping {
  id               String       @id @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  company          Company      @relation(fields: [companyId], references: [id])
  caseId           String       @unique @map("case_id") @db.Uuid
  case             Case         @relation(fields: [caseId], references: [id])
  distributorId    String?      @map("distributor_id") @db.Uuid
  distributor      Distributor? @relation(fields: [distributorId], references: [id])
  reconciledBy     String       @map("reconciled_by") @db.Uuid
  reconciledByUser User         @relation(fields: [reconciledBy], references: [id])
  reconciledAt     DateTime     @default(now()) @map("reconciled_at") @db.Timestamptz(3)
  note             String?

  @@map("case_distributor_mapping")
}

/**
 * VigiCloud Stage 15.1 — "archived and auditable": a report is a
 * point-in-time, never-updated snapshot (every generation, including a
 * re-run over the same period, is a new row), matching the same
 * append-only-in-spirit precedent `RegulatorySubmission` already set for
 * "generate again rather than mutate a prior generation." `snapshot`
 * carries the full case-ID breakdown per distributor plus the unmatched
 * list, so the archived report stays meaningful even if a distributor is
 * later renamed or deactivated.
 */
model ReconciliationReport {
  id              String       @id @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  company         Company      @relation(fields: [companyId], references: [id])
  /**
   * Null = a whole-company report spanning every listed distributor at once.
   */
  distributorId   String?      @map("distributor_id") @db.Uuid
  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  periodStart     DateTime     @map("period_start") @db.Date
  periodEnd       DateTime     @map("period_end") @db.Date
  totalCases      Int          @map("total_cases")
  matchedCases    Int          @map("matched_cases")
  unmatchedCases  Int          @map("unmatched_cases")
  snapshot        Json
  generatedBy     String       @map("generated_by") @db.Uuid
  generatedByUser User         @relation(fields: [generatedBy], references: [id])
  generatedAt     DateTime     @default(now()) @map("generated_at") @db.Timestamptz(3)

  @@index([companyId, generatedAt])
  @@map("reconciliation_report")
}

/**
 * VigiCloud Stage 15.2 — tests whether a contact *channel* (a mailbox, a
 * phone line) is reachable at all, independent of any one case — e.g.
 * the evidence Stage 16.2's audit-readiness row 7 ("24/7 availability
 * evidence") will pull from once that stage exists. Two-trigger retry,
 * per the user's own note: attempt 1 unanswered moves to attempt 2;
 * attempt 2 unanswered closes `unsuccessful`; either attempt answered
 * closes `reached` immediately ("good and dusted"). `windowDueAt` is
 * 5 **calendar** days out for `email` (the user's own "5 day testing"
 * wording carries no "working days" qualifier, unlike Stage 11's case
 * follow-up, which explicitly says "working" — a deliberate, documented
 * reading of a short spec sentence, not the only possible one) and set
 * to "now" for `phone` ("immediately," per the same note) — a human
 * logs a phone attempt's outcome right after making the call, with
 * nothing to wait on.
 */
model ContactTest {
  id              String             @id @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  company         Company            @relation(fields: [companyId], references: [id])
  channel         ContactTestChannel
  /**
   * The email address or phone number under test — a channel, not necessarily any one person's own contact info (e.g. the QPPV after-hours hotline, the shared drug-safety mailbox).
   */
  contactValue    String             @map("contact_value")
  /**
   * Free text — what this test is verifying reachability for, e.g. "QPPV after-hours hotline".
   */
  purpose         String?
  status          ContactTestStatus  @default(pending_attempt_1)
  attemptCount    Int                @default(0) @map("attempt_count")
  windowDueAt     DateTime           @map("window_due_at") @db.Timestamptz(3)
  initiatedBy     String?            @map("initiated_by") @db.Uuid
  initiatedByUser User?              @relation(fields: [initiatedBy], references: [id])
  resolvedAt      DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts ContactTestAttempt[]

  @@index([companyId, status])
  @@map("contact_test")
}

enum ContactTestChannel {
  email
  phone
}

enum ContactTestStatus {
  pending_attempt_1
  pending_attempt_2
  reached
  unsuccessful
}

model ContactTestAttempt {
  id            String                    @id @db.Uuid
  companyId     String                    @map("company_id") @db.Uuid
  company       Company                   @relation(fields: [companyId], references: [id])
  contactTestId String                    @map("contact_test_id") @db.Uuid
  contactTest   ContactTest               @relation(fields: [contactTestId], references: [id])
  attemptNumber Int                       @map("attempt_number")
  outcome       ContactTestAttemptOutcome
  /**
   * Null for a system-detected timeout (an email window that closed with no reply) — mirrors `CaseFollowUpAttempt`'s own nullable-actor precedent for a non-human-triggered outcome.
   */
  loggedBy      String?                   @map("logged_by") @db.Uuid
  loggedByUser  User?                     @relation(fields: [loggedBy], references: [id])
  note          String?
  occurredAt    DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@map("contact_test_attempt")
}

enum ContactTestAttemptOutcome {
  reached
  no_response
}

/**
 * Exactly one per case. Not full name by default, per the Stage 0.2 anonymisation base engine — initials/identifiers only.
 */
model Patient {
  id                      String     @id @db.Uuid
  companyId               String     @map("company_id") @db.Uuid
  company                 Company    @relation(fields: [companyId], references: [id])
  caseId                  String     @unique @map("case_id") @db.Uuid
  case                    Case       @relation(fields: [caseId], references: [id])
  initials                String?
  dateOfBirth             DateTime?  @map("date_of_birth") @db.Date
  /**
   * For when only age is known, not DOB — common in real-world intake (matches the real Kenya E2B sample, which had neither for its patient).
   */
  ageYears                Int?       @map("age_years")
  sex                     PatientSex @default(unknown)
  weightKg                Float?     @map("weight_kg")
  heightCm                Float?     @map("height_cm")
  medicalHistoryEncrypted String?    @map("medical_history_encrypted")
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("pv_patient")
}

/**
 * One or more per case. Field shape matches the real E2B sample's `<drug>` block exactly.
 */
model SuspectProduct {
  id                   String               @id @db.Uuid
  companyId            String               @map("company_id") @db.Uuid
  company              Company              @relation(fields: [companyId], references: [id])
  caseId               String               @map("case_id") @db.Uuid
  case                 Case                 @relation(fields: [caseId], references: [id])
  /**
   * 1=suspect / 2=concomitant in the real E2B sample's `drugcharacterization` field — named here, not numbered.
   */
  drugCharacterization DrugCharacterization @map("drug_characterization")
  /**
   * As reported, e.g. "Depo-Provera" — matches E2B `medicinalproduct`.
   */
  medicinalProduct     String               @map("medicinal_product")
  /**
   * Real-usage request, 22 Sep 2026 — "product name (brand name and
   * generic name)" on the public reporting form. `medicinalProduct`
   * above already serves as the brand/as-reported name (E2B
   * `medicinalproduct`); this is the genuinely separate generic name —
   * distinct from `activeSubstanceName` below the same way `Product
   * .genericName` is deliberately kept distinct from `Product.innName`
   * elsewhere in this schema (a company's own preferred generic label
   * is not always the WHO INN).
   */
  genericName          String?              @map("generic_name")
  /**
   * Matches E2B `activesubstancename`, e.g. "MEDROXYPROGESTERONE ACETATE".
   */
  activeSubstanceName  String?              @map("active_substance_name")
  atcCode              String?              @map("atc_code")
  dosageForm           String?              @map("dosage_form")
  route                String?
  /**
   * Free text, matches E2B `drugdosagetext` (often "UNK" in real reports).
   */
  doseText             String?              @map("dose_text")
  batchNumber          String?              @map("batch_number")
  /**
   * Real-usage request, 22 Sep 2026 — the physical batch's own expiry/manufacturing dates, distinct from `startDate`/`endDate` below (which are the *patient's* exposure window, not the product's shelf life).
   */
  manufacturingDate    DateTime?            @map("manufacturing_date") @db.Date
  expiryDate           DateTime?            @map("expiry_date") @db.Date
  startDate            DateTime?            @map("start_date") @db.Date
  endDate              DateTime?            @map("end_date") @db.Date
  /**
   * e.g. "drug withdrawn" — matches E2B `actiondrug`.
   */
  actionTaken          String?              @map("action_taken")
  obtainedCountryId    String?              @map("obtained_country_id") @db.Uuid
  obtainedCountry      Country?             @relation(fields: [obtainedCountryId], references: [id])
  /**
   * VigiCloud Stage 2 — optional link to the tenant's own `Product`
   * catalog, added exactly the way Stage 1's own schema comment predicted
   * ("adding an optional `productId` FK... is a purely additive
   * migration, not a retrofit"). Deliberately nullable and never
   * required: a reported product is very often not in the tenant's
   * catalog at all (a competitor's product, an over-the-counter item
   * never formally registered, a product named slightly differently by
   * the reporter than its catalog entry) — matching real E2B practice,
   * where `medicinalproduct` is always free text regardless of whether a
   * structured product record exists anywhere. When set, the case intake
   * UI used it to prefill this row's own inline fields (which remain the
   * source of truth for what was actually reported, editable/overridable
   * even after picking a catalog product) rather than the case ever
   * reading through to `Product` live.
   */
  productId            String?              @map("product_id") @db.Uuid
  product              Product?             @relation(fields: [productId], references: [id])
  /**
   * VigiCloud Stage 7 — the WHODrug Global counterpart to `meddraTermId` on
   * `AdverseEvent`, distinct from `productId` above: `productId` links to
   * the *tenant's own* product catalog (Stage 2, optional, prefills intake
   * only), while `whoDrugTermId` links to the *global* WHODrug dictionary
   * (this same drug's standardized coding for aggregation/signal work,
   * exactly like `meddraTermId` standardizes a reaction). A case can have
   * one, both, or neither — coding is independent of whether a catalog
   * match was ever picked at intake. Null until a real subscription exists
   * (or the mock subset stands in) and someone codes it.
   */
  whoDrugTermId        String?              @map("who_drug_term_id") @db.Uuid
  whoDrugTerm          WhoDrugTerm?         @relation(fields: [whoDrugTermId], references: [id])
  whoDrugCodedBy       String?              @map("who_drug_coded_by") @db.Uuid
  whoDrugCodedByUser   User?                @relation(fields: [whoDrugCodedBy], references: [id])
  whoDrugCodedAt       DateTime?            @map("who_drug_coded_at") @db.Timestamptz(3)
  /**
   * VigiCloud Stage 3 — special-situation flags matching ICH E2B(R3)'s real
   * `drugadditional` field group, which is genuinely modelled per suspect
   * drug (a case can name two products where only one was used off-label,
   * for instance) rather than once per case.
   */
  isOverdose           Boolean              @default(false) @map("is_overdose")
  isOffLabelUse        Boolean              @default(false) @map("is_off_label_use")
  isMisuse             Boolean              @default(false) @map("is_misuse")
  isMedicationError    Boolean              @default(false) @map("is_medication_error")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  causalityAssessments CausalityAssessment[]

  @@index([companyId, caseId])
  @@index([companyId, productId])
  @@map("pv_suspect_product")
}

/**
 * One or more per case — a case can report several reactions, exactly like the real Kenya sample's three `<reaction>` blocks for one patient.
 */
model AdverseEvent {
  id                           String          @id @db.Uuid
  companyId                    String          @map("company_id") @db.Uuid
  company                      Company         @relation(fields: [companyId], references: [id])
  caseId                       String          @map("case_id") @db.Uuid
  case                         Case            @relation(fields: [caseId], references: [id])
  /**
   * Null until Stage 7's coding UI assigns one — the reporter's own words (`reportedTerm`) are always captured regardless.
   */
  meddraTermId                 String?         @map("meddra_term_id") @db.Uuid
  meddraTerm                   MeddraTerm?     @relation(fields: [meddraTermId], references: [id])
  /**
   * Who coded it and when — mirrors `SourceDocument.redactedBy`/`redactedAt`'s own precedent for "who did this review action." The dictionary version used is never stored separately here: `meddraTerm.versionId` is itself a snapshot at coding time (a later MSSO release creates new `MeddraTerm` rows, it never mutates old ones), so re-coding to a newer version is always an explicit, audited change of `meddraTermId`, never a silent drift.
   */
  meddraCodedBy                String?         @map("meddra_coded_by") @db.Uuid
  meddraCodedByUser            User?           @relation(fields: [meddraCodedBy], references: [id])
  meddraCodedAt                DateTime?       @map("meddra_coded_at") @db.Timestamptz(3)
  reportedTerm                 String          @map("reported_term")
  /**
   * The reaction narrative in the reporter's own words — matches E2B `primarysourcereaction`. Encrypted at rest (Stage 0.3).
   */
  narrativeEncrypted           String          @map("narrative_encrypted")
  onsetDate                    DateTime?       @map("onset_date") @db.Date
  resolutionDate               DateTime?       @map("resolution_date") @db.Date
  outcome                      ReactionOutcome @default(unknown)
  /**
   * Six independent flags, matching the real E2B sample's `seriousnessX` fields exactly — not a single "isSerious" boolean, since a case's overall seriousness (Stage 5) is a triage judgment over these, not a re-statement of them.
   */
  seriousnessDeath             Boolean         @default(false) @map("seriousness_death")
  seriousnessLifeThreatening   Boolean         @default(false) @map("seriousness_life_threatening")
  seriousnessHospitalization   Boolean         @default(false) @map("seriousness_hospitalization")
  seriousnessDisabling         Boolean         @default(false) @map("seriousness_disabling")
  seriousnessCongenitalAnomaly Boolean         @default(false) @map("seriousness_congenital_anomaly")
  seriousnessOther             Boolean         @default(false) @map("seriousness_other")
  /**
   * VigiCloud Stage 3 — per CLAUDE.md's own confirmed domain knowledge,
   * "Therapeutic ineffectiveness IS formally reportable" on the Kenyan PPB
   * form. Modelled on `AdverseEvent`, not `SuspectProduct` — it describes
   * the nature of the reported outcome ("the drug didn't work"), the same
   * category of fact `outcome`/`reportedTerm` already capture, not a
   * product-usage circumstance like the `SuspectProduct` flags above.
   */
  isLackOfEfficacy             Boolean         @default(false) @map("is_lack_of_efficacy")
  createdAt                    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  causalityAssessments CausalityAssessment[]

  @@index([companyId, caseId])
  @@map("pv_adverse_event")
}

/**
 * Modelled per (SuspectProduct × AdverseEvent) pair — never once per case
 * — per the user's own explicit note ("the modelling point most likely to
 * be got wrong"). One row auto-created for every product/event
 * combination at case-creation time (`@@unique` enforces exactly one per
 * pair); `whoUmcCategory`/`naranjoScore` stay null until Stage 8's actual
 * medical-review workflow assesses them — this stage only guarantees the
 * pair-shaped row exists to be filled in later, it does not build the
 * assessment UI itself.
 */
model CausalityAssessment {
  id               String           @id @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  company          Company          @relation(fields: [companyId], references: [id])
  caseId           String           @map("case_id") @db.Uuid
  case             Case             @relation(fields: [caseId], references: [id])
  suspectProductId String           @map("suspect_product_id") @db.Uuid
  suspectProduct   SuspectProduct   @relation(fields: [suspectProductId], references: [id])
  adverseEventId   String           @map("adverse_event_id") @db.Uuid
  adverseEvent     AdverseEvent     @relation(fields: [adverseEventId], references: [id])
  whoUmcCategory   WhoUmcCausality? @map("who_umc_category")
  naranjoScore     Int?             @map("naranjo_score")
  /**
   * The 10-question Naranjo answer set (`vigicloud docs/Naranjo-assessment.pdf`), stored for audit/reproducibility of the total score — not just the final number.
   */
  naranjoAnswers   Json?            @map("naranjo_answers")
  assessedBy       String?          @map("assessed_by") @db.Uuid
  assessedByUser   User?            @relation(fields: [assessedBy], references: [id])
  assessedAt       DateTime?        @map("assessed_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([suspectProductId, adverseEventId])
  @@index([companyId, caseId])
  @@map("pv_causality_assessment")
}

/**
 * The mandatory, auditable original artifact per case (email/PDF/
 * handwritten note/WhatsApp screenshot) — a thin link between a `Case`
 * and the base engine's existing polymorphic `Document`/`DocumentVersion`
 * storage (Phase 8), which already handles the actual file bytes,
 * presigned upload, and server-side hash verification. This table adds
 * only what's PV-specific: the redaction flag/actor, and "this Document
 * is this case's source-document evidence" as an explicit fact, not an
 * inferred one from `Document.recordType = 'pv_case'` alone (a case can
 * have other, non-source-document attachments later without them being
 * mistaken for this mandatory one).
 */
model SourceDocument {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  company            Company   @relation(fields: [companyId], references: [id])
  caseId             String    @map("case_id") @db.Uuid
  case               Case      @relation(fields: [caseId], references: [id])
  documentId         String    @map("document_id") @db.Uuid
  document           Document  @relation("source_document_original", fields: [documentId], references: [id])
  redactionApplied   Boolean   @default(false) @map("redaction_applied")
  redactedBy         String?   @map("redacted_by") @db.Uuid
  redactedByUser     User?     @relation(fields: [redactedBy], references: [id])
  redactedAt         DateTime? @map("redacted_at") @db.Timestamptz(3)
  /**
   * VigiCloud Stage 3.7 — "a flag + a redacted-copy upload slot, distinct
   * from the original" (todo doc's own wording). A separate `Document`
   * (already-uploaded via the generic Phase 8 handshake, same
   * `recordType: "pv_case"`/`recordId: caseId` as the original) safe to
   * hand to a regulator or anyone else who shouldn't see the unredacted
   * artifact — never derived automatically, always a real second file a
   * human prepared and uploaded.
   */
  redactedDocumentId String?   @map("redacted_document_id") @db.Uuid
  redactedDocument   Document? @relation("source_document_redacted_copy", fields: [redactedDocumentId], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, caseId])
  @@map("pv_source_document")
}

// ============================================================
// VigiCloud Stage 17 — Signal Management
// ============================================================

enum SignalRecommendationAction {
  request_more_data
  propose_product_info_update
  request_rmp_update
  propose_risk_minimisation
  sponsor_followup_study
  no_action
}

/**
 * VigiCloud Stage 17 — built against GVP Module IX §IX.A.1.1's six named
 * activities (Reconciliation Note 7): detection → validation →
 * confirmation → analysis and prioritisation → assessment →
 * recommendation for action. The lifecycle itself lives entirely in the
 * generic workflow engine (a `signal` `WorkflowDefinition`, the exact
 * same mechanism `pv_case` already uses — see `workflow.seed-data.ts`);
 * this model only carries the domain data each stage of that lifecycle
 * actually collects. `status` is the same denormalized-cache-of-the-live-
 * `WorkflowInstance.currentState` pattern `Case.status` already
 * established (Stage 1's own doc comment on that field applies
 * identically here: `get()` should read the live state, `list()` may
 * trust this column for query performance).
 */
model Signal {
  id                String   @id @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  company           Company  @relation(fields: [companyId], references: [id])
  title             String
  description       String
  status            String   @default("detected")
  /**
   * The system-generated pattern-flagging detector (this build's only
   * detection method — no statistical disproportionality/PRR/ROR/EBGM,
   * that's Tier 3 and explicitly out of scope) always sets this to
   * `'pattern_flag'`. A manually-raised signal (GVP permits a human to
   * raise one directly, not only the automated detector) sets `'manual'`.
   */
  detectionMethod   String   @default("pattern_flag") @map("detection_method")
  productIdentifier String   @map("product_identifier")
  batchNumber       String?  @map("batch_number")
  /**
   * testing-todo Stage 17.2 — optional link to the tenant's own `Product`
   * catalog, set when a manually-raised signal's product field was
   * matched via the search-and-pick widget (same "prefills but never
   * locks" precedent `SuspectProduct.productId` established in Stage 2:
   * `productIdentifier` above remains the actual as-reported text and
   * the real source of truth; this is a traceability aid only). Always
   * null for a `pattern_flag`-detected signal — the automatic detector
   * derives `productIdentifier` from case data, never a catalog pick.
   */
  productId         String?  @map("product_id") @db.Uuid
  product           Product? @relation(fields: [productId], references: [id])

  // Validation stage (GVP §IX.B.3) — previous awareness, strength of
  // evidence, clinical relevance.
  previousAwareness           Boolean? @map("previous_awareness")
  previousAwarenessNote       String?  @map("previous_awareness_note")
  /**
   * "Case count after de-duplication" (Reconciliation Note 7) — computed
   * automatically by `SignalService.recordValidation()` from the linked
   * cases' own `Case.duplicateOfCaseId IS NULL` count at the moment of
   * validation (Stage 10's Master Case concept), never hand-typed by a
   * human — a permanent snapshot of what the evidence looked like when
   * the validation decision was made, matching `ReconciliationReport`'s
   * own "archived snapshot, not a live-recomputed value" precedent.
   */
  strengthOfEvidenceCaseCount Int?     @map("strength_of_evidence_case_count")
  clinicalRelevanceNote       String?  @map("clinical_relevance_note")

  // Analysis & prioritisation stage (GVP §IX.B.4).
  severityNote                   String? @map("severity_note")
  patientExposureNote            String? @map("patient_exposure_note")
  expectedRegulatoryResponseNote String? @map("expected_regulatory_response_note")

  // Assessment stage.
  assessmentNote String? @map("assessment_note")
  /**
   * Real-usage request, 22 Sep 2026 (item 22) — the four-eyes rule at
   * the level of recommendation/actions: whoever recorded this signal's
   * assessment cannot also be the one who recommends the final action,
   * mirroring `CausalityAssessment.assessedBy`'s own exact four-eyes
   * precedent on `pv_case`'s Narrative → Quality Check transition. Set
   * by `SignalService.recordAssessment()`, checked by
   * `SignalWorkflowGuards`'s new guard on `assessed → action_recommended`.
   */
  assessedBy     String? @map("assessed_by") @db.Uuid
  assessor       User?   @relation("signal_assessed_by", fields: [assessedBy], references: [id])

  // Recommendation for action (GVP §IX.C.7 — the non-EU-regulator-specific subset).
  recommendationAction SignalRecommendationAction? @map("recommendation_action")
  recommendationNote   String?                     @map("recommendation_note")

  createdBy String?  @map("created_by") @db.Uuid
  creator   User?    @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  linkedCases SignalCase[]

  @@index([companyId, status])
  @@map("pv_signal")
}

/**
 * The evidence behind a signal — which real cases exhibited the pattern.
 * A plain join table (not a JSON array on `Signal`) so the linked cases
 * stay genuinely queryable — the "click through to the case" detail-page
 * requirement and the de-duplicated evidence-strength count both need a
 * real relation, not a parsed blob.
 */
model SignalCase {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  signalId  String   @map("signal_id") @db.Uuid
  signal    Signal   @relation(fields: [signalId], references: [id])
  caseId    String   @map("case_id") @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([signalId, caseId])
  @@index([companyId, caseId])
  @@map("pv_signal_case")
}

// ============================================================
// VigiCloud Stage 16 — Governance & Audit Module
// ============================================================

enum PsmfStatus {
  draft
  active
  retired
}

/**
 * VigiCloud Stage 16.1 — Pharmacovigilance System Master File, a real,
 * named, version-controlled, access-restricted document requirement
 * (GUD/022 §6.6, GUD/006 §4.1) flagged as a real gap in this project's
 * own domain-knowledge notes. Version-on-write, exactly like
 * `ReportingRule`/`SeriousnessDefinition`/`FormSchema`/
 * `SubmissionFormat` (Phase 4.1's own precedent): no UPDATE endpoint —
 * `POST` always inserts a new `draft` at `(max version for this
 * company) + 1`, `.../activate` retires whatever was previously active
 * and flips the target, enforced by a DB-level partial unique index
 * (`psmf_one_active_per_company`, `WHERE status = 'active'`, added by
 * hand in this stage's migration — Prisma's schema language can't
 * express a partial index, matching how `reporting_rule_one_active_per_key`
 * was already added the same way). `documentId` is nullable — GUD/006's
 * own onboarding language is "create it with the client, or let them
 * upload an existing one," so a draft can exist as a title/summary
 * placeholder before a real file is attached and only needs a document
 * to ever be activated (enforced in `PsmfService.activate()`, not the
 * schema — matches this repo's "constrained by application logic"
 * precedent elsewhere, e.g. `ContactTest`'s retry state machine).
 */
model Psmf {
  id          String     @id @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  company     Company    @relation(fields: [companyId], references: [id])
  version     Int
  status      PsmfStatus @default(draft)
  title       String
  summary     String?
  /**
   * Real-usage content, 11 Sep 2026 — "help create or let them upload...
   * our system should allow them to upload if they already have or
   * create if they don't have yet." The upload half already existed
   * (`documentId` below); this is the "create" half — the structured
   * content of a real PSMF, shaped exactly like `vigicloud document
   * formats/kenya-psmf-template.docx`'s own 7 sections (QPPV, org
   * structure, sources of safety data, computerized systems, SOPs, QMS,
   * appendices — see `PsmfContent` in `psmf-pdf.service.ts` for the
   * literal TypeScript shape). A `Json` column, not a relational child
   * table — matching `FormSchema.jsonSchema`'s own established
   * precedent for "structured-but-flexible template content," since a
   * PSMF's own free-text narrative sections don't decompose into a
   * fixed relational shape the way a document checklist does.
   * `PsmfPdfService.render()` turns this into the real generated PDF,
   * which then becomes this same draft's own `documentId` below — the
   * "create" and "upload" paths converge on the identical field the
   * moment a document exists, so `activate()`'s "documentId required"
   * gate needs no change to support either one.
   */
  content     Json?
  documentId  String?    @map("document_id") @db.Uuid
  document    Document?  @relation(fields: [documentId], references: [id])
  createdBy   String?    @map("created_by") @db.Uuid
  creator     User?      @relation("psmf_created_by", fields: [createdBy], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt DateTime?  @map("activated_at") @db.Timestamptz(3)
  retiredAt   DateTime?  @map("retired_at") @db.Timestamptz(3)

  @@unique([companyId, version])
  @@index([companyId, status])
  @@map("psmf")
}

enum AuditRequirementSource {
  system_generated
  person_uploads
}

enum AuditRequirementStatus {
  ready
  needs_update
  expiring
  missing
}

/**
 * VigiCloud Stage 16.2 — the seeded catalog of PPB-inspected items
 * (Final doc §H2's 15-row table), one row per authority (Kenya PPB
 * built first, per the build spec's own "configurable per NRA"
 * framing). This is reference/seed data, not tenant data — mirrors
 * `MeddraTerm`/`WhoDrugTerm`'s own "global, versioned, seeded" shape,
 * not a per-company table. `AuditRequirementRecord` below is the
 * per-company mutable half.
 */
model AuditRequirementDefinition {
  id                   String                 @id @db.Uuid
  authorityId          String                 @map("authority_id") @db.Uuid
  authority            RegulatoryAuthority    @relation(fields: [authorityId], references: [id])
  requirementKey       String                 @map("requirement_key")
  sortOrder            Int                    @map("sort_order")
  title                String
  description          String
  /**
   * Admin Configuration Console — the exact guideline citation behind
   * this requirement (e.g. "GUD/022 §6.6"), editable independently of
   * `description`. Nullable: the original 15 rows were transcribed from
   * the planning summary PDF, not a per-item guideline-cited source, so
   * this starts empty for all of them until a field expert supplies the
   * real citation through the admin UI.
   */
  guidelineReference   String?                @map("guideline_reference")
  source               AuditRequirementSource
  evidenceArtifactType String                 @map("evidence_artifact_type")
  isMandatory          Boolean                @default(true) @map("is_mandatory")
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  records AuditRequirementRecord[]

  @@unique([authorityId, requirementKey])
  @@map("audit_requirement_definition")
}

/**
 * The per-company mutable half of a requirement — only meaningfully
 * populated for `source: person_uploads` rows (a human's own
 * status/evidence/note). For `source: system_generated` rows this
 * table is never the source of truth: `AuditReadinessService` resolves
 * those live from the real underlying data every time a dashboard is
 * read — a stored status here would just be a second, driftable copy
 * of a fact that's already live elsewhere. A row may still exist for a
 * system_generated requirement purely to carry `checklistJson` (row 5's
 * QMS nine-element sub-checklist — a generic, reusable JSON slot rather
 * than a bespoke child table, since no other row needs one) or a human
 * override note. No row at all means "never touched" — degrades to
 * `missing` for a mandatory `person_uploads` requirement, exactly like
 * a case with no `CaseDistributorMapping` degrades to "unmatched."
 */
model AuditRequirementRecord {
  id                 String                     @id @db.Uuid
  companyId          String                     @map("company_id") @db.Uuid
  company            Company                    @relation(fields: [companyId], references: [id])
  definitionId       String                     @map("definition_id") @db.Uuid
  definition         AuditRequirementDefinition @relation(fields: [definitionId], references: [id])
  status             AuditRequirementStatus     @default(missing)
  evidenceDocumentId String?                    @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document?                  @relation(fields: [evidenceDocumentId], references: [id])
  checklistJson      Json?                      @map("checklist_json")
  note               String?
  lastVerifiedAt     DateTime?                  @map("last_verified_at") @db.Timestamptz(3)
  nextDueAt          DateTime?                  @map("next_due_at") @db.Timestamptz(3)
  updatedBy          String?                    @map("updated_by") @db.Uuid
  updater            User?                      @relation("audit_requirement_record_updated_by", fields: [updatedBy], references: [id])
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, definitionId])
  @@map("audit_requirement_record")
}

/**
 * "Generate audit pack" (Final doc: supports no-notice audits and
 * signal-based spot-checks — generatable on demand with zero prep
 * time) — a dated, indexed cover-sheet PDF (all 15 requirements' live
 * status + a reference to each row's current evidence document),
 * archived exactly like `RegulatorySubmission`/`ReconciliationReport`:
 * each generation is a new, permanent row, never updated or
 * overwritten. Deliberately **not** a bytes-bundling zip of every
 * referenced file — the cover sheet links to each evidence document's
 * own existing presigned-download endpoint instead, matching this
 * repo's established "generate a PDF, store it through the normal
 * Documents pipeline" precedent (Stage 12) rather than introducing a
 * new archive-format dependency for a marginal convenience.
 */
model AuditPack {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id])
  snapshot      Json
  pdfDocumentId String   @map("pdf_document_id") @db.Uuid
  pdfDocument   Document @relation(fields: [pdfDocumentId], references: [id])
  generatedBy   String?  @map("generated_by") @db.Uuid
  generator     User?    @relation("audit_pack_generated_by", fields: [generatedBy], references: [id])
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  @@index([companyId, generatedAt])
  @@map("audit_pack")
}

enum InternalAuditStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum AuditFindingSeverity {
  critical
  major
  minor
  observation
}

enum AuditFindingStatus {
  open
  capa_assigned
  closed
}

enum CapaStatus {
  open
  in_progress
  pending_effectiveness_check
  closed
}

enum CapaEffectivenessResult {
  effective
  not_effective
}

/**
 * VigiCloud Stage 16.3 — a plain, direct-status-transition service
 * backs this (`InternalAuditService`/`AuditFindingService`/
 * `CapaService`), not a `WorkflowService` instance — matching the
 * precedent of `TriageService`/`ExpectednessService`/`ValidityGateService`
 * (small, purpose-built services for a specific, well-understood state
 * machine) rather than seeding a new generic workflow definition for a
 * flow this specific.
 */
model InternalAudit {
  id                String              @id @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  company           Company             @relation(fields: [companyId], references: [id])
  title             String
  scope             String?
  /**
   * QualCloud (Phase 13) Stage 9 — `internal | supplier | regulatory`,
   * a plain string added to this already-generic model rather than
   * three separate tables, since Plan → Conduct → Findings → Respond →
   * Close is genuinely the same shape regardless of who's being
   * audited or who's doing the auditing (`todo-qualcloud.md`'s own
   * Stage 9 framing). `regulatory` is the one case where the auditor
   * is PPB/another authority inspecting *us* — see
   * `RegulatoryInspectionResponse` for that half's own "prepare, host,
   * respond" child model.
   */
  auditScope        String              @default("internal") @map("audit_scope")
  scheduledDate     DateTime            @map("scheduled_date") @db.Date
  status            InternalAuditStatus @default(scheduled)
  leadAuditorUserId String?             @map("lead_auditor_user_id") @db.Uuid
  leadAuditor       User?               @relation("internal_audit_lead_auditor", fields: [leadAuditorUserId], references: [id])
  /**
   * QualCloud (Phase 13) Stage 9 — set only for a `supplier`-scope
   * audit; the actual supplier being audited/qualified. Nullable for
   * `internal`/`regulatory` scope, where there is no supplier.
   */
  supplierId        String?             @map("supplier_id") @db.Uuid
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  createdBy         String?             @map("created_by") @db.Uuid
  creator           User?               @relation("internal_audit_created_by", fields: [createdBy], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  findings            AuditFinding[]
  checklistResponses  InternalAuditChecklistResponse[]
  regulatoryResponses RegulatoryInspectionResponse[]

  @@index([companyId, scheduledDate])
  @@map("internal_audit")
}

/**
 * QualCloud (Phase 13) Stage 9 — the real "map each PPB/East African GMP
 * Compendium item to a QualCloud record" requirement, structured exactly
 * like VigiCloud Stage 16.2's own `AuditRequirementDefinition` (per
 * authority, platform-admin-editable, `unverified: true` until a real
 * guideline citation replaces the seeded structural placeholder) rather
 * than a new pattern — the same class of problem, the same proven fix.
 * `mappedRecordType` is a resolver key (see `InspectionReadinessService`'s
 * own `SYSTEM_RESOLVERS` map), never a literal table name.
 */
model InspectionChecklistTemplate {
  id                 String              @id @db.Uuid
  authorityId        String              @map("authority_id") @db.Uuid
  authority          RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  sectionKey         String              @map("section_key")
  title              String
  description        String?
  mappedRecordType   String?             @map("mapped_record_type")
  guidelineReference String?             @map("guideline_reference")
  unverified         Boolean             @default(true)
  sortOrder          Int                 @default(0) @map("sort_order")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  responses InternalAuditChecklistResponse[]

  @@unique([authorityId, sectionKey])
  @@map("inspection_checklist_template")
}

/**
 * QualCloud (Phase 13) Stage 9 — the conduct-mode checklist: one row per
 * `(audit, checklistTemplate)` pair, created when an audit enters
 * Conduct — "check off each real inspection item live against the
 * template, attach observations" (`todo-qualcloud.md`'s own FE bullet).
 */
model InternalAuditChecklistResponse {
  id                  String                      @id @db.Uuid
  companyId           String                      @map("company_id") @db.Uuid
  company             Company                     @relation(fields: [companyId], references: [id])
  auditId             String                      @map("audit_id") @db.Uuid
  audit               InternalAudit               @relation(fields: [auditId], references: [id])
  checklistTemplateId String                      @map("checklist_template_id") @db.Uuid
  checklistTemplate   InspectionChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  status              String                      @default("not_reviewed")
  observations        String?
  reviewedBy          String?                     @map("reviewed_by") @db.Uuid
  reviewer            User?                       @relation("checklist_response_reviewed_by", fields: [reviewedBy], references: [id])
  reviewedAt          DateTime?                   @map("reviewed_at") @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([auditId, checklistTemplateId])
  @@map("internal_audit_checklist_response")
}

/**
 * QualCloud (Phase 13) Stage 9 — the *regulatory*-scope half's own
 * "prepare, host, respond" shape (the Discovery Reference doc's own
 * naming): PPB (or another authority) raises a finding during a real
 * inspection of us, and this is the company's own tracked response to
 * it, with its own deadline and evidence pack — genuinely different
 * from an internal/supplier audit, where there's no external deadline
 * to respond to at all.
 */
model RegulatoryInspectionResponse {
  id                 String        @id @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  company            Company       @relation(fields: [companyId], references: [id])
  auditId            String        @map("audit_id") @db.Uuid
  audit              InternalAudit @relation(fields: [auditId], references: [id])
  findingId          String?       @map("finding_id") @db.Uuid
  finding            AuditFinding? @relation(fields: [findingId], references: [id])
  responseDueDate    DateTime?     @map("response_due_date") @db.Date
  responseText       String?       @map("response_text")
  evidenceDocumentId String?       @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document?     @relation("regulatory_inspection_response_evidence", fields: [evidenceDocumentId], references: [id])
  submittedAt        DateTime?     @map("submitted_at") @db.Timestamptz(3)
  submittedBy        String?       @map("submitted_by") @db.Uuid
  submitter          User?         @relation("regulatory_inspection_response_submitted_by", fields: [submittedBy], references: [id])
  createdBy          String?       @map("created_by") @db.Uuid
  creator            User?         @relation("regulatory_inspection_response_created_by", fields: [createdBy], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, auditId])
  @@map("regulatory_inspection_response")
}

/**
 * QualCloud (Phase 13) Stage 8 — "3 or more of the same root-cause
 * category within a rolling 6 months" (admin-editable via
 * `Company.qualityTrendThresholdCount`/`qualityTrendWindowDays`, both
 * nullable — null means the coded default). One row per
 * `(companyId, rootCauseCategory)`, upserted in place while the trend
 * stays live — matching this schema's own established
 * "upsert-on-natural-key, never delete-then-recreate" discipline
 * (`RegulatoryAuthority`'s own seed block, `ReportingRule`'s
 * post-incident fix) — rather than one new row per scan.
 */
model QualityTrendFlag {
  id                String    @id @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  company           Company   @relation(fields: [companyId], references: [id])
  rootCauseCategory String    @map("root_cause_category")
  occurrenceCount   Int       @map("occurrence_count")
  capaIds           String[]  @map("capa_ids")
  windowStart       DateTime  @map("window_start") @db.Timestamptz(3)
  windowEnd         DateTime  @map("window_end") @db.Timestamptz(3)
  status            String    @default("open")
  acknowledgedBy    String?   @map("acknowledged_by") @db.Uuid
  acknowledger      User?     @relation("quality_trend_flag_acknowledged_by", fields: [acknowledgedBy], references: [id])
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, rootCauseCategory])
  @@map("quality_trend_flag")
}

/**
 * QualCloud (Phase 13) Stage 8 — ICH Q10's own management-review PQS
 * element. `metricsSnapshot`/`recurringIssueFlagsSnapshot` are real JSON
 * snapshots frozen *at the moment of review*, never recomputed later —
 * ALCOA+'s "contemporaneous" principle would otherwise be silently
 * violated by a review whose own numbers could drift after the fact.
 */
model ManagementReview {
  id                          String    @id @db.Uuid
  companyId                   String    @map("company_id") @db.Uuid
  company                     Company   @relation(fields: [companyId], references: [id])
  period                      String
  reviewDate                  DateTime  @map("review_date") @db.Date
  attendees                   String?
  metricsSnapshot             Json      @map("metrics_snapshot")
  recurringIssueFlagsSnapshot Json?     @map("recurring_issue_flags_snapshot")
  actionsAgreed               Json?     @map("actions_agreed")
  nextReviewDueAt             DateTime? @map("next_review_due_at") @db.Timestamptz(3)
  createdBy                   String?   @map("created_by") @db.Uuid
  creator                     User?     @relation("management_review_created_by", fields: [createdBy], references: [id])
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, reviewDate])
  @@map("management_review")
}

/**
 * QualCloud (Phase 13) Stage 9 — "the single most valuable screen in the
 * platform" (Build Priority doc), Tier 1: one-click, on-demand evidence
 * pack. Mirrors VigiCloud Stage 16.2's own `AuditPack` model exactly —
 * a dedicated small artifact-record model (`snapshot` + one PDF
 * document), not the generic `GeneratedReport` catalog, which the same
 * real precedent (confirmed by direct code read rather than
 * paraphrased from planning text) never uses for this class of
 * generated pack either.
 */
model InspectionReadinessPack {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id])
  snapshot      Json
  pdfDocumentId String   @map("pdf_document_id") @db.Uuid
  pdfDocument   Document @relation(fields: [pdfDocumentId], references: [id])
  generatedBy   String?  @map("generated_by") @db.Uuid
  generator     User?    @relation("inspection_readiness_pack_generated_by", fields: [generatedBy], references: [id])
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  @@index([companyId, generatedAt])
  @@map("inspection_readiness_pack")
}

model AuditFinding {
  id          String               @id @db.Uuid
  companyId   String               @map("company_id") @db.Uuid
  company     Company              @relation(fields: [companyId], references: [id])
  auditId     String               @map("audit_id") @db.Uuid
  audit       InternalAudit        @relation(fields: [auditId], references: [id])
  description String
  severity    AuditFindingSeverity
  status      AuditFindingStatus   @default(open)
  createdBy   String?              @map("created_by") @db.Uuid
  creator     User?                @relation("audit_finding_created_by", fields: [createdBy], references: [id])
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  capas                         Capa[]
  regulatoryInspectionResponses RegulatoryInspectionResponse[]

  @@index([companyId, auditId])
  @@map("audit_finding")
}

/**
 * "A CAPA isn't closeable until its effectiveness is separately
 * confirmed, not just marked done" (this stage's own build-spec text)
 * — enforced in `CapaService.close()`, not the schema (matches this
 * repo's "constrained by application logic" precedent elsewhere): a
 * 409 if `effectivenessCheckResult` is still null. `findingId` is
 * nullable — a CAPA can be raised standalone (e.g. from a contact-test
 * failure or a reconciliation gap) as well as from a formal
 * internal-audit finding.
 */
model Capa {
  id                         String                   @id @db.Uuid
  companyId                  String                   @map("company_id") @db.Uuid
  company                    Company                  @relation(fields: [companyId], references: [id])
  findingId                  String?                  @map("finding_id") @db.Uuid
  finding                    AuditFinding?            @relation(fields: [findingId], references: [id])
  /**
   * QualCloud (Phase 13) Stage 0 — `todo-qualcloud.md` Reconciliation
   * Note 4: this is the generalization that resolves the exact open
   * question `findingId`'s own doc comment (below, kept for backward
   * compatibility, never dropped) used to name. Every CAPA's real
   * origin — an audit finding, a deviation, an OOS/OOT result, a
   * complaint, a change-control assessment, a recall investigation, a
   * PQR action, a supplier-audit finding — is captured here,
   * polymorphically, matching `Deadline.recordType`/`recordId`'s own
   * already-proven shape in this exact codebase. `findingId` is simply
   * the special case where `sourceRecordType = 'audit_finding'` (every
   * pre-existing row backfilled this way in the migration that added
   * these two columns) — no FK here, deliberately, since the source
   * table varies by type.
   */
  sourceRecordType           String?                  @map("source_record_type")
  sourceRecordId             String?                  @map("source_record_id") @db.Uuid
  title                      String
  /**
   * QualCloud (Phase 13) Stage 3 — three distinct, commonly-conflated
   * GMP concepts, each its own field rather than one free-text blob:
   * `correction` is the immediate fix ("discard the affected units"),
   * `correctiveAction` (below, pre-existing) fixes *this* occurrence's
   * root cause, `preventiveAction` (below) prevents recurrence across
   * the wider system. Nullable — a CAPA opened before the immediate
   * containment step is fully known can still be created.
   */
  correction                 String?                  @map("correction")
  correctiveAction           String                   @map("corrective_action")
  preventiveAction           String?                  @map("preventive_action")
  /**
   * QualCloud (Phase 13) Stage 3 — free text, not a foreign key (a
   * CAPA's source spans several unrelated tables via `sourceRecordType`/
   * `sourceRecordId`, so there's no single "root cause" table to point
   * at). Drives the reopen-on-recurrence check (`recordEffectivenessCheck`
   * area of `CapaService`): a new quality event linking back to a CAPA
   * closed `effective` within the last 12 months, sharing this same
   * text, gets flagged as a possible recurring issue — a human decides,
   * never auto-reopened.
   */
  rootCauseCategory          String?                  @map("root_cause_category")
  ownerUserId                String?                  @map("owner_user_id") @db.Uuid
  owner                      User?                    @relation("capa_owner", fields: [ownerUserId], references: [id])
  dueDate                    DateTime?                @map("due_date") @db.Date
  status                     CapaStatus               @default(open)
  /**
   * QualCloud (Phase 13) Stage 3 — `implement()` marks the CAPA
   * `in_progress` and stamps this; distinct from `approve()`, which is
   * the cross-functional sign-off *before* implementation begins.
   */
  implementedAt              DateTime?                @map("implemented_at") @db.Timestamptz(3)
  approvedBy                 String?                  @map("approved_by") @db.Uuid
  approver                   User?                    @relation("capa_approved_by", fields: [approvedBy], references: [id])
  approvedAt                 DateTime?                @map("approved_at") @db.Timestamptz(3)
  /**
   * QualCloud (Phase 13) Stage 3 — "QA plus, where the action touches a
   * regulated filing, a Reg-side approver too" (the Build Priority doc's
   * own named cross-module join). `requiresRegulatoryApproval` is set
   * explicitly by whoever approves the CAPA on the QA side (never
   * inferred) — `close()` additionally requires
   * `regulatoryApprovedAt` once this flag is true.
   */
  requiresRegulatoryApproval Boolean                  @default(false) @map("requires_regulatory_approval")
  regulatoryApprovedBy       String?                  @map("regulatory_approved_by") @db.Uuid
  regulatoryApprover         User?                    @relation("capa_regulatory_approved_by", fields: [regulatoryApprovedBy], references: [id])
  regulatoryApprovedAt       DateTime?                @map("regulatory_approved_at") @db.Timestamptz(3)
  /**
   * QualCloud (Phase 13) Stage 3 — set by the reopen-on-recurrence check
   * (never auto-reopened, a human decides what to do about it); the
   * literal "recurring-issue flags" the flowchart names as direct input
   * to Stage 8's own trend detection.
   */
  flaggedRecurring           Boolean                  @default(false) @map("flagged_recurring")
  recurringFlagReason        String?                  @map("recurring_flag_reason")
  effectivenessCheckDueAt    DateTime?                @map("effectiveness_check_due_at") @db.Timestamptz(3)
  effectivenessCheckedAt     DateTime?                @map("effectiveness_checked_at") @db.Timestamptz(3)
  effectivenessCheckedBy     String?                  @map("effectiveness_checked_by") @db.Uuid
  effectivenessChecker       User?                    @relation("capa_effectiveness_checked_by", fields: [effectivenessCheckedBy], references: [id])
  effectivenessCheckResult   CapaEffectivenessResult? @map("effectiveness_check_result")
  effectivenessCheckNote     String?                  @map("effectiveness_check_note")
  closedAt                   DateTime?                @map("closed_at") @db.Timestamptz(3)
  createdBy                  String?                  @map("created_by") @db.Uuid
  creator                    User?                    @relation("capa_created_by", fields: [createdBy], references: [id])
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  /**
   * RegCloud (Phase 12) Stage 14's own forward-reference, now resolved
   * (QualCloud Phase 13 Stage 0) — this is the unified CAPA the recall's
   * own root-cause investigation opens via `sourceRecordType:
   * 'recall_investigation'` above, the same generalized model every
   * other quality event uses.
   */
  recalls Recall[]

  riskAssessments RiskAssessment[]
  /**
   * QualCloud (Phase 13) Stage 5/6 — a complaint or OOS whose own investigation opened this CAPA directly (`quality.close_capa`'s "not every complaint needs a CAPA" — this stays nullable-linked from the complaint/OOS side, not the other way, matching `Deviation`'s own precedent).
   */
  complaints      Complaint[]
  oosRecords      Oos[]

  @@index([companyId, status])
  @@index([companyId, sourceRecordType, sourceRecordId])
  @@map("capa")
}

enum QppvNominationRole {
  primary
  backup
}

enum QppvNominationStatus {
  active
  superseded
}

/**
 * VigiCloud Stage 16.4 — an append-only historical record of each QPPV
 * nomination event (never delete/update in place — a new nomination
 * supersedes the old one, matching this repo's "never delete"
 * convention everywhere else). `Company.primaryQppvUserId`/
 * `backupQppvUserId` are the live current-state pointers this table's
 * own `active` rows are kept in sync with by `QppvNominationService`
 * (application logic, not a DB trigger). A backup QPPV is legally
 * mandatory, not optional, per GUD/006 §3 (see this project's own
 * domain-knowledge notes from the Indoco QPPV discovery interview) —
 * `QppvNominationService` validates both slots hold a real user with
 * the `QPPV` role key, but **cannot** technically enforce GUD/006's own
 * "must also reside in Kenya" requirement: `User` has no
 * residency/country field anywhere in this schema today, and adding
 * one is out of this stage's own scope — flagged here rather than
 * silently unenforced.
 */
model QppvNomination {
  id                              String               @id @db.Uuid
  companyId                       String               @map("company_id") @db.Uuid
  company                         Company              @relation(fields: [companyId], references: [id])
  qppvUserId                      String               @map("qppv_user_id") @db.Uuid
  qppvUser                        User                 @relation("qppv_nomination_user", fields: [qppvUserId], references: [id])
  role                            QppvNominationRole
  status                          QppvNominationStatus @default(active)
  nominationLetterDocumentId      String?              @map("nomination_letter_document_id") @db.Uuid
  nominationLetterDocument        Document?            @relation("qppv_nomination_letter", fields: [nominationLetterDocumentId], references: [id])
  regulatorConfirmationDocumentId String?              @map("regulator_confirmation_document_id") @db.Uuid
  regulatorConfirmationDocument   Document?            @relation("qppv_nomination_confirmation", fields: [regulatorConfirmationDocumentId], references: [id])
  nominatedAt                     DateTime             @default(now()) @map("nominated_at") @db.Timestamptz(3)
  supersededAt                    DateTime?            @map("superseded_at") @db.Timestamptz(3)
  createdBy                       String?              @map("created_by") @db.Uuid
  creator                         User?                @relation("qppv_nomination_created_by", fields: [createdBy], references: [id])

  @@index([companyId, role, status])
  @@map("qppv_nomination")
}

enum SdeaStatus {
  draft
  active
  expired
  superseded
}

/**
 * VigiCloud Stage 16.5 — Safety Data Exchange Agreement repository, per
 * the Final doc: "renewal reminders (2–3 years)" and "an
 * expiring/expired SDEA flags the linked reconciliation relationship
 * (Stage 15.1) as at-risk." `distributorId` is exactly the FK
 * `Distributor`'s own Stage 15 doc comment anticipated — see that
 * model's doc comment for the full forward-dependency reasoning.
 * Version-on-write per distributor (never UPDATE a signed agreement in
 * place — a renewal is a new row, `status: active`, the prior row
 * moves to `superseded`), matching `ReportingRule`'s own precedent, but
 * without a DB-level partial unique index (unlike the fully regulatory
 * config tables) since "one active SDEA per distributor" isn't a
 * safety-critical invariant the same way a reporting deadline rule is
 * — `SdeaService` enforces it in application logic.
 */
model Sdea {
  id               String      @id @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  company          Company     @relation(fields: [companyId], references: [id])
  distributorId    String      @map("distributor_id") @db.Uuid
  distributor      Distributor @relation(fields: [distributorId], references: [id])
  title            String
  counterpartyName String      @map("counterparty_name")
  templateUsed     String?     @map("template_used")
  version          Int         @default(1)
  status           SdeaStatus  @default(draft)
  documentId       String?     @map("document_id") @db.Uuid
  document         Document?   @relation(fields: [documentId], references: [id])
  /**
   * Real-usage request, 22 Sep 2026 (item 5) — "check date the document
   * was received versus date it was uploaded versus date it has to be
   * renewed." Three genuinely distinct dates: this one is when the
   * signed agreement was actually received from the distributor (a
   * real-world event, often days/weeks before anyone gets around to
   * uploading it); `Document`'s own upload timestamp is "date
   * uploaded" (already tracked, just not surfaced prominently here
   * before this pass); `expiryDate` below is "date it has to be
   * renewed." `effectiveDate` is a fourth, separate legal concept —
   * when the agreement's terms start applying — deliberately left
   * alone.
   */
  receivedDate     DateTime?   @map("received_date") @db.Date
  effectiveDate    DateTime?   @map("effective_date") @db.Date
  expiryDate       DateTime?   @map("expiry_date") @db.Date
  createdBy        String?     @map("created_by") @db.Uuid
  creator          User?       @relation("sdea_created_by", fields: [createdBy], references: [id])
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, distributorId, status])
  @@map("sdea")
}

/**
 * Real-usage request, 22 Sep 2026 (item 6) — "SDEA has reconciliation
 * and training — proof distributors are actually trained annually;
 * should essentially be a record checklist." A distributor-scoped
 * analog of `TrainingRecord` (which is per-*staff-member*, not per
 * distributor) — one row per training event a distributor's own staff
 * completed (e.g. annual pharmacovigilance/reporting-obligations
 * training under the SDEA), with an optional certificate upload as the
 * real evidence. `computedStatus` (valid/expiring/expired/missing) is
 * derived live, never stored, matching `TrainingRecord`'s own
 * established precedent exactly (see `DistributorTrainingService`'s
 * own `computeDistributorTrainingStatus()`).
 */
model DistributorTrainingRecord {
  id                    String      @id @db.Uuid
  companyId             String      @map("company_id") @db.Uuid
  company               Company     @relation(fields: [companyId], references: [id])
  distributorId         String      @map("distributor_id") @db.Uuid
  distributor           Distributor @relation(fields: [distributorId], references: [id])
  trainingType          String      @map("training_type")
  title                 String
  completionDate        DateTime    @map("completion_date") @db.Date
  expiryDate            DateTime?   @map("expiry_date") @db.Date
  certificateDocumentId String?     @map("certificate_document_id") @db.Uuid
  certificateDocument   Document?   @relation(fields: [certificateDocumentId], references: [id])
  createdBy             String?     @map("created_by") @db.Uuid
  creator               User?       @relation("distributor_training_record_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, distributorId])
  @@map("distributor_training_record")
}

/**
 * VigiCloud Stage 16.6 — `status` (valid/expiring/expired) is
 * deliberately not a stored column: it's cheaply derivable from
 * `expiryDate` at read time (`TrainingRecordService`'s own resolver),
 * and a stored copy would just be a second, driftable fact — the same
 * reasoning `AuditRequirementRecord`'s own doc comment gives for
 * system_generated rows.
 */
model TrainingRecord {
  id                    String    @id @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  company               Company   @relation(fields: [companyId], references: [id])
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation("training_record_user", fields: [userId], references: [id])
  trainingType          String    @map("training_type")
  title                 String
  completionDate        DateTime  @map("completion_date") @db.Date
  expiryDate            DateTime? @map("expiry_date") @db.Date
  certificateDocumentId String?   @map("certificate_document_id") @db.Uuid
  certificateDocument   Document? @relation(fields: [certificateDocumentId], references: [id])
  createdBy             String?   @map("created_by") @db.Uuid
  creator               User?     @relation("training_record_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  competencyAssessments CompetencyAssessment[]

  @@index([companyId, userId])
  @@map("training_record")
}

/**
 * QualCloud (Phase 13) Stage 12 — "which training type is mandatory for
 * which role, and how often must it be refreshed." `roleKey` is a plain
 * string against this platform's real 8-key tenant role taxonomy
 * (`SYSTEM_ADMINISTRATOR`/`DISPENSING_PHARMACIST`/...), not a FK — a
 * role is a key on an enum-backed column elsewhere in this schema
 * (`User.roleKeys`), never its own row, so there is nothing to point at
 * — matching `AuditRequirementDefinition.mappedRecordType`'s own
 * "plain string key against a known catalog" precedent.
 * `TrainingComplianceService.getComplianceStatus()` cross-references a
 * user's live `roleKeys` against this table's own rows, computed live
 * at read time — never cached/stored (this schema's own established
 * "status is cheaply derivable, don't store a driftable copy of it"
 * discipline, see `TrainingRecord`'s own doc comment).
 */
model RoleTrainingCurriculum {
  id                            String                   @id @db.Uuid
  companyId                     String                   @map("company_id") @db.Uuid
  company                       Company                  @relation(fields: [companyId], references: [id])
  roleKey                       String                   @map("role_key")
  trainingTypeId                String                   @map("training_type_id") @db.Uuid
  trainingType                  TrainingTypeCatalogEntry @relation(fields: [trainingTypeId], references: [id])
  isMandatory                   Boolean                  @default(true) @map("is_mandatory")
  recertificationIntervalMonths Int?                     @map("recertification_interval_months")
  /**
   * QualCloud (Phase 13) Stage 12 — the new-SOP-rollout trigger: when a
   * `Sop` of this `documentType` goes `effective`
   * (`QualityWorkflowGuards`' own status-sync), every active user
   * holding `roleKey` gets a real `DocumentAcknowledgment` row
   * auto-created against it. Nullable — most curriculum rows (e.g. "GMP
   * Fundamentals is mandatory annually for Quality Associate") have no
   * document-rollout trigger at all.
   */
  documentTypeTrigger           String?                  @map("document_type_trigger")
  createdBy                     String?                  @map("created_by") @db.Uuid
  creator                       User?                    @relation("role_training_curriculum_created_by", fields: [createdBy], references: [id])
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, roleKey, trainingTypeId])
  @@index([companyId, documentTypeTrigger])
  @@map("role_training_curriculum")
}

/**
 * QualCloud (Phase 13) Stage 12 — a structured competency check on a
 * specific `TrainingRecord` (distinct from merely attending/completing
 * training) — "was this person actually assessed as competent, by
 * what method, by whom."
 */
model CompetencyAssessment {
  id               String         @id @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  company          Company        @relation(fields: [companyId], references: [id])
  trainingRecordId String         @map("training_record_id") @db.Uuid
  trainingRecord   TrainingRecord @relation(fields: [trainingRecordId], references: [id])
  /**
   * `written_test | practical_observation | supervisor_signoff`.
   */
  assessmentMethod String         @map("assessment_method")
  /**
   * `competent | not_yet_competent`.
   */
  result           String
  notes            String?
  assessedBy       String?        @map("assessed_by") @db.Uuid
  assessor         User?          @relation("competency_assessment_assessed_by", fields: [assessedBy], references: [id])
  assessedAt       DateTime       @default(now()) @map("assessed_at") @db.Timestamptz(3)

  @@index([companyId, trainingRecordId])
  @@map("competency_assessment")
}

// ── Phase 12 — RegCloud (Regulatory Affairs Module), Stage 0 Foundation ────
//
// `todo-regcloud.md` (others/) is the master build spec this section
// implements — Stage 0.1 (Country Rule-Set Graph & Truth/Provenance Layer),
// 0.2 (Regulatory Entity & Hierarchy Model), 0.3 (Document Custody & Dossier
// Assembly — `Document`/`DocumentVersion` themselves need no schema change,
// see that model's own `regDossierSlotFor` relation above), and 0.4
// (Renewal & Variation Deadline Engine). Same architectural discipline
// VigiCloud's own Phase 11 established throughout: version-on-write +
// `unverified`/`sourceReference` provenance for anything regulatory-content-
// shaped (mirrors `ReportingRule` exactly), never delete/always deactivate,
// RLS via `RlsService.runAsCompany` for every tenant-scoped table here.

// ── 0.1 — Country Rule-Set Graph ────────────────────────────────────────

model RegulatoryRequirement {
  id                   String              @id @db.Uuid
  countryId            String              @map("country_id") @db.Uuid
  country              Country             @relation(fields: [countryId], references: [id])
  authorityId          String              @map("authority_id") @db.Uuid
  authority            RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  /**
   * PPB's own 7 named product classes (per `SafeMeds_RegCloud_Workflow_Flowchart.pdf`'s
   * "Discovery Reference" section) — a plain string, not a Postgres enum,
   * matching `ReportType.typeKey`'s own "a future authority may configure
   * a different taxonomy without a migration" reasoning exactly.
   */
  productClass         String              @map("product_class")
  /**
   * Route of administration filter. `"*"` is a deliberate sentinel for
   * "applies regardless of route" — not `null` — for the same reason
   * `Entitlement.featureKey` uses `"*"` instead of a nullable column (see
   * that model's own doc comment): Postgres treats every `NULL` in a
   * unique index as distinct, which would silently defeat the partial
   * unique-active-version index below.
   */
  route                String              @default("*")
  /**
   * Nominal regulator review timeline in calendar days, if a real number
   * exists yet — nullable/absent is honest ("not yet known"), never a
   * guessed figure.
   */
  standardTimelineDays Int?                @map("standard_timeline_days")
  description          String?
  /**
   * True until confirmed against Robert's own Workflow Review Checklist
   * (still blank as of this build — see `todo-regcloud.md`'s own warning
   * box) or a primary-source PPB guideline read directly. Defaults `true`
   * — the safe default — matching `ReportingRule.unverified`'s own
   * "requires a deliberate, explicit uncheck" Admin Console UX.
   */
  unverified           Boolean             @default(true)
  /**
   * Plain-text citation (e.g. "GUD/022 §6.1", or a named field-expert
   * confirmation) — descriptive metadata only, never read by resolution
   * logic, exactly matching `ReportingRule.sourceReference`'s own
   * treatment.
   */
  sourceReference      String?             @map("source_reference")
  version              Int                 @default(1)
  status               ConfigStatus        @default(draft)
  effectiveFrom        DateTime            @map("effective_from") @db.Date
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  documentDefinitions RequiredDocumentDefinition[]
  regDossiers         RegDossier[]

  @@index([countryId, authorityId, productClass, route, status])
  @@map("regulatory_requirement")
}

/**
 * Admin Configurability checklist item 4 — a real, admin-editable
 * pick-list for the `productClass` free-text field used throughout
 * `RegulatoryRequirement`/`RegulatoryFeeSchedule`/`RegDeadlineRule`/
 * `RegDossier`/`RelianceApplication`/`ProductRegistration`. Deliberately
 * NOT a Postgres enum and NOT a foreign key from any of those tables —
 * `productClass` stays free-text everywhere it already is (Stage 0.1's
 * own deliberate decision, so a market with an unconfigured taxonomy is
 * never blocked from typing a class name), this is purely a curated
 * *suggestion* list a picker UI reads, mirroring `TrainingTypeCatalogEntry`'s
 * exact plain-CRUD shape (no version-on-write — a class *name* isn't a
 * legally-binding regulatory fact the way a fee amount or a deadline is;
 * the requirement/fee/deadline rows keyed against it still carry their
 * own `unverified`/version-on-write discipline independently).
 * `authorityId` nullable exactly like `TrainingTypeCatalogEntry.countryId`
 * — null means "generic, offered under any authority" (none seeded this
 * way; every seeded row is PPB-specific, since only PPB's taxonomy is
 * actually sourced).
 */
model ProductClassDefinition {
  id              String               @id @db.Uuid
  authorityId     String?              @map("authority_id") @db.Uuid
  authority       RegulatoryAuthority? @relation(fields: [authorityId], references: [id])
  /**
   * Stable machine key, e.g. `medicines`, `vaccines_and_biologicals` — what a picker's own value actually stores into the free-text `productClass` field.
   */
  classKey        String               @map("class_key")
  label           String
  description     String?
  sourceReference String?              @map("source_reference")
  sortOrder       Int                  @default(0) @map("sort_order")
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_class_definition")
}

model RequiredDocumentDefinition {
  id                      String                @id @db.Uuid
  regulatoryRequirementId String                @map("regulatory_requirement_id") @db.Uuid
  regulatoryRequirement   RegulatoryRequirement @relation(fields: [regulatoryRequirementId], references: [id])
  /**
   * A stable, machine-readable key (e.g. `cpp`, `gmp_certificate`,
   * `ctd_module_3_quality`) — what `RegDossierDocumentSlot` rows actually
   * key off, `name` is just the human-readable label shown in the UI.
   */
  documentKey             String                @map("document_key")
  name                    String
  /**
   * eCTD module this document belongs under ("Module 1", "Module 3", ...),
   * per the discovery transcript's confirmation that Kenya dossiers are
   * eCTD-structured. Nullable — not every required document maps cleanly
   * onto a CTD module (e.g. a cover letter).
   */
  ctdModule               String?               @map("ctd_module")
  isMandatory             Boolean               @default(true) @map("is_mandatory")
  sourceReference         String?               @map("source_reference")
  sortOrder               Int                   @default(0) @map("sort_order")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  dossierSlots RegDossierDocumentSlot[]

  @@index([regulatoryRequirementId])
  @@map("required_document_definition")
}

model RegulatoryFeeSchedule {
  id              String              @id @db.Uuid
  countryId       String              @map("country_id") @db.Uuid
  country         Country             @relation(fields: [countryId], references: [id])
  authorityId     String              @map("authority_id") @db.Uuid
  authority       RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  productClass    String              @map("product_class")
  route           String              @default("*")
  /**
   * `application` | `variation` | `renewal` | `annual` — plain string,
   * matching `ReportingRule.seriousnessClass`'s own "future value without
   * a migration" precedent.
   */
  feeType         String              @map("fee_type")
  /**
   * No real fee amounts are sourced anywhere in `regcloud docs/` yet — see
   * `todo-regcloud.md`'s own Open Questions list. Every row starts
   * `unverified: true`; a `Decimal` column exists now so the admin console
   * and the Fees Ledger (Stage 0.5) have somewhere real to write the
   * number the moment it's confirmed, rather than retrofitting the type
   * later.
   */
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("KES")
  unverified      Boolean             @default(true)
  sourceReference String?             @map("source_reference")
  version         Int                 @default(1)
  status          ConfigStatus        @default(draft)
  effectiveFrom   DateTime            @map("effective_from") @db.Date
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  regFeeInvoices RegFeeInvoice[]

  @@index([countryId, authorityId, productClass, route, feeType, status])
  @@map("regulatory_fee_schedule")
}

// ── 0.2 — Regulatory Entity & Hierarchy Model ───────────────────────────

model Manufacturer {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  countryId String?  @map("country_id") @db.Uuid
  country   Country? @relation(fields: [countryId], references: [id])
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sites            ManufacturingSite[]
  qualitySuppliers Supplier[]

  @@index([companyId])
  @@map("manufacturer")
}

model ManufacturingSite {
  id                      String       @id @db.Uuid
  manufacturerId          String       @map("manufacturer_id") @db.Uuid
  manufacturer            Manufacturer @relation(fields: [manufacturerId], references: [id])
  /**
   * Denormalized from `manufacturer.companyId` — same "avoid a two-hop
   * join just to RLS-scope a query" reasoning used elsewhere in this
   * schema wherever a child table is always queried directly by tenant.
   */
  companyId               String       @map("company_id") @db.Uuid
  company                 Company      @relation(fields: [companyId], references: [id])
  siteName                String       @map("site_name")
  countryId               String?      @map("country_id") @db.Uuid
  country                 Country?     @relation(fields: [countryId], references: [id])
  address                 String?
  gmpCertificateNumber    String?      @map("gmp_certificate_number")
  gmpCertificateExpiresOn DateTime?    @map("gmp_certificate_expires_on") @db.Date
  isActive                Boolean      @default(true) @map("is_active")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations ProductRegistration[]
  /**
   * QualCloud (Phase 13) Stage 7 — batches manufactured at this site.
   */
  batches       Batch[]

  @@index([companyId])
  @@index([manufacturerId])
  @@map("manufacturing_site")
}

model LocalRepresentative {
  id           String   @id @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  countryId    String?  @map("country_id") @db.Uuid
  country      Country? @relation(fields: [countryId], references: [id])
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  address      String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations ProductRegistration[]

  @@index([companyId])
  @@map("local_representative")
}

// ── 0.3 — Document Custody & Dossier Assembly ───────────────────────────

model RegDossier {
  id                             String                 @id @db.Uuid
  companyId                      String                 @map("company_id") @db.Uuid
  company                        Company                @relation(fields: [companyId], references: [id])
  productId                      String                 @map("product_id") @db.Uuid
  product                        Product                @relation(fields: [productId], references: [id])
  authorityId                    String                 @map("authority_id") @db.Uuid
  authority                      RegulatoryAuthority    @relation(fields: [authorityId], references: [id])
  productClass                   String                 @map("product_class")
  route                          String                 @default("*")
  /**
   * The resolved graph row this dossier's checklist was generated from
   * (Stage 1's `ClassificationService.classify()`) — nullable because a
   * dossier can exist (and its slots be manually managed) even before a
   * matching `RegulatoryRequirement` is configured for this
   * country/authority/class, per the graceful-degradation rule
   * `RuleResolutionService`-equivalents in this codebase always follow.
   */
  regulatoryRequirementId        String?                @map("regulatory_requirement_id") @db.Uuid
  regulatoryRequirement          RegulatoryRequirement? @relation(fields: [regulatoryRequirementId], references: [id])
  /**
   * Set once this dossier results in (or amends) a real registration —
   * null while still in compilation, per Stage 6's own "on approval, link
   * back" plan. One registration can have several dossiers linked to it
   * over its lifetime (initial + each variation/renewal) — see
   * `ProductRegistration`'s own doc comment on this same relationship.
   */
  productRegistrationId          String?                @map("product_registration_id") @db.Uuid
  productRegistration            ProductRegistration?   @relation(fields: [productRegistrationId], references: [id])
  /**
   * RegCloud (Phase 12) Stage 12 — set when this dossier *is* a Clinical
   * Trial Application (a CTA is structurally a dossier-and-submission
   * cycle too — protocol, IB, ethics approval, IMP import documentation
   * — so it flows through the exact same Stages 2–6 mechanics as any
   * other dossier, never a parallel trial-specific workflow). Mirrors
   * `Case.clinicalTrialId`'s own nullable precedent from VigiCloud Stage
   * 14 exactly. Exposed directly on `CreateRegDossierDto` (unlike
   * `productRegistrationId`, there's no invariant to protect here — any
   * tenant user creating a dossier against their own company's trial is
   * legitimate).
   */
  clinicalTrialId                String?                @map("clinical_trial_id") @db.Uuid
  clinicalTrial                  ClinicalTrial?         @relation(fields: [clinicalTrialId], references: [id])
  /**
   * RegCloud (Phase 12) Stage 16 — set when this dossier is one of the
   * (lead or relying-market) submissions grouped under a single
   * `RelianceApplication`. Mirrors `clinicalTrialId`'s exact nullable
   * precedent — a reliance-pathway dossier flows through the identical
   * Stages 1–9 mechanics as any other, never a parallel workflow; the
   * `RelianceApplication` row is just the grouping wrapper.
   */
  relianceApplicationId          String?                @map("reliance_application_id") @db.Uuid
  relianceApplication            RelianceApplication?   @relation(fields: [relianceApplicationId], references: [id])
  /**
   * RegCloud (Phase 12) Stage 15 — per-dossier override of the company's
   * own `Company.engagementType` default (e.g. a company that's
   * `full_service` overall but has one particular registration under a
   * `dossier_review_only` arrangement with an external consultant).
   * Null means "use the company default" — resolved live by
   * `EngagementModelService.resolveEffective()`, never denormalized
   * onto this row at create time, so a later company-level default
   * change is reflected immediately for every dossier that hasn't set
   * its own override.
   */
  engagementType                 String?                @map("engagement_type")
  /**
   * testing-correction-explanation.md §2.4 — collected before signing, on
   * the same approval form as `registrationNumber`. Required (by the
   * `requireApprovalData` guard, not a DB constraint — a document upload
   * is inherently create-then-reference, so the guard is the only place
   * that can honestly enforce "must exist") for a fresh registration
   * approval only; a variation/renewal approval needs none of these
   * three (the payment/invoice pair was already collected at Variation
   * Application, per `RegVariation`'s own fields below).
   */
  approvalPaymentProofDocumentId String?                @map("approval_payment_proof_document_id") @db.Uuid
  approvalPaymentProofDocument   Document?              @relation("reg_dossier_approval_payment_proof", fields: [approvalPaymentProofDocumentId], references: [id])
  approvalInvoiceDocumentId      String?                @map("approval_invoice_document_id") @db.Uuid
  approvalInvoiceDocument        Document?              @relation("reg_dossier_approval_invoice", fields: [approvalInvoiceDocumentId], references: [id])
  /**
   * The actual proof the approval succeeded (PPB's own approval letter/
   * certificate, or the equivalent for a variation/renewal) — required
   * for every approval, registration or not, distinct from
   * `RegSubmission.evidenceDocumentId` (proof the application was
   * *dispatched*) and from the payment pair above (proof the fee was
   * *paid*).
   */
  approvalEvidenceDocumentId     String?                @map("approval_evidence_document_id") @db.Uuid
  approvalEvidenceDocument       Document?              @relation("reg_dossier_approval_evidence", fields: [approvalEvidenceDocumentId], references: [id])
  /**
   * Plain string, not an enum — the real workflow states (Stage 3's
   * Completeness & Format Check, Stage 4's Submit, Stage 5's Query &
   * Assessment) aren't seeded as a `WorkflowDefinition` yet; this column
   * exists so Stage 0.3's own CRUD has somewhere honest to record
   * progress in the meantime, matching `RegDossier`'s own build-spec
   * note that the full compilation *workflow* is Stage 2/3's job, not
   * this foundation stage's.
   */
  status                         String                 @default("compiling")
  version                        Int                    @default(1)
  /**
   * Nullable for the same reason `Document.createdBy` is — a dossier
   * created by a non-`full_service` engagement model (Stage 15) may not
   * always have a logged-in SafeMeds-side actor behind it.
   */
  createdBy                      String?                @map("created_by") @db.Uuid
  creator                        User?                  @relation(fields: [createdBy], references: [id])
  createdAt                      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  documentSlots  RegDossierDocumentSlot[]
  regFeeInvoices RegFeeInvoice[]
  regSubmissions RegSubmission[]
  regQueries     RegQuery[]
  /**
   * RegCloud (Phase 12) Stage 7 — set only when this dossier's own purpose is a variation/renewal of an existing registration, never for a brand-new one (see `RegVariation`'s own doc comment for the full reasoning).
   */
  regVariation   RegVariation?

  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, clinicalTrialId])
  @@index([companyId, relianceApplicationId])
  @@map("reg_dossier")
}

model RegDossierDocumentSlot {
  id                           String                      @id @db.Uuid
  regDossierId                 String                      @map("reg_dossier_id") @db.Uuid
  regDossier                   RegDossier                  @relation(fields: [regDossierId], references: [id])
  /**
   * Nullable — a slot can also exist for an ad-hoc document the checklist
   * didn't anticipate (`labelOverride` carries its name in that case),
   * matching this schema's general preference for a graceful, non-blocking
   * shape over a rigid one.
   */
  requiredDocumentDefinitionId String?                     @map("required_document_definition_id") @db.Uuid
  requiredDocumentDefinition   RequiredDocumentDefinition? @relation(fields: [requiredDocumentDefinitionId], references: [id])
  labelOverride                String?                     @map("label_override")
  /**
   * Null until a document is actually attached — `Document`/`DocumentVersion`
   * reused entirely as-is (no new storage mechanism), same
   * `SourceDocument.documentId`-style "a slot points at a specific
   * `Document` row" precedent.
   */
  documentId                   String?                     @map("document_id") @db.Uuid
  document                     Document?                   @relation("reg_dossier_document_slot", fields: [documentId], references: [id])
  ctdModule                    String?                     @map("ctd_module")
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([regDossierId])
  @@map("reg_dossier_document_slot")
}

// ── 0.4 — Renewal & Variation Deadline Engine ───────────────────────────

model RegDeadlineRule {
  id              String              @id @db.Uuid
  countryId       String              @map("country_id") @db.Uuid
  country         Country             @relation(fields: [countryId], references: [id])
  authorityId     String              @map("authority_id") @db.Uuid
  authority       RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  /**
   * `"*"` sentinel (same reasoning as `RegulatoryRequirement.route`) —
   * Kenya's confirmed 5-year renewal cadence applies uniformly across
   * product classes, per the discovery transcript, so most real rows use
   * the sentinel; a future market/class with a genuinely different cadence
   * can still seed a narrower row.
   */
  productClass    String              @default("*") @map("product_class")
  /**
   * `renewal` | `variation_response` | `annual_report` — plain string,
   * same "future value without a migration" precedent as `feeType` above.
   * Only `renewal` has a live consumer wired in this Stage 0.4 pass (see
   * this model's own module doc comment) — the others are structurally
   * ready for Stage 7/8 to start writing `RegDeadline` rows against once
   * those stages build the records (`RegVariation`, post-market
   * obligations) that would trigger them.
   */
  obligationType  String              @map("obligation_type")
  intervalValue   Int                 @map("interval_value")
  /**
   * `days` | `months` | `years` — deliberately NOT collapsed into a single
   * `windowDays`-style day count the way `ReportingRule` does: a 5-year
   * renewal expressed as raw days (1825/1826) drifts across leap years,
   * where `addInterval()`'s real calendar-month/year arithmetic doesn't.
   */
  intervalUnit    String              @map("interval_unit")
  /**
   * What starts the clock — `issued_on` (the registration's own
   * `issuedOn`/`expiresOn`, the only live case this pass wires) today;
   * `previous_obligation_date` is reserved for a recurring obligation
   * whose next due date is relative to its own last one, not the
   * registration's original issue date.
   */
  clockStart      String              @default("issued_on") @map("clock_start")
  unverified      Boolean             @default(true)
  sourceReference String?             @map("source_reference")
  version         Int                 @default(1)
  status          ConfigStatus        @default(draft)
  effectiveFrom   DateTime            @map("effective_from") @db.Date
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  regDeadlines RegDeadline[]

  @@index([countryId, authorityId, productClass, obligationType, status])
  @@map("reg_deadline_rule")
}

model RegDeadline {
  id                String          @id @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  company           Company         @relation(fields: [companyId], references: [id])
  /**
   * Polymorphic, exactly like `Deadline.recordType`/`recordId` — the live
   * consumer this pass wires is `recordType: "reg_registration_renewal"`,
   * `recordId: <ProductRegistration.id>`.
   */
  recordType        String          @map("record_type")
  recordId          String          @map("record_id") @db.Uuid
  regDeadlineRuleId String          @map("reg_deadline_rule_id") @db.Uuid
  regDeadlineRule   RegDeadlineRule @relation(fields: [regDeadlineRuleId], references: [id])
  dueAt             DateTime        @map("due_at") @db.Timestamptz(3)
  status            DeadlineStatus  @default(pending)
  /**
   * Day-scale escalation thresholds, not `Deadline`'s own hour-scale
   * t72/t24 pair — a multi-year renewal window makes a 72-hour warning
   * nearly useless; 180/90/30 calendar days out is the actually useful
   * lead time for a renewal-scale obligation. Each set once, never
   * cleared, matching `Deadline`'s own "never double-notify the same
   * threshold" guarantee exactly.
   */
  notifiedAt180d    DateTime?       @map("notified_at_180d") @db.Timestamptz(3)
  notifiedAt90d     DateTime?       @map("notified_at_90d") @db.Timestamptz(3)
  notifiedAt30d     DateTime?       @map("notified_at_30d") @db.Timestamptz(3)
  breachedAt        DateTime?       @map("breached_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([recordType, recordId])
  @@index([companyId, status, dueAt])
  @@map("reg_deadline")
}

// ── 0.5 — Fees Ledger ────────────────────────────────────────────────────
//
// Deliberately not a payment-processing integration — no Stripe/M-Pesa in
// scope (the Build Priority doc's own silence on this) — a ledger and
// reminder mechanism only, matching this project's own established "log
// it, don't automate the money movement" discipline (Contact Testing,
// Literature Monitoring — human-driven logs, not automated pipelines).

model RegFeeInvoice {
  id                      String                 @id @db.Uuid
  companyId               String                 @map("company_id") @db.Uuid
  company                 Company                @relation(fields: [companyId], references: [id])
  /**
   * Both nullable and independent — an invoice can reference the
   * registration it's for, the dossier attempt that generated it, both,
   * or (a manually-logged fee with no linked record yet) neither.
   */
  productRegistrationId   String?                @map("product_registration_id") @db.Uuid
  productRegistration     ProductRegistration?   @relation(fields: [productRegistrationId], references: [id])
  regDossierId            String?                @map("reg_dossier_id") @db.Uuid
  regDossier              RegDossier?            @relation(fields: [regDossierId], references: [id])
  /**
   * Set only when auto-created from an active `RegulatoryFeeSchedule`
   * resolution (see `MasterDataService`'s own registration-creation
   * wiring) — null for a manually-logged invoice with no matching
   * schedule yet, which is still allowed (a real fee a tenant was charged
   * that just hasn't been configured in the graph yet).
   */
  regulatoryFeeScheduleId String?                @map("regulatory_fee_schedule_id") @db.Uuid
  regulatoryFeeSchedule   RegulatoryFeeSchedule? @relation(fields: [regulatoryFeeScheduleId], references: [id])
  /**
   * `application` | `variation` | `renewal` | `annual` — plain string,
   * matching `RegulatoryFeeSchedule.feeType`'s own precedent.
   */
  feeType                 String                 @map("fee_type")
  amount                  Decimal                @db.Decimal(12, 2)
  currency                String                 @default("KES")
  /**
   * `pending` | `paid` | `overdue` | `waived` — plain string, matching
   * every other lifecycle-status field in this schema that isn't a
   * Postgres enum (e.g. `RegDossier.status`). `paid` is only ever reached
   * once the sum of this invoice's own `RegFeePayment` rows meets or
   * exceeds `amount` — a partial payment stays `pending`/`overdue`,
   * genuinely logged, never silently treated as settled.
   */
  status                  String                 @default("pending")
  dueAt                   DateTime               @map("due_at") @db.Timestamptz(3)
  description             String?
  /**
   * Set once, never cleared, the moment the daily sweep first flags this
   * invoice overdue — the same "never double-notify" guarantee
   * `RegDeadline`'s own 180/90/30-day columns already establish, just a
   * single threshold (an invoice has one due date, not a multi-year
   * runway that benefits from staged early warnings).
   */
  notifiedOverdueAt       DateTime?              @map("notified_overdue_at") @db.Timestamptz(3)
  createdBy               String?                @map("created_by") @db.Uuid
  creator                 User?                  @relation("reg_fee_invoice_created_by", fields: [createdBy], references: [id])
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments RegFeePayment[]

  @@index([companyId])
  @@index([companyId, status, dueAt])
  @@map("reg_fee_invoice")
}

model RegFeePayment {
  id         String        @id @db.Uuid
  invoiceId  String        @map("invoice_id") @db.Uuid
  invoice    RegFeeInvoice @relation(fields: [invoiceId], references: [id])
  /**
   * Denormalized from `invoice.companyId` — same "avoid a two-hop join
   * just to RLS-scope a query" reasoning `ManufacturingSite.companyId`
   * already established for this schema.
   */
  companyId  String        @map("company_id") @db.Uuid
  company    Company       @relation(fields: [companyId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  paidAt     DateTime      @map("paid_at") @db.Timestamptz(3)
  method     String?
  reference  String?
  recordedBy String?       @map("recorded_by") @db.Uuid
  recorder   User?         @relation("reg_fee_payment_recorded_by", fields: [recordedBy], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([invoiceId])
  @@map("reg_fee_payment")
}

// ── Stage 4 — Submit ─────────────────────────────────────────────────────

model RegSubmission {
  id                   String              @id @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  company              Company             @relation(fields: [companyId], references: [id])
  regDossierId         String              @map("reg_dossier_id") @db.Uuid
  regDossier           RegDossier          @relation(fields: [regDossierId], references: [id])
  /**
   * Denormalized from `regDossier.authorityId` — avoids a two-hop join for the common "list this authority's submissions" read, same reasoning `ManufacturingSite.companyId` already established.
   */
  authorityId          String              @map("authority_id") @db.Uuid
  authority            RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  /**
   * One per generation attempt (initial + every resubmission) — archived, never overwritten, matching `RegulatorySubmission.submissionNumber`'s own precedent exactly.
   */
  submissionNumber     Int                 @map("submission_number")
  /**
   * Snapshotted from the resolved `SubmissionFormat.channel` at
   * generation time (see "What Already Exists" — `reg_dossier`'s own
   * `ReportType` row). Defaults to `paper_pdf` when nothing resolves —
   * unlike VigiCloud's E2B flow, RegCloud's cover-sheet-and-documents
   * package isn't format-specific to one channel, so an unconfigured
   * authority never blocks generation, it just falls back to the
   * universally-safe assumption (a human can always print and courier
   * something).
   */
  channel              SubmissionChannel
  coverSheetDocumentId String              @map("cover_sheet_document_id") @db.Uuid
  coverSheetDocument   Document            @relation("reg_submission_cover_sheet", fields: [coverSheetDocumentId], references: [id])
  generatedBy          String              @map("generated_by") @db.Uuid
  generatedByUser      User                @relation("reg_submission_generated_by", fields: [generatedBy], references: [id])
  generatedAt          DateTime            @map("generated_at") @db.Timestamptz(3)
  /**
   * Null until a human confirms the actual dispatch (courier/portal/email) happened outside this system — the same "No Gateway" honesty VigiCloud's own E2B submission established.
   */
  evidenceDocumentId   String?             @map("evidence_document_id") @db.Uuid
  evidenceDocument     Document?           @relation("reg_submission_evidence", fields: [evidenceDocumentId], references: [id])
  dispatchedAt         DateTime?           @map("dispatched_at") @db.Timestamptz(3)
  dispatchedBy         String?             @map("dispatched_by") @db.Uuid
  dispatchedByUser     User?               @relation("reg_submission_dispatched_by", fields: [dispatchedBy], references: [id])
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([regDossierId, submissionNumber])
  @@index([companyId, regDossierId])
  @@map("reg_submission")
}

// ── Stage 5 — Query & Assessment ────────────────────────────────────────

model RegQuery {
  id                    String                   @id @db.Uuid
  companyId             String                   @map("company_id") @db.Uuid
  company               Company                  @relation(fields: [companyId], references: [id])
  regDossierId          String                   @map("reg_dossier_id") @db.Uuid
  regDossier            RegDossier               @relation(fields: [regDossierId], references: [id])
  receivedDate          DateTime                 @map("received_date") @db.Date
  /**
   * VigiCloud Stage 0.3's own text-encryption convention, applied here since a regulator's query can carry sensitive product/clinical detail — encrypted via `TextEncryptionService`, decrypted only on a real, authenticated read (see the gotchas list on write-only-encrypted-field bugs).
   */
  queryTextEncrypted    String                   @map("query_text_encrypted")
  /**
   * The regulator's own letter, if scanned and uploaded rather than only transcribed.
   */
  queryLetterDocumentId String?                  @map("query_letter_document_id") @db.Uuid
  queryLetterDocument   Document?                @relation("reg_query_letter", fields: [queryLetterDocumentId], references: [id])
  status                String                   @default("open")
  respondedAt           DateTime?                @map("responded_at") @db.Timestamptz(3)
  /**
   * testing-correction-explanation.md §2.1 — the real date the response
   * was sent to the regulator, distinct from `respondedAt` (the system
   * timestamp of when this row was logged) — mirrors `receivedDate`'s own
   * "real regulatory date, not a system clock" precedent. Nullable for
   * the same reason every new field on a table with real accumulated
   * rows is (6 real `reg_query` rows exist already, 4 already closed with
   * no such date on file) — required going forward via
   * `RegQueryController.respond()`'s own DTO, never a DB constraint.
   */
  respondedDate         DateTime?                @map("responded_date") @db.Date
  responseDocumentId    String?                  @map("response_document_id") @db.Uuid
  responseDocument      Document?                @relation("reg_query_response", fields: [responseDocumentId], references: [id])
  /**
   * RegCloud (Phase 12) Stage 15 — set instead of (never alongside)
   * `responseDocumentId` when this dossier's effective engagement type
   * is `client_handles_queries` and the client answered the regulator
   * directly without sharing the actual correspondence back to SafeMeds.
   * Encrypted via the same `TextEncryptionService` convention as
   * `queryTextEncrypted` — a description of how the query was resolved
   * can carry the same sensitive product/clinical detail.
   */
  responseNoteEncrypted String?                  @map("response_note_encrypted")
  respondedBy           String?                  @map("responded_by") @db.Uuid
  responder             User?                    @relation("reg_query_responded_by", fields: [respondedBy], references: [id])
  /**
   * CEO feedback, 30 Sep 2026 (real-usage query-register review) — "the
   * quote describes health-authority query management as a dedicated
   * query register with response due dates, ownership, escalation and
   * correspondence tracking." Manually entered for now — the regulator
   * states its own deadline in the query letter, and there is no
   * confirmed per-country query-response timeline yet (see
   * `RegDeadlineService.computeOrRecompute()`'s own
   * `obligationType: 'query_response'` call in `receive()`, already
   * wired and gracefully null until Robert confirms one). Once a real
   * rule exists, `computeOrRecompute()`'s result can populate this same
   * field automatically without any shape change — this stays a plain
   * date either way, never a second parallel deadline concept.
   */
  responseDueDate       DateTime?                @map("response_due_date") @db.Date
  /**
   * Named ownership, reassignable — the CEO's own "assign each query to
   * a named person, with the option to reassign" ask. Nullable: an
   * unowned query still exists and is still visible in the register
   * (falls back to notifying every `regulatory.manage_dossier` holder),
   * matching this schema's general "ownership narrows visibility, never
   * gates it" precedent (`Case.draftClaimedBy`'s own same shape).
   */
  ownerUserId           String?                  @map("owner_user_id") @db.Uuid
  owner                 User?                    @relation("reg_query_owner", fields: [ownerUserId], references: [id])
  /**
   * A formal closure step, distinct from `respond()`'s own `responded`
   * status — the CEO's register lists "responded" and "closed" as two
   * separate states (a query can be answered, then still sit open for a
   * regulator confirmation or a further round, before someone formally
   * files it away). Nullable/independent of `respondedAt` on purpose.
   */
  closedAt              DateTime?                @map("closed_at") @db.Timestamptz(3)
  closedBy              String?                  @map("closed_by") @db.Uuid
  closer                User?                    @relation("reg_query_closed_by", fields: [closedBy], references: [id])
  correspondence        RegQueryCorrespondence[]
  createdBy             String?                  @map("created_by") @db.Uuid
  creator               User?                    @relation("reg_query_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, regDossierId])
  @@index([companyId, status])
  @@map("reg_query")
}

/**
 * CEO feedback, 30 Sep 2026 — "every letter, email and document
 * exchanged on a query kept in one thread, with dates, including
 * follow-up questions and multiple response rounds." A genuine child
 * table rather than squeezing more columns onto `RegQuery` itself,
 * since a query's original letter and its (at most one, until now)
 * response were always exactly two slots — a real multi-round thread
 * needs an unbounded, ordered list. `RegQuery`'s own
 * `queryLetterDocumentId`/`responseDocumentId`/`responseNoteEncrypted`
 * columns are left exactly as they are (nothing to migrate, no existing
 * row touched) — the *first* letter and the *first formal* response
 * stay denormalized there for the guards/workflow mechanics that already
 * read them, while this table is the complete, ordered record of
 * everything, including those same two entries (mirrored in here too by
 * both `receive()` and `respond()`, so the thread is always genuinely
 * complete, never missing its own bookends).
 */
model RegQueryCorrespondence {
  id               String    @id @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  company          Company   @relation(fields: [companyId], references: [id])
  regQueryId       String    @map("reg_query_id") @db.Uuid
  regQuery         RegQuery  @relation(fields: [regQueryId], references: [id])
  /**
   * `from_regulator` | `to_regulator` | `internal_note` — a note never leaves the system, so it carries no document expectation either way.
   */
  direction        String
  /**
   * `letter` | `email` | `phone` | `portal` | `note` — how this specific item arrived/was sent, distinct from `direction` (which way).
   */
  channel          String
  /**
   * The real date this letter/email/call happened — never defaults to today, matching `RegQuery.receivedDate`'s own "real regulatory date" precedent.
   */
  occurredOn       DateTime  @map("occurred_on") @db.Date
  /**
   * Encrypted via the same `TextEncryptionService` convention as `RegQuery.queryTextEncrypted` — a thread entry can carry the same sensitive product/clinical detail.
   */
  summaryEncrypted String    @map("summary_encrypted")
  documentId       String?   @map("document_id") @db.Uuid
  document         Document? @relation("reg_query_correspondence_document", fields: [documentId], references: [id])
  createdBy        String?   @map("created_by") @db.Uuid
  creator          User?     @relation("reg_query_correspondence_created_by", fields: [createdBy], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, regQueryId])
  @@map("reg_query_correspondence")
}

// ── Stage 7 — Lifecycle: Variations & Renewals ──────────────────────────

/**
 * A variation (content change) or a renewal — folded into one model with
 * `variationType: 'renewal'` as a first-class value, per the todo's own
 * offered resolution, rather than a second parallel `RegRenewal` table.
 * Deliberately reuses the **entire** Stage 1–6 dossier/submission/query
 * machinery rather than a special-cased branch: `regDossierId` points at
 * a real `RegDossier` created the exact same way an initial registration's
 * dossier is (`RegDossierService.create()`, now accepting an optional
 * `productRegistrationId`), which runs through the identical
 * `reg_registration` workflow (planning → … → approved/rejected). The
 * only behavioral fork lives in `RegWorkflowGuards`' own status-sync
 * function: a dossier whose `productRegistrationId` was already set
 * *before* compilation began (i.e. it's wrapped by a `RegVariation`, not
 * a fresh registration) updates the *existing* `ProductRegistration` on
 * approval instead of creating a new one.
 */
/**
 * testing-correction-explanation.md §2.2 — Kenya's own real variation-
 * classification categories, confirmed as of this pass (`minor`/`major`/
 * `immediate_notification`/`yearly_notification`), plus `renewal` —
 * folded into this same model since Stage 7's own "renewal is just
 * `variationType: 'renewal'`" design already anticipated exactly this
 * migration from free text to a real, closed set once the categories
 * were confirmed. Every existing row's value (`'renewal'`, the only one
 * ever written before this pass) is a valid member, so the migration is
 * a safe in-place type change, not a backfill.
 */
enum RegVariationType {
  minor
  major
  immediate_notification
  yearly_notification
  renewal
}

model RegVariation {
  id                     String              @id @db.Uuid
  companyId              String              @map("company_id") @db.Uuid
  company                Company             @relation(fields: [companyId], references: [id])
  productRegistrationId  String              @map("product_registration_id") @db.Uuid
  productRegistration    ProductRegistration @relation(fields: [productRegistrationId], references: [id])
  variationType          RegVariationType    @map("variation_type")
  /**
   * A short, memorable, per-company-sequential reference shown to users
   * instead of the raw UUID `id` — `VAR-00001-<registration number>` for
   * every type except `renewal`, which uses `REN-00001-<registration
   * number>` instead (still the same table/row shape; only the prefix
   * differs, matching the user's own two distinct ID schemes for what is
   * structurally one mechanism). Generated once, at creation, from a
   * running per-company count — never renumbered.
   */
  displayCode            String              @map("display_code")
  regDossierId           String              @unique @map("reg_dossier_id") @db.Uuid
  regDossier             RegDossier          @relation(fields: [regDossierId], references: [id])
  /**
   * testing-correction-explanation.md §2.2 — the two documents required
   * before a non-renewal variation can leave its own `variation_application`
   * state (the third requirement, one-or-more "accompanying change"
   * documents, is deliberately NOT a fixed field — it's any `Document`
   * uploaded against `recordType: 'reg_variation'`/this row's own `id`,
   * checked by count in `RegWorkflowGuards`, since "one or more" doesn't
   * fit a single FK). A renewal (`variationType: 'renewal'`) never
   * populates either — its own dossier starts at `renewal_requested`,
   * not `variation_application`, and reuses the existing Stage 4
   * evidence-on-submission gate instead.
   */
  paymentProofDocumentId String?             @map("payment_proof_document_id") @db.Uuid
  paymentProofDocument   Document?           @relation("reg_variation_payment_proof", fields: [paymentProofDocumentId], references: [id])
  invoiceDocumentId      String?             @map("invoice_document_id") @db.Uuid
  invoiceDocument        Document?           @relation("reg_variation_invoice", fields: [invoiceDocumentId], references: [id])
  /**
   * Mirrors the dossier's own live workflow state — `open` while compiling/submitted/querying, `approved`/`rejected` once the dossier's workflow reaches its own terminal state. Kept in sync by the same status-sync function that updates `RegDossier.status`, not a second independent write path.
   */
  status                 String              @default("open")
  submittedAt            DateTime?           @map("submitted_at") @db.Timestamptz(3)
  approvedAt             DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdBy              String?             @map("created_by") @db.Uuid
  creator                User?               @relation("reg_variation_created_by", fields: [createdBy], references: [id])
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  /**
   * QualCloud (Phase 13) Stage 4 — the (at most one) Change Control that opened this variation via `ChangeControlService.openLinkedVariation()`.
   */
  originatingChangeControl ChangeControl?

  @@unique([companyId, displayCode])
  @@index([companyId, productRegistrationId])
  @@map("reg_variation")
}

/**
 * testing-correction-explanation.md §3.3 — an annual retention record,
 * deliberately **not** a `RegDossier`: no regulator query/response cycle,
 * no completeness gate, no multi-week review — a plain invoice-and-proof-
 * of-payment transaction that produces a certificate. No workflow-engine
 * instance either, the same reasoning `SafetyAlert` (VigiCloud) already
 * established: one person logging a real transaction, no role-gated
 * multi-actor handoff to model.
 */
model RegRetention {
  id                       String              @id @db.Uuid
  companyId                String              @map("company_id") @db.Uuid
  company                  Company             @relation(fields: [companyId], references: [id])
  productRegistrationId    String              @map("product_registration_id") @db.Uuid
  productRegistration      ProductRegistration @relation(fields: [productRegistrationId], references: [id])
  /**
   * `RET-00001-<registration number>` — the same per-company-sequential display scheme `RegVariation.displayCode` uses.
   */
  displayCode              String              @map("display_code")
  /**
   * The calendar year being retained (e.g. `2026`) — at most one retention per (registration, year), enforced by this model's own `@@unique([productRegistrationId, year])`.
   */
  year                     Int
  invoiceDocumentId        String              @map("invoice_document_id") @db.Uuid
  invoiceDocument          Document            @relation("reg_retention_invoice", fields: [invoiceDocumentId], references: [id])
  proofOfPaymentDocumentId String              @map("proof_of_payment_document_id") @db.Uuid
  proofOfPaymentDocument   Document            @relation("reg_retention_proof_of_payment", fields: [proofOfPaymentDocumentId], references: [id])
  /**
   * Generated once both documents are in — a real one-page PDF (`RegRetentionPdfService`), not a status label alone.
   */
  certificateDocumentId    String?             @map("certificate_document_id") @db.Uuid
  certificateDocument      Document?           @relation("reg_retention_certificate", fields: [certificateDocumentId], references: [id])
  status                   String              @default("pending")
  paidAt                   DateTime            @map("paid_at") @db.Date
  createdBy                String?             @map("created_by") @db.Uuid
  creator                  User?               @relation("reg_retention_created_by", fields: [createdBy], references: [id])
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, displayCode])
  @@unique([productRegistrationId, year])
  @@index([companyId, productRegistrationId])
  @@map("reg_retention")
}

// ── Stage 8 — Post-Market & Obligations ─────────────────────────────────

/**
 * RegCloud (Phase 12) Stage 8 — one row per (registration, obligationType)
 * — a recurring compliance cycle (an annual report, a periodic
 * safety-and-quality update), structurally distinct from `renewal`/
 * `query_response` (Stages 0.4/5), which keep their own dedicated
 * handling since they're driven directly by `RegWorkflowGuards`/
 * `RegQueryService` rather than this generic engine. Tracks its own
 * `dueAt`/`status`/`notifiedOverdueAt` directly (a ledger, mirroring
 * `RegFeeInvoice`'s own precedent) rather than through a linked
 * `RegDeadline` row — see `dueAt`'s own field comment for why. Fulfilling
 * the current cycle immediately rolls this same row forward to the next
 * one (recomputing a fresh `dueAt` from the fulfillment date) rather than
 * creating a new row per cycle — matching `ProductRegistration`/
 * renewal's own "one evolving record" precedent rather than
 * `RegSubmission`'s one-row-per-attempt shape, since an obligation cycle
 * isn't itself an artifact worth archiving on its own — its fulfillment
 * history (below) is.
 */
model RegPostMarketObligation {
  id                    String              @id @db.Uuid
  companyId             String              @map("company_id") @db.Uuid
  company               Company             @relation(fields: [companyId], references: [id])
  productRegistrationId String              @map("product_registration_id") @db.Uuid
  productRegistration   ProductRegistration @relation(fields: [productRegistrationId], references: [id])
  /**
   * Plain string — e.g. `annual_report`, `periodic_safety_update` — matches `RegDeadlineRule.obligationType`'s own natural key exactly; whatever's configured there is what can ever appear here, plus whatever a user manually logs ad hoc (see `RegPostMarketObligationService.create()`).
   */
  obligationType        String              @map("obligation_type")
  /**
   * A direct ledger field, not a linked `RegDeadline` row — deliberately
   * mirroring `RegFeeInvoice.dueAt`'s own precedent rather than
   * `ProductRegistration`'s `RegDeadline`-based renewal tracking.
   * `RegDeadline.regDeadlineRuleId` is a required, non-nullable FK, so a
   * manually-logged obligation with no active `RegDeadlineRule` yet
   * (the exact case a human reaches for this feature to cover) could
   * never get one — `RegPostMarketObligationService` instead reuses
   * `RegDeadlineRule`/`addInterval()` directly as its cadence *source*
   * (when a rule exists) while always keeping this field as the single
   * authoritative due date, computed or explicit either way.
   */
  dueAt                 DateTime            @map("due_at") @db.Timestamptz(3)
  /**
   * `pending | overdue | fulfilled` — `fulfilled` only ever sticks when no active rule exists to compute a next cycle from at the moment of fulfillment (see the service's own doc comment).
   */
  status                String              @default("pending")
  /**
   * Never-re-flag guard, matching `RegFeeInvoice.notifiedOverdueAt`'s own precedent exactly.
   */
  notifiedOverdueAt     DateTime?           @map("notified_overdue_at") @db.Timestamptz(3)
  createdBy             String?             @map("created_by") @db.Uuid
  creator               User?               @relation("reg_post_market_obligation_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  fulfillments RegPostMarketObligationFulfillment[]

  @@unique([productRegistrationId, obligationType])
  @@index([companyId, productRegistrationId])
  @@map("reg_post_market_obligation")
}

/**
 * Append-only fulfillment history — never overwritten, matching
 * `RegFeePayment`'s own precedent for an evolving-parent-record +
 * immutable-history-log shape.
 */
model RegPostMarketObligationFulfillment {
  id                 String                  @id @db.Uuid
  obligationId       String                  @map("obligation_id") @db.Uuid
  obligation         RegPostMarketObligation @relation(fields: [obligationId], references: [id])
  fulfilledAt        DateTime                @map("fulfilled_at") @db.Timestamptz(3)
  fulfilledBy        String?                 @map("fulfilled_by") @db.Uuid
  fulfiller          User?                   @relation("reg_post_market_obligation_fulfilled_by", fields: [fulfilledBy], references: [id])
  /**
   * The tenant's own proof of having actually filed this with the regulator.
   */
  evidenceDocumentId String?                 @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document?               @relation("reg_post_market_obligation_evidence", fields: [evidenceDocumentId], references: [id])
  /**
   * Set only when the tenant used the "Generate Filing Record" convenience action instead of (or alongside) uploading their own evidence — see `RegPostMarketObligationService.generateFilingRecord()`. A real, honest internal record of what was fulfilled and when — never fabricated regulatory content.
   */
  generatedReportId  String?                 @map("generated_report_id") @db.Uuid
  generatedReport    GeneratedReport?        @relation(fields: [generatedReportId], references: [id])
  note               String?
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([obligationId])
  @@map("reg_post_market_obligation_fulfillment")
}

// ── Stage 11 — Import / Export & Permits ────────────────────────────────

/**
 * RegCloud (Phase 12) Stage 11 — Import/Export & Permits. A deliberately
 * lightweight CRUD + deadline-reminder record, NOT a second
 * dossier/workflow-engine build — the build spec's own framing
 * ("thinnest-sourced workflow... needs a deeper Robert conversation
 * before fine-grained requirements are built") means the honest,
 * correct scope today is a real, working record of what permit exists
 * and when it expires, extensible into a full workflow later once real
 * requirements are confirmed — not a guessed-at multi-stage process
 * built ahead of that conversation.
 */
model ImportExportPermit {
  id                    String               @id @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  company               Company              @relation(fields: [companyId], references: [id])
  productId             String               @map("product_id") @db.Uuid
  product               Product              @relation(fields: [productId], references: [id])
  /**
   * Nullable — a permit can be sought before the product is registered at all (e.g. an investigational import), matching `RegDossier.productRegistrationId`'s own nullable-until-linked precedent.
   */
  productRegistrationId String?              @map("product_registration_id") @db.Uuid
  productRegistration   ProductRegistration? @relation(fields: [productRegistrationId], references: [id])
  /**
   * RegCloud (Phase 12) Stage 12 — set when this permit is for a
   * trial's own IMP (Investigational Medicinal Product) import/export
   * rather than a commercial product — the same permit mechanism,
   * reusing `permitType` for the `import`/`export` direction and this
   * link for "which trial," rather than a parallel trial-permit model.
   */
  clinicalTrialId       String?              @map("clinical_trial_id") @db.Uuid
  clinicalTrial         ClinicalTrial?       @relation(fields: [clinicalTrialId], references: [id])
  authorityId           String               @map("authority_id") @db.Uuid
  authority             RegulatoryAuthority  @relation(fields: [authorityId], references: [id])
  /**
   * Plain string — `import | export`.
   */
  permitType            String               @map("permit_type")
  permitNumber          String?              @map("permit_number")
  /**
   * Plain string — `draft | active | expired | revoked`.
   */
  status                String               @default("draft")
  validFrom             DateTime?            @map("valid_from") @db.Date
  /**
   * Authoritative — whatever the regulator's own issued permit states.
   * Scanned directly by `RegLicensingExpiryService`, same "no natural
   * single rule to compute this from, the entity's own field is the
   * real fact" reasoning as `Facility.licenceExpiresOn`/
   * `PersonnelLicence.expiresOn` — kept uniform across all three Stage
   * 10/11 licence-shaped records rather than routing permits through
   * `RegDeadline` just because `authorityId` happens to be unambiguous
   * here (see that service's own doc comment).
   */
  validTo               DateTime?            @map("valid_to") @db.Date
  permitDocumentId      String?              @map("permit_document_id") @db.Uuid
  permitDocument        Document?            @relation("import_export_permit_document", fields: [permitDocumentId], references: [id])
  /**
   * Never-re-flag guard for the 90-day "approaching" reminder — same precedent as `Facility.licenceRenewalNotifiedAt`.
   */
  renewalNotifiedAt     DateTime?            @map("renewal_notified_at") @db.Timestamptz(3)
  createdBy             String?              @map("created_by") @db.Uuid
  creator               User?                @relation("import_export_permit_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, productId])
  @@map("import_export_permit")
}

// ── Stage 13 — Advertising & Promotion ──────────────────────────────────

/**
 * RegCloud (Phase 12) Stage 13 — Advertising & Promotion. A deliberately
 * lighter-weight submission/review record than the master registration
 * lifecycle — no multi-document dossier, no eCTD tagging, and (per
 * `PromotionalMaterialWorkflowGuards`'s own doc comment) no query/
 * response loop, matching the build spec's own "Tier 2/3, least-detailed
 * workflow" framing rather than inventing a second `RegQuery`-shaped
 * model this stage's own sourced material never asked for.
 * `materialDocumentId` points at the actual promotional material itself
 * (the artifact under review), uploaded through the same generic
 * document-upload path every other RegCloud upload uses — never a
 * generated package the way a registration's own submission cover
 * sheet is.
 */
model PromotionalMaterialSubmission {
  id                 String              @id @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  company            Company             @relation(fields: [companyId], references: [id])
  productId          String              @map("product_id") @db.Uuid
  product            Product             @relation(fields: [productId], references: [id])
  authorityId        String              @map("authority_id") @db.Uuid
  authority          RegulatoryAuthority @relation(fields: [authorityId], references: [id])
  /**
   * Plain string — `print | digital | broadcast`.
   */
  materialType       String              @map("material_type")
  materialDocumentId String?             @map("material_document_id") @db.Uuid
  materialDocument   Document?           @relation("promotional_material_document", fields: [materialDocumentId], references: [id])
  /**
   * Kept in sync by `PromotionalMaterialWorkflowGuards`'s own status-sync — matches every other RegCloud workflow-backed record's `status` field precedent (`RegDossier.status`, etc.).
   */
  status             String              @default("draft")
  version            Int                 @default(1)
  createdBy          String?             @map("created_by") @db.Uuid
  creator            User?               @relation("promotional_material_created_by", fields: [createdBy], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, productId])
  @@map("promotional_material_submission")
}

// ── Stage 14 — Post-Market & Recall (cross-module) ──────────────────────

/**
 * RegCloud (Phase 12) Stage 14 — Post-Market & Recall. RegCloud's own
 * honest slice of a genuinely three-module event (per Reconciliation
 * Note 5) — the regulator-facing half lives here; PV's own linked
 * `Case` rows (via `RecallCase` below, mirroring `SignalCase`'s exact
 * shape) and QualCloud's own future root-cause CAPA (`rootCauseCapaId`,
 * left ready — see that field's own doc comment) are plain FK/lookup
 * links, deliberately never a shared workflow instance across modules
 * that don't otherwise share one.
 */
model Recall {
  id                  String    @id @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  company             Company   @relation(fields: [companyId], references: [id])
  productId           String    @map("product_id") @db.Uuid
  product             Product   @relation(fields: [productId], references: [id])
  initiatedBy         String?   @map("initiated_by") @db.Uuid
  initiator           User?     @relation("recall_initiated_by", fields: [initiatedBy], references: [id])
  /**
   * Plain string, deliberately free-text/nullable — a real regulatory
   * classification (Class I/II/III-equivalent) once Kenya's own scheme
   * is sourced (⚠️ unsourced as of this pass, per the build spec's own
   * flag); never guessed at or hardcoded to a fabricated taxonomy.
   */
  recallClass         String?   @map("recall_class")
  reason              String
  /**
   * Kept in sync by `RecallWorkflowGuards`'s own status-sync.
   */
  status              String    @default("reported")
  authorityNotifiedAt DateTime? @map("authority_notified_at") @db.Timestamptz(3)
  /**
   * Resolved (QualCloud Phase 13 Stage 0, `todo-qualcloud.md`
   * Reconciliation Note 4) — this is the same, now-generalized `Capa`
   * every quality event opens against via `Capa.sourceRecordType`/
   * `sourceRecordId`; a recall's own root-cause investigation opens one
   * with `sourceRecordType: 'recall_investigation'`. Never a second,
   * QualCloud-specific CAPA table.
   */
  rootCauseCapaId     String?   @map("root_cause_capa_id") @db.Uuid
  rootCauseCapa       Capa?     @relation(fields: [rootCauseCapaId], references: [id])
  /**
   * QualCloud (Phase 13) Stage 10.0/10.2 — the Engineering Build
   * Package's own "`RecallCase`" aggregate root is this exact model,
   * extended in place, never a new one (see 10.0's own naming
   * reconciliation — the pre-existing `RecallCase` join table below
   * keeps its unrelated name/shape unchanged). `ref` is a real
   * sequential display code — `REC-YYYY-NNNN` for a real recall,
   * `MOCK-YYYY-NNN` for a drill (10.7) — same generator precedent as
   * `RegVariation.displayCode`. `mode` replaces the originally-planned
   * separate `MockRecall` model (Reconciliation Note 11): a mock recall
   * is this exact row with `mode: 'mock'`, running the identical
   * workflow/rules/portal/messaging, filtered out of real dashboards/
   * metrics/regulator submissions by `mode` alone.
   */
  ref                 String?
  mode                String    @default("real")
  type                String?
  level               String?
  reasonCategory      String?   @map("reason_category")
  /**
   * Polymorphic trigger link — `complaint | deviation | capa |
   * adverse_event | regulator | mock` — mirroring `Capa.sourceRecordType`/
   * `sourceRecordId` and `Deadline.recordType`/`recordId`'s own
   * already-twice-proven pattern in this exact codebase.
   */
  triggerSourceType   String?   @map("trigger_source_type")
  triggerSourceId     String?   @map("trigger_source_id") @db.Uuid
  openedAt            DateTime? @map("opened_at") @db.Timestamptz(3)
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  creator             User?     @relation("recall_created_by", fields: [createdBy], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  cases               RecallCase[]
  countries           RecallCountry[]
  scopeVersions       RecallScopeVersion[]
  distributionRecords RecallDistributionRecord[]
  importJobs          RecallImportJob[]
  cascadeInvites      RecallCascadeInvite[]
  sightings           RecallSighting[]
  portalLinks         RecallPortalLink[]
  messages            RecallMessage[]
  quarantineRecords   RecallQuarantineRecord[]
  returnRecords       RecallReturnRecord[]
  discrepancies       RecallDiscrepancy[]

  @@unique([companyId, ref])
  @@index([companyId, productId])
  @@map("recall")
}

/**
 * Mirrors `SignalCase`'s exact shape — a `Recall` can reference the real
 * PV `Case` row(s) that triggered or resulted from it, per this stage's
 * own cross-module integration bullet.
 */
model RecallCase {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  recallId  String   @map("recall_id") @db.Uuid
  recall    Recall   @relation(fields: [recallId], references: [id])
  caseId    String   @map("case_id") @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([recallId, caseId])
  @@index([companyId, caseId])
  @@map("recall_case")
}

// ── QualCloud (Phase 13) Stage 10.1 — Recall Country Rules Engine ──────

/**
 * A fourth instance of the version-on-write/sign-off-gated/source-cited
 * rule-graph pattern this project has now built three times before
 * (`ReportingRule` in VigiCloud, `RegulatoryRequirement` in RegCloud,
 * this one) — a recall obligation is a genuinely distinct rule domain
 * from ADR-reporting or registration-renewal deadlines even though the
 * mechanism is identical. A rule-set only ever drives a real deadline
 * once `live`; until then the product shows "per rule-set," never a
 * fabricated date (the Content Pack's own explicit instruction).
 * Platform-managed, sign-off gated by the `regulatory_lead` platform
 * role — never a tenant permission, matching `ReportingRule`'s own
 * platform-only precedent — so deliberately **no RLS**, same as
 * `InspectionChecklistTemplate`.
 */
model RecallRuleSet {
  id                    String              @id @db.Uuid
  countryId             String              @map("country_id") @db.Uuid
  country               Country             @relation(fields: [countryId], references: [id])
  regulatoryAuthorityId String              @map("regulatory_authority_id") @db.Uuid
  regulatoryAuthority   RegulatoryAuthority @relation(fields: [regulatoryAuthorityId], references: [id])
  version               Int
  status                String              @default("draft")
  signedOffBy           String?             @map("signed_off_by") @db.Uuid
  signedOffByUser       User?               @relation("recall_rule_set_signed_off_by", fields: [signedOffBy], references: [id])
  signedOffAt           DateTime?           @map("signed_off_at") @db.Timestamptz(3)
  effectiveDate         DateTime?           @map("effective_date") @db.Date
  nextReviewAt          DateTime?           @map("next_review_at") @db.Timestamptz(3)
  createdBy             String?             @map("created_by") @db.Uuid
  creator               User?               @relation("recall_rule_set_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  rules               RecallRule[]
  submissionTemplates RecallSubmissionTemplate[]
  countries           RecallCountry[]

  @@unique([countryId, regulatoryAuthorityId, version])
  @@map("recall_rule_set")
}

/**
 * `appliesWhenClass`/`Level`/`Type` are plain nullable columns (never
 * JSON) — a rule can be scoped to a specific class/level/recall type,
 * or apply to all (null = "any"). `dayBasis` defaults to `calendar`
 * per country until confirmed otherwise (10.9 — several countries'
 * day basis is explicitly still unconfirmed; never seed `unverified:
 * false` on a rule whose day basis hasn't been independently checked).
 */
model RecallRule {
  id                   String                    @id @db.Uuid
  ruleSetId            String                    @map("rule_set_id") @db.Uuid
  ruleSet              RecallRuleSet             @relation(fields: [ruleSetId], references: [id])
  code                 String
  requirementText      String                    @map("requirement_text")
  appliesWhenClass     String?                   @map("applies_when_class")
  appliesWhenLevel     String?                   @map("applies_when_level")
  appliesWhenType      String?                   @map("applies_when_type")
  /**
   * e.g. `regulator_approval_of_recall | recall_decision | trigger_received` — plain, company-extensible string.
   */
  anchorEvent          String                    @map("anchor_event")
  offset               Int
  unit                 String                    @default("days")
  dayBasis             String                    @default("calendar") @map("day_basis")
  ownerRoleKey         String                    @map("owner_role_key")
  evidenceTypes        String[]                  @map("evidence_types")
  approvalRequired     Boolean                   @default(false) @map("approval_required")
  blocksClosure        Boolean                   @default(false) @map("blocks_closure")
  submissionTemplateId String?                   @map("submission_template_id") @db.Uuid
  submissionTemplate   RecallSubmissionTemplate? @relation(fields: [submissionTemplateId], references: [id])
  sourceDoc            String                    @map("source_doc")
  sourceInstrument     String?                   @map("source_instrument")
  sourceSection        String?                   @map("source_section")
  sourceUrl            String?                   @map("source_url")
  unverified           Boolean                   @default(true)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  requirements RecallRequirement[]

  @@unique([ruleSetId, code])
  @@map("recall_rule")
}

/**
 * The per-country report/notification templates (Content Pack §4: recall notification, progress report, closure report, disposal request, etc.). Reuses the existing `pdfkit`-based deterministic-template-generation pattern — never LLM-generated regulatory text (10.8).
 */
model RecallSubmissionTemplate {
  id        String        @id @db.Uuid
  ruleSetId String        @map("rule_set_id") @db.Uuid
  ruleSet   RecallRuleSet @relation(fields: [ruleSetId], references: [id])
  code      String
  name      String
  format    String        @default("pdf")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  rules       RecallRule[]
  submissions RecallSubmission[]

  @@unique([ruleSetId, code])
  @@map("recall_submission_template")
}

model RecallSubmission {
  id                       String                   @id @db.Uuid
  companyId                String                   @map("company_id") @db.Uuid
  company                  Company                  @relation(fields: [companyId], references: [id])
  recallCountryId          String                   @map("recall_country_id") @db.Uuid
  recallCountry            RecallCountry            @relation(fields: [recallCountryId], references: [id])
  templateId               String                   @map("template_id") @db.Uuid
  template                 RecallSubmissionTemplate @relation(fields: [templateId], references: [id])
  templateVersion          Int                      @map("template_version")
  documentId               String?                  @map("document_id") @db.Uuid
  document                 Document?                @relation("recall_submission_document", fields: [documentId], references: [id])
  generatedAt              DateTime                 @default(now()) @map("generated_at") @db.Timestamptz(3)
  status                   String                   @default("draft")
  submittedProofDocumentId String?                  @map("submitted_proof_document_id") @db.Uuid
  submittedProofDocument   Document?                @relation("recall_submission_proof", fields: [submittedProofDocumentId], references: [id])
  generatedBy              String?                  @map("generated_by") @db.Uuid
  generator                User?                    @relation("recall_submission_generated_by", fields: [generatedBy], references: [id])
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, recallCountryId])
  @@map("recall_submission")
}

// ── QualCloud (Phase 13) Stage 10.2 — Case Lifecycle, Scope, Risk ───────

/**
 * The Engineering Build Package's own `CaseCountry` — a recall's
 * per-country sub-lifecycle, genuinely new (the parent `Recall.status`
 * is one flat field, not per-country). A plain live status column, not
 * a second `WorkflowInstance` — a full second workflow engine instance
 * per country inside one case is more machinery than this needs, since
 * these statuses are a strict sub-lifecycle of the parent case's own
 * `notification`/`execution`/`reconciliation` states (10.0).
 */
model RecallCountry {
  id                    String               @id @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  company               Company              @relation(fields: [companyId], references: [id])
  recallId              String               @map("recall_id") @db.Uuid
  recall                Recall               @relation(fields: [recallId], references: [id])
  countryId             String               @map("country_id") @db.Uuid
  country               Country              @relation(fields: [countryId], references: [id])
  regulatoryAuthorityId String?              @map("regulatory_authority_id") @db.Uuid
  regulatoryAuthority   RegulatoryAuthority? @relation(fields: [regulatoryAuthorityId], references: [id])
  ruleSetId             String?              @map("rule_set_id") @db.Uuid
  ruleSet               RecallRuleSet?       @relation(fields: [ruleSetId], references: [id])
  ruleSetVersion        Int?                 @map("rule_set_version")
  status                String               @default("pending")
  class                 String?
  level                 String?
  regulatorDecision     String?              @map("regulator_decision")
  regulatorApprovalAt   DateTime?            @map("regulator_approval_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  requirements            RecallRequirement[]
  submissions             RecallSubmission[]
  destructionRecords      RecallDestructionRecord[]
  effectivenessChecks     RecallEffectivenessCheck[]
  reconciliationSnapshots RecallReconciliationSnapshot[]
  discrepancies           RecallDiscrepancy[]

  @@unique([recallId, countryId])
  @@map("recall_country")
}

/**
 * Generated by loading the `RecallCountry`'s live `RecallRuleSet`
 * version and evaluating each rule's `appliesWhen*` against the
 * recall's actual class/level/type, on recall approval and on any
 * scope/country change. `dueAt = anchorEventTimestamp + offset` in the
 * rule's day basis; a missing anchor event yields `status:
 * 'deadline_pending'` plus a real `Task`, never a silent null with no
 * explanation. A case keeps the rule version it started with unless
 * deliberately, audibly migrated — same precedent `ReportingRule`
 * resolution already uses.
 */
model RecallRequirement {
  id              String        @id @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id])
  recallCountryId String        @map("recall_country_id") @db.Uuid
  recallCountry   RecallCountry @relation(fields: [recallCountryId], references: [id])
  recallRuleId    String        @map("recall_rule_id") @db.Uuid
  recallRule      RecallRule    @relation(fields: [recallRuleId], references: [id])
  ruleVersion     Int           @map("rule_version")
  dueAt           DateTime?     @map("due_at") @db.Timestamptz(3)
  ownerRoleKey    String        @map("owner_role_key")
  status          String        @default("open")
  evidenceIds     String[]      @map("evidence_ids")
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([recallCountryId, recallRuleId])
  @@map("recall_requirement")
}

/**
 * An approved scope version is immutable; any later change creates a new version and re-runs 10.1's rules engine, fully audited.
 */
model RecallScopeVersion {
  id         String    @id @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id])
  recallId   String    @map("recall_id") @db.Uuid
  recall     Recall    @relation(fields: [recallId], references: [id])
  version    Int
  status     String    @default("draft")
  approvedBy String?   @map("approved_by") @db.Uuid
  approver   User?     @relation("recall_scope_version_approved_by", fields: [approvedBy], references: [id])
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  reason     String?
  createdBy  String?   @map("created_by") @db.Uuid
  creator    User?     @relation("recall_scope_version_created_by", fields: [createdBy], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  items RecallScopeItem[]

  @@unique([recallId, version])
  @@map("recall_scope_version")
}

/**
 * Reuses `Product`/`Batch` as the source of truth, snapshotting quantities at freeze time rather than duplicating live master data — "the recall never duplicates master data; it references it and snapshots at scope freeze" (Engineering Build Package).
 */
model RecallScopeItem {
  id                  String             @id @db.Uuid
  scopeVersionId      String             @map("scope_version_id") @db.Uuid
  scopeVersion        RecallScopeVersion @relation(fields: [scopeVersionId], references: [id])
  productId           String             @map("product_id") @db.Uuid
  product             Product            @relation(fields: [productId], references: [id])
  batchId             String             @map("batch_id") @db.Uuid
  batch               Batch              @relation(fields: [batchId], references: [id])
  batchSize           Int?               @map("batch_size")
  quantityDistributed Int?               @map("quantity_distributed")
  quantityHeldByMah   Int?               @map("quantity_held_by_mah")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scopeVersionId, batchId])
  @@map("recall_scope_item")
}

// ── QualCloud (Phase 13) Stage 10.3 — Distribution, Cascade, Traceability ─

/**
 * Every organisation in the recall's own distribution tree, at unlimited depth (self-referential `parentId`).
 */
model Stakeholder {
  id              String        @id @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id])
  orgName         String        @map("org_name")
  type            String
  country         String?
  licenceNo       String?       @map("licence_no")
  licenceStatus   String?       @map("licence_status")
  parentId        String?       @map("parent_id") @db.Uuid
  parent          Stakeholder?  @relation("stakeholder_parent", fields: [parentId], references: [id])
  children        Stakeholder[] @relation("stakeholder_parent")
  contactName     String?       @map("contact_name")
  contactPhone    String?       @map("contact_phone")
  contactEmail    String?       @map("contact_email")
  contactWhatsapp String?       @map("contact_whatsapp")
  isActive        Boolean       @default(true) @map("is_active")
  createdBy       String?       @map("created_by") @db.Uuid
  creator         User?         @relation("stakeholder_created_by", fields: [createdBy], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  distributionFrom  RecallDistributionRecord[] @relation("recall_distribution_from_org")
  distributionTo    RecallDistributionRecord[] @relation("recall_distribution_to_org")
  importSourceFor   RecallImportJob[]
  cascadeInvites    RecallCascadeInvite[]
  portalLinks       RecallPortalLink[]
  messages          RecallMessage[]
  quarantineRecords RecallQuarantineRecord[]
  returnRecordsFrom RecallReturnRecord[]       @relation("recall_return_record_from_org")

  @@index([companyId])
  @@map("stakeholder")
}

model RecallDistributionRecord {
  id          String           @id @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  company     Company          @relation(fields: [companyId], references: [id])
  recallId    String           @map("recall_id") @db.Uuid
  recall      Recall           @relation(fields: [recallId], references: [id])
  batchId     String           @map("batch_id") @db.Uuid
  batch       Batch            @relation(fields: [batchId], references: [id])
  fromOrgId   String?          @map("from_org_id") @db.Uuid
  fromOrg     Stakeholder?     @relation("recall_distribution_from_org", fields: [fromOrgId], references: [id])
  toOrgId     String           @map("to_org_id") @db.Uuid
  toOrg       Stakeholder      @relation("recall_distribution_to_org", fields: [toOrgId], references: [id])
  qtyPacks    Int?             @map("qty_packs")
  qtyUnits    Int              @map("qty_units")
  date        DateTime         @db.Date
  source      String
  sourceRef   String?          @map("source_ref")
  importJobId String?          @map("import_job_id") @db.Uuid
  importJob   RecallImportJob? @relation(fields: [importJobId], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, recallId])
  @@map("recall_distribution_record")
}

/**
 * The exact import-template contract the Engineering Build Package's §7 table specifies — valid rows committed while error rows are fixed and re-imported.
 */
model RecallImportJob {
  id          String       @id @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id])
  recallId    String       @map("recall_id") @db.Uuid
  recall      Recall       @relation(fields: [recallId], references: [id])
  documentId  String?      @map("document_id") @db.Uuid
  document    Document?    @relation("recall_import_job_document", fields: [documentId], references: [id])
  sourceOrgId String?      @map("source_org_id") @db.Uuid
  sourceOrg   Stakeholder? @relation(fields: [sourceOrgId], references: [id])
  rows        Int          @default(0)
  validRows   Int          @default(0) @map("valid_rows")
  errorRows   Int          @default(0) @map("error_rows")
  status      String       @default("processing")
  mapping     Json?
  errors      Json?
  createdBy   String?      @map("created_by") @db.Uuid
  creator     User?        @relation("recall_import_job_created_by", fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  distributionRecords RecallDistributionRecord[]

  @@index([companyId, recallId])
  @@map("recall_import_job")
}

/**
 * Every recipient is invited, through the external portal (10.4), to list its own customers; each new customer becomes a `Stakeholder` with `parentId` set — unlimited tree depth.
 */
model RecallCascadeInvite {
  id            String      @id @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id])
  recallId      String      @map("recall_id") @db.Uuid
  recall        Recall      @relation(fields: [recallId], references: [id])
  stakeholderId String      @map("stakeholder_id") @db.Uuid
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id])
  invitedAt     DateTime    @default(now()) @map("invited_at") @db.Timestamptz(3)
  status        String      @default("awaiting")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([recallId, stakeholderId])
  @@map("recall_cascade_invite")
}

/**
 * A batch found in a market where the product is not registered at all — the real, named "Remedica case" scenario. A human decides whether to notify that country's own regulator; if yes, a new `RecallCountry` is added and 10.1's rules engine runs for it, exactly like any other country.
 */
model RecallSighting {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  company            Company   @relation(fields: [companyId], references: [id])
  recallId           String    @map("recall_id") @db.Uuid
  recall             Recall    @relation(fields: [recallId], references: [id])
  country            String
  source             String
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document? @relation("recall_sighting_evidence", fields: [evidenceDocumentId], references: [id])
  reviewed           Boolean   @default(false)
  decision           String?
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  reviewer           User?     @relation("recall_sighting_reviewed_by", fields: [reviewedBy], references: [id])
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  creator            User?     @relation("recall_sighting_created_by", fields: [createdBy], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, recallId])
  @@map("recall_sighting")
}

// ── QualCloud (Phase 13) Stage 10.4 — External Stakeholder Portal ───────

/**
 * No accounts — a token grants access only to that one organisation's
 * own quantities/tasks/messages/evidence, mirroring VigiCloud Stage
 * 3.2's own public-reporting-link security model (hashed, expiring,
 * revocable, scoped) applied to a supply-chain actor instead of an
 * anonymous reporter. `tokenHash` is the only thing ever stored — the
 * real token is never persisted, matching every other hashed single-
 * use/scoped token in this codebase.
 */
model RecallPortalLink {
  id            String      @id @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id])
  recallId      String      @map("recall_id") @db.Uuid
  recall        Recall      @relation(fields: [recallId], references: [id])
  stakeholderId String      @map("stakeholder_id") @db.Uuid
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id])
  tokenHash     String      @unique @map("token_hash")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  revoked       Boolean     @default(false)
  language      String      @default("en")
  createdBy     String?     @map("created_by") @db.Uuid
  creator       User?       @relation("recall_portal_link_created_by", fields: [createdBy], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  actions RecallPortalAction[]

  @@map("recall_portal_link")
}

/**
 * `idempotencyKey` makes a queued-then-synced offline action safe to resubmit.
 */
model RecallPortalAction {
  id              String           @id @db.Uuid
  linkId          String           @map("link_id") @db.Uuid
  link            RecallPortalLink @relation(fields: [linkId], references: [id])
  action          String
  payload         Json?
  clientTimestamp DateTime?        @map("client_timestamp") @db.Timestamptz(3)
  serverTimestamp DateTime         @default(now()) @map("server_timestamp") @db.Timestamptz(3)
  idempotencyKey  String           @map("idempotency_key")

  @@unique([linkId, idempotencyKey])
  @@map("recall_portal_action")
}

/**
 * Encrypted via the same `TextEncryptionService` convention as every
 * other operational message log in this codebase carrying real product/
 * batch detail — the same reasoning `RegQueryCorrespondence` already
 * established. WhatsApp/SMS channels are honestly `not_configured`
 * until real vendor credentials exist (mirroring VigiCloud Stage
 * 3.3/3.4's own already-established "not configured yet" state) —
 * email is real and live via `NotificationsService.sendExternalEmail()`.
 */
model RecallMessage {
  id            String      @id @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id])
  recallId      String      @map("recall_id") @db.Uuid
  recall        Recall      @relation(fields: [recallId], references: [id])
  stakeholderId String      @map("stakeholder_id") @db.Uuid
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id])
  channel       String
  templateId    String?     @map("template_id")
  bodyEncrypted String      @map("body_encrypted")
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(3)
  deliveredAt   DateTime?   @map("delivered_at") @db.Timestamptz(3)
  readAt        DateTime?   @map("read_at") @db.Timestamptz(3)
  status        String      @default("queued")
  providerRef   String?     @map("provider_ref")
  isDrill       Boolean     @default(false) @map("is_drill")
  createdBy     String?     @map("created_by") @db.Uuid
  creator       User?       @relation("recall_message_created_by", fields: [createdBy], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, recallId])
  @@map("recall_message")
}

// ── QualCloud (Phase 13) Stage 10.5 — Returns, Quarantine, Reconciliation ─

model RecallQuarantineRecord {
  id                  String       @id @db.Uuid
  companyId           String       @map("company_id") @db.Uuid
  company             Company      @relation(fields: [companyId], references: [id])
  recallId            String       @map("recall_id") @db.Uuid
  recall              Recall       @relation(fields: [recallId], references: [id])
  stakeholderId       String?      @map("stakeholder_id") @db.Uuid
  stakeholder         Stakeholder? @relation(fields: [stakeholderId], references: [id])
  batchId             String       @map("batch_id") @db.Uuid
  batch               Batch        @relation(fields: [batchId], references: [id])
  fullPacks           Int          @default(0) @map("full_packs")
  /**
   * `[{unitsRemaining, unitsPerPack}]` — real part-pack counting, not whole-packs-only.
   */
  partPacks           Json?        @map("part_packs")
  evidenceDocumentIds String[]     @map("evidence_document_ids")
  recordedBy          String?      @map("recorded_by") @db.Uuid
  recorder            User?        @relation("recall_quarantine_record_recorded_by", fields: [recordedBy], references: [id])
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, recallId])
  @@map("recall_quarantine_record")
}

/**
 * Only a `genuine` verdict ever counts as recovered stock — a `suspect`
 * verdict holds the return rather than silently crediting it. No FK to
 * a falsified-product-report table (that's a future stage, not yet
 * built) — `verdictNote` carries the reasoning honestly until one
 * exists.
 */
model RecallReturnRecord {
  id                 String       @id @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  company            Company      @relation(fields: [companyId], references: [id])
  recallId           String       @map("recall_id") @db.Uuid
  recall             Recall       @relation(fields: [recallId], references: [id])
  ref                String
  fromOrgId          String?      @map("from_org_id") @db.Uuid
  fromOrg            Stakeholder? @relation("recall_return_record_from_org", fields: [fromOrgId], references: [id])
  batchScannedGtin   String?      @map("batch_scanned_gtin")
  batchScannedLot    String?      @map("batch_scanned_lot")
  batchScannedExpiry DateTime?    @map("batch_scanned_expiry") @db.Date
  batchScannedSerial String?      @map("batch_scanned_serial")
  batchId            String?      @map("batch_id") @db.Uuid
  batch              Batch?       @relation(fields: [batchId], references: [id])
  qty                Int
  verdict            String?
  verdictNote        String?      @map("verdict_note")
  creditStatus       String       @default("pending") @map("credit_status")
  verifiedBy         String?      @map("verified_by") @db.Uuid
  verifier           User?        @relation("recall_return_record_verified_by", fields: [verifiedBy], references: [id])
  verifiedAt         DateTime?    @map("verified_at") @db.Timestamptz(3)
  createdBy          String?      @map("created_by") @db.Uuid
  creator            User?        @relation("recall_return_record_created_by", fields: [createdBy], references: [id])
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, ref])
  @@index([companyId, recallId])
  @@map("recall_return_record")
}

/**
 * Computed live from real formulas (`RecallReconciliationService
 * .calculate()`), never a manually-editable number — one new archived
 * row per calculation, matching `ManagementReview.metricsSnapshot`'s own
 * "point-in-time record, never overwritten" precedent, rather than one
 * row updated in place.
 */
model RecallReconciliationSnapshot {
  id              String        @id @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id])
  recallCountryId String        @map("recall_country_id") @db.Uuid
  recallCountry   RecallCountry @relation(fields: [recallCountryId], references: [id])
  distributed     Int
  recovered       Int
  quarantined     Int
  dispensed       Int
  other           Int
  accounted       Int
  outstanding     Int
  destroyed       Int
  heldByMah       Int           @map("held_by_mah")
  calculatedAt    DateTime      @default(now()) @map("calculated_at") @db.Timestamptz(3)

  @@index([companyId, recallCountryId])
  @@map("recall_reconciliation_snapshot")
}

/**
 * A blocking discrepancy (outstanding ≠ 0 with no approved exception) is a real, named closure blocker, not a soft warning.
 */
model RecallDiscrepancy {
  id                    String         @id @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  company               Company        @relation(fields: [companyId], references: [id])
  recallId              String         @map("recall_id") @db.Uuid
  recall                Recall         @relation(fields: [recallId], references: [id])
  recallCountryId       String?        @map("recall_country_id") @db.Uuid
  recallCountry         RecallCountry? @relation(fields: [recallCountryId], references: [id])
  units                 Int
  reason                String
  ownerUserId           String?        @map("owner_user_id") @db.Uuid
  owner                 User?          @relation("recall_discrepancy_owner", fields: [ownerUserId], references: [id])
  blocking              Boolean        @default(true)
  status                String         @default("open")
  exceptionApprovalNote String?        @map("exception_approval_note")
  exceptionApprovedBy   String?        @map("exception_approved_by") @db.Uuid
  exceptionApprover     User?          @relation("recall_discrepancy_exception_approved_by", fields: [exceptionApprovedBy], references: [id])
  exceptionApprovedAt   DateTime?      @map("exception_approved_at") @db.Timestamptz(3)
  createdBy             String?        @map("created_by") @db.Uuid
  creator               User?          @relation("recall_discrepancy_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, recallId])
  @@map("recall_discrepancy")
}

/**
 * Destruction is blocked until any country-required disposal-approval evidence exists (Tanzania's own confirmed regulation requires exactly this — 10.9). No `WasteDisposalRecord` exists yet in this schema to reuse (a forward-referenced, not-yet-built precedent) — this is a complete, standalone model.
 */
model RecallDestructionRecord {
  id                         String        @id @db.Uuid
  companyId                  String        @map("company_id") @db.Uuid
  company                    Company       @relation(fields: [companyId], references: [id])
  recallCountryId            String        @map("recall_country_id") @db.Uuid
  recallCountry              RecallCountry @relation(fields: [recallCountryId], references: [id])
  units                      Int
  disposalApprovalEvidenceId String?       @map("disposal_approval_evidence_id") @db.Uuid
  disposalApprovalEvidence   Document?     @relation("recall_destruction_disposal_approval", fields: [disposalApprovalEvidenceId], references: [id])
  destroyedBy                String?       @map("destroyed_by") @db.Uuid
  destroyer                  User?         @relation("recall_destruction_destroyed_by", fields: [destroyedBy], references: [id])
  destroyedAt                DateTime?     @map("destroyed_at") @db.Timestamptz(3)
  certificateEvidenceId      String?       @map("certificate_evidence_id") @db.Uuid
  certificateEvidence        Document?     @relation("recall_destruction_certificate", fields: [certificateEvidenceId], references: [id])
  status                     String        @default("pending_approval")
  createdBy                  String?       @map("created_by") @db.Uuid
  creator                    User?         @relation("recall_destruction_record_created_by", fields: [createdBy], references: [id])
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, recallCountryId])
  @@map("recall_destruction_record")
}

/**
 * A check with `stockFound > 0` stays open until its follow-up tasks close, never auto-resolved.
 */
model RecallEffectivenessCheck {
  id              String        @id @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id])
  recallCountryId String        @map("recall_country_id") @db.Uuid
  recallCountry   RecallCountry @relation(fields: [recallCountryId], references: [id])
  method          String
  sampleSize      Int           @map("sample_size")
  clear           Int
  stockFound      Int           @map("stock_found")
  followUpTaskIds String[]      @map("follow_up_task_ids")
  status          String        @default("open")
  performedBy     String?       @map("performed_by") @db.Uuid
  performer       User?         @relation("recall_effectiveness_check_performed_by", fields: [performedBy], references: [id])
  performedAt     DateTime?     @map("performed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, recallCountryId])
  @@map("recall_effectiveness_check")
}

// ── Stage 16 — Reliance Pathways (EAC / ZaZiBoNa / WHO CRP) ─────────────

/**
 * RegCloud (Phase 12) Stage 16 — Reliance Pathways. A deliberately thin
 * grouping wrapper, not a new submission mechanism: "one dossier, several
 * simultaneous or sequenced submissions" is exactly what the already-
 * built dossier pipeline (Stages 1–9) already does per authority, so a
 * reliance application is just several real, independent `RegDossier`
 * rows (one per participating authority, each linked back here via
 * `RegDossier.relianceApplicationId`) plus this row's own metadata —
 * mirroring the Clinical Trials Regulatory Route's exact "reuse, not
 * rebuild" precedent from Stage 12. No workflow instance of its own:
 * real lifecycle progress happens at the per-authority dossier level,
 * the same way `ClinicalTrial` itself carries no workflow, only its own
 * CTA dossiers do.
 * `participatingAuthorityIds` is a plain array, not a join table — the
 * "has a dossier been started for this authority yet" question is
 * always answered live (`RegDossier.where({ relianceApplicationId,
 * authorityId })`), matching this project's own "don't persist what can
 * be computed live" discipline (e.g. `Signal.strengthOfEvidenceCaseCount`).
 * `leadAuthorityId` is the reference/lead assessment a joint-assessment
 * or reliance pathway is always built around, deliberately kept separate
 * from the relying-market list rather than folded into it.
 * ⚠️ Entirely Tier 2/3 priority per `todo-regcloud.md`'s own framing —
 * the mechanism here (linking several independent dossiers under one
 * shared application) is real and honest, but no EAC/ZaZiBoNa/WHO CRP
 * process-level content (document requirements, timelines) is sourced
 * or invented — `pathwayType` is a plain string precisely so it can
 * carry whatever real pathway name applies without a schema change.
 */
model RelianceApplication {
  id                        String              @id @db.Uuid
  companyId                 String              @map("company_id") @db.Uuid
  company                   Company             @relation(fields: [companyId], references: [id])
  productId                 String              @map("product_id") @db.Uuid
  product                   Product             @relation(fields: [productId], references: [id])
  /**
   * Plain string — `eac_joint_assessment | zaziboNa | who_crp`.
   */
  pathwayType               String              @map("pathway_type")
  leadAuthorityId           String              @map("lead_authority_id") @db.Uuid
  leadAuthority             RegulatoryAuthority @relation(fields: [leadAuthorityId], references: [id])
  participatingAuthorityIds String[]            @map("participating_authority_ids")
  /**
   * Plain string — `active | closed`. No workflow instance — see this model's own doc comment.
   */
  status                    String              @default("active")
  createdBy                 String?             @map("created_by") @db.Uuid
  creator                   User?               @relation(fields: [createdBy], references: [id])
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  regDossiers RegDossier[]

  @@index([companyId, productId])
  @@map("reliance_application")
}

// ── QualCloud (Phase 13) Stage 0 — Foundation Layer ─────────────────────
// Quality Entity & Hierarchy Model (0.1), Controlled-Document &
// Data-Integrity Core (0.2), Unified Quality-Event & CAPA Core (0.3 —
// `Capa` itself was extended in place above, not duplicated here), and
// Access & Multi-Tenant Scoping (0.4 — RLS added in the same migration
// that creates each table below, never retrofitted). See
// `qualcloud docs/todo-qualcloud.md` for the full build spec these
// models implement.

/**
 * A raw-material/API/packaging/contract-service supplier — deliberately
 * broader than `Manufacturer` (RegCloud's own finished-product/
 * registered-site concept), per `todo-qualcloud.md` Reconciliation Note
 * 9. `manufacturerId` is the optional cross-link for when a supplier
 * *is* a finished-product manufacturing site already known to RegCloud
 * — never a merge of the two concepts, since `Manufacturer`'s own
 * meaning (a RegCloud registration's own manufacturing site, GMP
 * certificate and all) must stay exactly what it already is.
 */
model Supplier {
  id             String        @id @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  name           String
  /**
   * Plain string — `api_supplier | excipient_supplier |
   * packaging_supplier | contract_manufacturer | contract_lab |
   * contract_service | other` — a real, commonly-used WHO-GMP-aligned
   * taxonomy, kept as free text (not a hardcoded enum) so a company can
   * record its own supplier type without a migration, the same
   * "confirmed categories, flexible column" balance `RegVariation
   * .variationType` struck, applied more conservatively here since this
   * taxonomy is less firmly fixed across companies than a regulator's
   * own variation scheme is.
   */
  supplierType   String        @map("supplier_type")
  countryId      String?       @map("country_id") @db.Uuid
  country        Country?      @relation(fields: [countryId], references: [id])
  address        String?
  /**
   * `critical | non_critical` — WHO GMP's own risk-based-qualification
   * principle: an API or primary-packaging supplier is always
   * `critical`; a courier or stationery vendor is not. Drives Stage
   * 11's own default audit/requalification-frequency split.
   */
  criticality    String        @default("non_critical")
  /**
   * `pending | approved | suspended | disqualified` — never deleted,
   * matching every other status field in this schema.
   */
  approvalStatus String        @default("pending") @map("approval_status")
  manufacturerId String?       @map("manufacturer_id") @db.Uuid
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  isActive       Boolean       @default(true) @map("is_active")
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  /**
   * QualCloud (Phase 13) Stage 11 — the live re-qualification clock.
   * Computed by `SupplierQualificationService` at `approve()`/`monitor()`
   * time (annual for `criticality: critical`, 2–3 years for
   * `non_critical` — admin-editable via
   * `Company.supplierCriticalRequalificationMonths`/
   * `supplierNonCriticalRequalificationMonths`, both nullable meaning
   * "use the coded default"), never hand-set directly.
   */
  nextRequalificationDueAt DateTime? @map("next_requalification_due_at") @db.Timestamptz(3)
  lastQualifiedAt          DateTime? @map("last_qualified_at") @db.Timestamptz(3)
  /**
   * `monitor()`'s own running performance-flag log — plain strings
   * (e.g. "late delivery", "CoA discrepancy"), each with an implicit
   * timestamp folded into the string itself rather than a separate
   * child table, matching this schema's own "don't build structure
   * ahead of confirmed need" discipline for a field that's read far
   * more than it's queried.
   */
  performanceFlags         String[]  @default([]) @map("performance_flags")

  specifications Specification[]
  deviations     Deviation[]
  changeControls ChangeControl[]
  internalAudits InternalAudit[]
  questionnaires SupplierQuestionnaire[]
  coaRecords     CertificateOfAnalysis[]

  @@index([companyId])
  @@index([companyId, nextRequalificationDueAt])
  @@map("supplier")
}

/**
 * QualCloud (Phase 13) Stage 11 — a structured (not free-text) supplier
 * qualification questionnaire response: a fixed set of weighted
 * criteria, each scored, feeding `SupplierQualificationService.assess()`'s
 * own computed `overallScore`. One row per assessment cycle (never
 * updated in place — a re-assessment is a new row), matching this
 * schema's own "append, don't overwrite" discipline for anything that
 * documents a point-in-time judgment.
 */
model SupplierQuestionnaire {
  id           String   @id @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id])
  supplierId   String   @map("supplier_id") @db.Uuid
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  title        String
  /**
   * `[{ question: string, weight: number, score: number, notes?: string }]`
   * — a fixed shape, validated at the DTO layer rather than
   * normalized into child rows, matching `RiskAssessment`'s own
   * "application code owns the formula, not a migration" precedent.
   */
  criteria     Json
  overallScore Int?     @map("overall_score")
  assessedBy   String?  @map("assessed_by") @db.Uuid
  assessor     User?    @relation("supplier_questionnaire_assessed_by", fields: [assessedBy], references: [id])
  assessedAt   DateTime @default(now()) @map("assessed_at") @db.Timestamptz(3)

  @@index([companyId, supplierId])
  @@map("supplier_questionnaire")
}

/**
 * QualCloud (Phase 13) Stage 11 — incoming-material/API Certificate of
 * Analysis review, scored against a `Specification`'s own
 * `SpecificationParameter` rows the same way `OosService` reads them —
 * every result either structurally passes/fails its own parameter's
 * `lowerLimit`/`upperLimit` (when numeric) or is recorded as a plain
 * qualitative pass/fail, mirroring `SpecificationParameter.lowerLimit`'s
 * own "often qualitative" doc comment.
 */
model CertificateOfAnalysis {
  id                      String        @id @db.Uuid
  companyId               String        @map("company_id") @db.Uuid
  company                 Company       @relation(fields: [companyId], references: [id])
  supplierId              String        @map("supplier_id") @db.Uuid
  supplier                Supplier      @relation(fields: [supplierId], references: [id])
  materialSpecificationId String        @map("material_specification_id") @db.Uuid
  materialSpecification   Specification @relation(fields: [materialSpecificationId], references: [id])
  batchOrLotNumber        String        @map("batch_or_lot_number")
  /**
   * `[{ parameterId, parameterName, resultValue, pass: boolean }]` — one entry per `SpecificationParameter` on the referenced spec.
   */
  results                 Json
  /**
   * `accepted | rejected | quarantined`.
   */
  disposition             String        @default("quarantined")
  reviewedBy              String?       @map("reviewed_by") @db.Uuid
  reviewer                User?         @relation("coa_reviewed_by", fields: [reviewedBy], references: [id])
  reviewedAt              DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  createdBy               String?       @map("created_by") @db.Uuid
  creator                 User?         @relation("coa_created_by", fields: [createdBy], references: [id])
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, supplierId])
  @@index([companyId, materialSpecificationId])
  @@map("certificate_of_analysis")
}

/**
 * Equipment/instrument register — qualification status, calibration and
 * maintenance scheduling. The real DQ→IQ→OQ→PQ lifecycle per EU GMP
 * Annex 15/ISPE, not a single boolean "is it qualified" flag.
 */
model Equipment {
  id                  String    @id @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  company             Company   @relation(fields: [companyId], references: [id])
  facilityId          String?   @map("facility_id") @db.Uuid
  facility            Facility? @relation(fields: [facilityId], references: [id])
  name                String
  equipmentType       String    @map("equipment_type")
  assetTag            String?   @map("asset_tag")
  /**
   * `not_qualified | dq_complete | iq_complete | oq_complete |
   * pq_complete | qualified | requalification_due | disqualified`.
   */
  qualificationStatus String    @default("not_qualified") @map("qualification_status")
  calibrationDueAt    DateTime? @map("calibration_due_at") @db.Timestamptz(3)
  lastCalibratedAt    DateTime? @map("last_calibrated_at") @db.Timestamptz(3)
  maintenanceDueAt    DateTime? @map("maintenance_due_at") @db.Timestamptz(3)
  isActive            Boolean   @default(true) @map("is_active")
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  deviations          Deviation[]
  changeControls      ChangeControl[]
  qualificationEvents EquipmentQualificationEvent[]
  maintenanceRecords  MaintenanceRecord[]
  validationProtocols ValidationProtocol[]

  @@index([companyId])
  @@index([facilityId])
  @@index([companyId, calibrationDueAt])
  @@map("equipment")
}

/**
 * QualCloud (Phase 13) Stage 14 — one dated, signed-off event per DQ/IQ/
 * OQ/PQ step (EU GMP Annex 15/ISPE's own four-step model) rather than a
 * single boolean "is it qualified" flag — each step is its own real
 * event with its own protocol/report evidence, not a status flip.
 * `Equipment.qualificationStatus` stays the live denormalized summary,
 * advanced by `EquipmentQualificationService` as each stage's event is
 * recorded, matching `Sop.status`'s own "workflow/service writes it,
 * nothing else does" discipline (even though this record type has no
 * `WorkflowInstance` behind it — a qualification stage is a one-shot
 * signed event, not a multi-actor lifecycle, the same reasoning
 * `BatchRecordReview` already established).
 */
model EquipmentQualificationEvent {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  company            Company   @relation(fields: [companyId], references: [id])
  equipmentId        String    @map("equipment_id") @db.Uuid
  equipment          Equipment @relation(fields: [equipmentId], references: [id])
  /**
   * `dq | iq | oq | pq`.
   */
  stage              String
  protocolDocumentId String?   @map("protocol_document_id") @db.Uuid
  protocolDocument   Document? @relation("equipment_qualification_protocol", fields: [protocolDocumentId], references: [id])
  reportDocumentId   String?   @map("report_document_id") @db.Uuid
  reportDocument     Document? @relation("equipment_qualification_report", fields: [reportDocumentId], references: [id])
  result             String    @default("pass")
  notes              String?
  performedBy        String?   @map("performed_by") @db.Uuid
  performer          User?     @relation("equipment_qualification_performed_by", fields: [performedBy], references: [id])
  performedAt        DateTime  @default(now()) @map("performed_at") @db.Timestamptz(3)

  @@index([companyId, equipmentId])
  @@map("equipment_qualification_event")
}

/**
 * QualCloud (Phase 13) Stage 14 — a plain preventive/corrective
 * maintenance log entry, distinct from a qualification event (a
 * maintenance visit doesn't re-qualify the equipment, it just services
 * it) and from a `Deviation` (a missed/overdue maintenance or
 * calibration date is what creates a deviation candidate — see
 * `CalibrationScanProcessor` — a completed-on-time maintenance visit
 * never does).
 */
model MaintenanceRecord {
  id              String    @id @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  equipmentId     String    @map("equipment_id") @db.Uuid
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  maintenanceDate DateTime  @map("maintenance_date") @db.Date
  description     String
  performedBy     String?   @map("performed_by") @db.Uuid
  performer       User?     @relation("maintenance_record_performed_by", fields: [performedBy], references: [id])
  nextDueAt       DateTime? @map("next_due_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  creator         User?     @relation("maintenance_record_created_by", fields: [createdBy], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, equipmentId])
  @@map("maintenance_record")
}

/**
 * The real controlled-document register — an SOP, policy, specification
 * reference, master batch record, work instruction, form, or protocol
 * at a specific version, with its own approval/effective/supersession
 * lifecycle. Distinct from a bare `Document` row (which is just a
 * stored file) — this is the ALCOA+ "version-controlled, nothing
 * effective without an approval trail" record itself. The full
 * Draft→Review&Approve→Effective→Read&Understand→Revise/Retire
 * *workflow* is QualCloud Stage 1's own build; this stage only creates
 * the entity and its bare CRUD (deliberately, per `todo-qualcloud.md`'s
 * own stage split — mirroring RegCloud Stage 0.3's "document custody
 * exists, the compilation wizard is a later stage" precedent).
 */
model Sop {
  id                       String    @id @db.Uuid
  companyId                String    @map("company_id") @db.Uuid
  company                  Company   @relation(fields: [companyId], references: [id])
  /**
   * A real, human-meaningful controlled ID (e.g. `SOP-QA-001`) — format
   * is company-configurable (a simple prefix+sequence admin setting),
   * never hardcoded.
   */
  documentNumber           String    @map("document_number")
  title                    String
  /**
   * `sop | policy | specification_reference | master_batch_record |
   * work_instruction | form | protocol | report` — WHO GMP's own
   * document-hierarchy taxonomy, plain string per this model's own
   * "confirmed categories, flexible column" reasoning above.
   */
  documentType             String    @map("document_type")
  productId                String?   @map("product_id") @db.Uuid
  product                  Product?  @relation(fields: [productId], references: [id])
  processArea              String?   @map("process_area")
  currentVersion           Int       @default(1) @map("current_version")
  /**
   * `draft | in_review | approved | effective | superseded | retired`
   * — the real workflow states Stage 1 drives via a real
   * `WorkflowInstance`; this column is the denormalized sync target
   * (`WorkflowStatusSyncRegistryService`), not the source of truth once
   * Stage 1 ships.
   */
  status                   String    @default("draft")
  effectiveDate            DateTime? @map("effective_date") @db.Date
  /**
   * Default periodic-review interval is a company-level
   * `RetentionPolicy`-adjacent setting (2 years unless the company sets
   * its own) — this column is simply the computed next-due date for
   * *this* document, never the policy itself.
   */
  nextPeriodicReviewDueAt  DateTime? @map("next_periodic_review_due_at") @db.Date
  supersedesDocumentId     String?   @map("supersedes_document_id") @db.Uuid
  supersedes               Sop?      @relation("sop_supersedes", fields: [supersedesDocumentId], references: [id])
  supersededBy             Sop[]     @relation("sop_supersedes")
  /**
   * QualCloud (Phase 13) Stage 1 — the real read-and-understand window,
   * set when a document is marked effective (`makeEffective()`): default
   * **5 working days** for a routine revision, **0** ("same-day") for a
   * critical safety-related revision — the domain-expert correction
   * `todo-qualcloud.md` Stage 1 itself calls for (a document going
   * effective never waits on being read; the reverse — failing to
   * acknowledge within this window — is what becomes a training-
   * compliance finding, Stage 12). Plain per-document int, not a
   * separate config table, matching this project's own "don't build a
   * config layer ahead of confirmed need" discipline.
   */
  acknowledgmentWindowDays Int       @default(5) @map("acknowledgment_window_days")
  createdBy                String?   @map("created_by") @db.Uuid
  creator                  User?     @relation("sop_created_by", fields: [createdBy], references: [id])
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  acknowledgments     DocumentAcknowledgment[]
  deviations          Deviation[]
  changeControls      ChangeControl[]
  validationProtocols ValidationProtocol[]

  @@unique([companyId, documentNumber, currentVersion])
  @@index([companyId])
  @@map("sop")
}

/**
 * A product/material specification — acceptance criteria and test
 * methods, kept as its own model (not folded into `Sop.documentType`)
 * because its own child rows (`SpecificationParameter`) are real
 * structured data Stage 6's OOS investigation and Stage 11's incoming-
 * material CoA check both need to query programmatically, not just a
 * PDF to read.
 */
model Specification {
  id                  String    @id @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  company             Company   @relation(fields: [companyId], references: [id])
  specificationNumber String    @map("specification_number")
  title               String
  /**
   * `finished_product | raw_material | api | packaging | in_process`.
   */
  specificationType   String    @map("specification_type")
  productId           String?   @map("product_id") @db.Uuid
  product             Product?  @relation(fields: [productId], references: [id])
  supplierId          String?   @map("supplier_id") @db.Uuid
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  version             Int       @default(1)
  status              String    @default("draft")
  effectiveDate       DateTime? @map("effective_date") @db.Date
  createdBy           String?   @map("created_by") @db.Uuid
  creator             User?     @relation("specification_created_by", fields: [createdBy], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parameters            SpecificationParameter[]
  oosRecords            Oos[]
  certificateOfAnalyses CertificateOfAnalysis[]
  stabilityStudies      StabilityStudy[]

  @@index([companyId])
  @@map("specification")
}

/**
 * One test parameter on a `Specification` — real structured acceptance criteria, not free text.
 */
model SpecificationParameter {
  id              String        @id @db.Uuid
  specificationId String        @map("specification_id") @db.Uuid
  specification   Specification @relation(fields: [specificationId], references: [id])
  parameterName   String        @map("parameter_name")
  testMethod      String?       @map("test_method")
  /**
   * Kept as plain strings, not `Decimal` — a real acceptance criterion
   * is often qualitative ("complies," "white to off-white powder") as
   * often as it is a numeric range; forcing a numeric type here would
   * make the common qualitative case unrepresentable.
   */
  lowerLimit      String?       @map("lower_limit")
  upperLimit      String?       @map("upper_limit")
  unit            String?
  sortOrder       Int           @default(0) @map("sort_order")

  oosRecords Oos[]

  @@index([specificationId])
  @@map("specification_parameter")
}

/**
 * The "assign, acknowledge, track per controlled doc" read-and-
 * understand record — distinct from (but feeding into) Stage 12's
 * training/competency model.
 */
model DocumentAcknowledgment {
  id                  String    @id @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  company             Company   @relation(fields: [companyId], references: [id])
  sopId               String    @map("sop_id") @db.Uuid
  sop                 Sop       @relation(fields: [sopId], references: [id])
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation("document_acknowledgment_user", fields: [userId], references: [id])
  versionAcknowledged Int       @map("version_acknowledged")
  assignedAt          DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  /**
   * `todo-qualcloud.md` Stage 0.1's own domain-expert correction: a
   * document going *effective* never waits on this being non-null —
   * only the reverse, a real training-compliance gap once the
   * acknowledgment window (Stage 12) passes unacknowledged.
   */
  acknowledgedAt      DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  @@unique([sopId, userId, versionAcknowledged])
  @@index([companyId])
  @@map("document_acknowledgment")
}

/**
 * Per-company, per-record-type retention configuration — the concrete
 * ALCOA+ "Enduring/Available" mechanism. Never drives an automatic
 * delete (this schema never deletes anything, retention policy or not)
 * — "must remain retrievable," never "may be destroyed."
 */
model RetentionPolicy {
  id             String   @id @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])
  recordType     String   @map("record_type")
  retentionYears Int      @map("retention_years")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, recordType])
  @@map("retention_policy")
}

/**
 * ICH Q9's own live risk register — any workflow can create a row
 * against any quality entity (polymorphic `sourceRecordType`/
 * `sourceRecordId`, the same pattern `Capa` now uses). Built in Stage 0
 * because Stage 4's change-control impact assessment and Stage 2's
 * deviation intake both need to create rows into it from day one, even
 * though Stage 13 (PQR & Quality Risk Management) is where it becomes
 * this schema's own "live risk register" in the fuller sense.
 */
model RiskAssessment {
  id                String   @id @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  company           Company  @relation(fields: [companyId], references: [id])
  sourceRecordType  String?  @map("source_record_type")
  sourceRecordId    String?  @map("source_record_id") @db.Uuid
  title             String
  /**
   * `fmea | fault_tree | risk_matrix_2x2 | haccp | other` — ICH Q9's
   * own named risk-methodology toolkit.
   */
  riskMethod        String   @default("risk_matrix_2x2") @map("risk_method")
  severity          Int
  probability       Int
  detectability     Int?
  /**
   * FMEA's classic Risk Priority Number when `detectability` is set
   * (severity × probability × detectability); a plain severity ×
   * probability product otherwise — computed in application code, not
   * a DB-generated column, so the exact formula stays easy to read and
   * change without a migration.
   */
  score             Int
  /**
   * `low | medium | high` — thresholds are company-admin-editable
   * (Stage 0.3's own Quality Configuration console), defaulting to a
   * conventional tertile split.
   */
  riskLevel         String   @map("risk_level")
  mitigationActions String?  @map("mitigation_actions")
  capaId            String?  @map("capa_id") @db.Uuid
  capa              Capa?    @relation(fields: [capaId], references: [id])
  createdBy         String?  @map("created_by") @db.Uuid
  creator           User?    @relation("risk_assessment_created_by", fields: [createdBy], references: [id])
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deviations Deviation[]

  @@index([companyId])
  @@index([companyId, sourceRecordType, sourceRecordId])
  @@map("risk_assessment")
}

// ── QualCloud (Phase 13) Stage 2 — Deviation & Non-Conformance ──────────
// Management. Master quality-event lifecycle stages 1–3 (Detect/Raise →
// Assess & Classify → Investigate/Root Cause), specialized for a
// deviation. `status` is driven by the real `quality_deviation`
// `WorkflowInstance` (Stage 1... Stage 2's own seed data,
// `workflow.seed-data.ts`) via `QualityWorkflowGuards`'
// `WorkflowStatusSyncRegistryService` registration — this column is the
// denormalized sync target, not the source of truth.

/**
 * A real deviation from an approved procedure/specification — the
 * connected-quality spine's own first real quality-event table (every
 * later one — OOS, complaint, change control — follows this same shape:
 * a polymorphic link to whichever quality entity it touches, a shared
 * severity taxonomy, a `Capa` opened via `sourceRecordType:
 * 'deviation'`).
 */
model Deviation {
  id                   String          @id @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  company              Company         @relation(fields: [companyId], references: [id])
  /**
   * Real sequential display code, `DEV-2026-00001` — same generator precedent as `RegVariation.displayCode`.
   */
  deviationNumber      String          @map("deviation_number")
  title                String
  /**
   * Text-encrypted (`TextEncryptionService`, the same primitive
   * VigiCloud's own case-narrative fields use) — a deviation
   * description can legitimately contain sensitive process/formulation
   * detail. Never returned as raw ciphertext — see `DeviationService
   * .decryptDeviation()`.
   */
  descriptionEncrypted String?         @map("description_encrypted")
  /**
   * `self_reported | audit_finding | oos_triggered | complaint_triggered | monitoring_alert`.
   */
  sourceType           String          @map("source_type")
  productId            String?         @map("product_id") @db.Uuid
  product              Product?        @relation(fields: [productId], references: [id])
  batchId              String?         @map("batch_id") @db.Uuid
  batch                Batch?          @relation(fields: [batchId], references: [id])
  equipmentId          String?         @map("equipment_id") @db.Uuid
  equipment            Equipment?      @relation(fields: [equipmentId], references: [id])
  supplierId           String?         @map("supplier_id") @db.Uuid
  supplier             Supplier?       @relation(fields: [supplierId], references: [id])
  sopId                String?         @map("sop_id") @db.Uuid
  sop                  Sop?            @relation(fields: [sopId], references: [id])
  detectedAt           DateTime        @map("detected_at") @db.Timestamptz(3)
  raisedBy             String?         @map("raised_by") @db.Uuid
  raiser               User?           @relation("deviation_raised_by", fields: [raisedBy], references: [id])
  /**
   * `critical | major | minor` — Stage 0.3's shared severity taxonomy
   * (`SEVERITY_DEFINITIONS`). Nullable until `classify()` sets it —
   * a deviation can be `detected` before anyone has assessed it yet.
   */
  severity             String?
  riskAssessmentId     String?         @map("risk_assessment_id") @db.Uuid
  riskAssessment       RiskAssessment? @relation(fields: [riskAssessmentId], references: [id])
  containmentActions   String?         @map("containment_actions")
  /**
   * Computed at `classify()` time — a plain `detectedAt + offset`
   * calendar-day field (🧭 30 days for Major/Critical, 10 for Minor,
   * `todo-qualcloud.md`'s own default), deliberately **not** routed
   * through the generic `Deadline`/`ReportingRule` model — that
   * subsystem structurally requires a country-varying `ReportingRule`
   * row, which doesn't exist for a flat, company-wide investigation
   * clock. Mirrors `RegFeeInvoice.dueAt`/`RegPostMarketObligation.dueAt`'s
   * own plain-column precedent instead.
   */
  investigationDueAt   DateTime?       @map("investigation_due_at") @db.Timestamptz(3)
  status               String          @default("detected")
  closedAt             DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdBy            String?         @map("created_by") @db.Uuid
  creator              User?           @relation("deviation_created_by", fields: [createdBy], references: [id])
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  investigation Investigation?

  @@unique([companyId, deviationNumber])
  @@index([companyId, status])
  @@map("deviation")
}

/**
 * The root-cause investigation record — one per `Deviation` (1:1).
 * `investigatorUserId`/`reviewerUserId` back the four-eyes guard
 * (`QualityWorkflowGuards`): the reviewer signing off the investigation
 * can never be the same person who performed it, the identical
 * precedent VigiCloud Stage 9's own causality/QC four-eyes rule already
 * established for PV cases.
 */
model Investigation {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  company            Company   @relation(fields: [companyId], references: [id])
  deviationId        String    @unique @map("deviation_id") @db.Uuid
  deviation          Deviation @relation(fields: [deviationId], references: [id])
  /**
   * `five_why | fishbone_ishikawa | fault_tree | is_is_not | other` — the real, standard root-cause toolkit.
   */
  rootCauseMethod    String?   @map("root_cause_method")
  findings           String?
  evidenceReferences String?   @map("evidence_references")
  investigatorUserId String?   @map("investigator_user_id") @db.Uuid
  investigator       User?     @relation("investigation_investigator", fields: [investigatorUserId], references: [id])
  reviewerUserId     String?   @map("reviewer_user_id") @db.Uuid
  reviewer           User?     @relation("investigation_reviewer", fields: [reviewerUserId], references: [id])
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@map("investigation")
}

// ── QualCloud (Phase 13) Stage 4 — Change Control ───────────────────────

/**
 * Master lifecycle stage 5. `changeType` (how much this change ripples —
 * `like_for_like | minor | major | critical`) is deliberately distinct
 * from `Deviation.severity` (how bad an event already was), even though
 * the labels look similar. `impactAssessment`/`crossFunctionalApprovals`
 * are structured `Json`, not free text — see `ChangeControlService`'s
 * own doc comment for the real shape each holds and why. The literal
 * cross-module join the Build Priority doc calls the moat:
 * `linkedRegVariationId` points at a real `RegVariation` opened through
 * RegCloud's own, already-built `RegVariationService.create()` once
 * `impactAssessment` flags a regulatory impact — never a duplicated
 * regulatory-filing concept inside QualCloud.
 */
model ChangeControl {
  id                            String               @id @db.Uuid
  companyId                     String               @map("company_id") @db.Uuid
  company                       Company              @relation(fields: [companyId], references: [id])
  /**
   * Real sequential display code, `CC-2026-00001` — same generator precedent as `Deviation.deviationNumber`.
   */
  changeNumber                  String               @map("change_number")
  title                         String
  /**
   * `like_for_like | minor | major | critical`.
   */
  changeType                    String               @map("change_type")
  /**
   * Text-encrypted — a change description can legitimately contain sensitive process/formulation detail, same reasoning as `Deviation.descriptionEncrypted`.
   */
  changeDescriptionEncrypted    String?              @map("change_description_encrypted")
  /**
   * `process | equipment | facility | supplier | sop | specification | packaging | labeling`.
   */
  scope                         String
  productId                     String?              @map("product_id") @db.Uuid
  product                       Product?             @relation(fields: [productId], references: [id])
  batchId                       String?              @map("batch_id") @db.Uuid
  batch                         Batch?               @relation(fields: [batchId], references: [id])
  equipmentId                   String?              @map("equipment_id") @db.Uuid
  equipment                     Equipment?           @relation(fields: [equipmentId], references: [id])
  supplierId                    String?              @map("supplier_id") @db.Uuid
  supplier                      Supplier?            @relation(fields: [supplierId], references: [id])
  sopId                         String?              @map("sop_id") @db.Uuid
  sop                           Sop?                 @relation(fields: [sopId], references: [id])
  /**
   * `{ regulatoryImpact: {impacted, note?}, validationImpact: {...},
   * productSafetyImpact: {...}, stabilityImpact: {...},
   * otherSpecificationsImpact: {...} }` — a real structured checklist,
   * each dimension a yes/no + note, set at the `impact_assessment` step.
   * Never free text alone — see `ChangeControlService.assessImpact()`.
   */
  impactAssessment              Json?                @map("impact_assessment")
  /**
   * `{ role, userId, approvedAt, note? }[]` — one entry per required
   * cross-functional approver role, appended by `ChangeControlService
   * .recordApproval()`. Minimum `QUALITY_MANAGER` always; also
   * `REGULATORY_AFFAIRS_OFFICER` once `impactAssessment.regulatoryImpact
   * .impacted` is true — the real available-role mapping this platform's
   * own 8-role tenant taxonomy supports (a distinct "Production"
   * approver role does not exist in that taxonomy, honestly not
   * fabricated here).
   */
  crossFunctionalApprovals      Json                 @default("[]") @map("cross_functional_approvals")
  /**
   * Set once the affected registration is known — required before `openLinkedVariation()` can run when `impactAssessment.regulatoryImpact.impacted` is true.
   */
  affectedProductRegistrationId String?              @map("affected_product_registration_id") @db.Uuid
  affectedProductRegistration   ProductRegistration? @relation(fields: [affectedProductRegistrationId], references: [id])
  /**
   * The RegCloud `RegVariation` this change control opened, once opened.
   */
  linkedRegVariationId          String?              @unique @map("linked_reg_variation_id") @db.Uuid
  linkedRegVariation            RegVariation?        @relation(fields: [linkedRegVariationId], references: [id])
  implementationRecord          String?              @map("implementation_record")
  /**
   * Confirms no adverse effect — required (non-empty) before `verifying → closed` is allowed, per the workflow's own guard.
   */
  verificationResult            String?              @map("verification_result")
  status                        String               @default("proposed")
  closedAt                      DateTime?            @map("closed_at") @db.Timestamptz(3)
  createdBy                     String?              @map("created_by") @db.Uuid
  creator                       User?                @relation("change_control_created_by", fields: [createdBy], references: [id])
  createdAt                     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, changeNumber])
  @@index([companyId, status])
  @@map("change_control")
}

// ── QualCloud (Phase 13) Stage 5 — Complaint Handling ───────────────────

/**
 * Its own supporting workflow: Intake → Classify → Investigate →
 * Resolve (Trend is a live view over this table, not a lifecycle
 * state). `classification` is the single most important field: a
 * complaint describing possible patient harm is classified
 * `possible_ae` and routed to VigiCloud as a **real PV case** via the
 * already-existing `PvCaseService.createFromSystemChannel()` — the same
 * mechanism every other reporter-blind intake channel already uses
 * (`channel: quality_complaint_routed`) — never a duplicated adverse-
 * event-capture form inside QualCloud. See `ComplaintService.classify()`.
 */
model Complaint {
  id                      String    @id @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  company                 Company   @relation(fields: [companyId], references: [id])
  /**
   * Real sequential display code, `CMP-2026-00001`.
   */
  complaintNumber         String    @map("complaint_number")
  productId               String    @map("product_id") @db.Uuid
  product                 Product   @relation(fields: [productId], references: [id])
  batchId                 String?   @map("batch_id") @db.Uuid
  batch                   Batch?    @relation(fields: [batchId], references: [id])
  reporterName            String?   @map("reporter_name")
  reporterContact         String?   @map("reporter_contact")
  /**
   * `phone | email | written | in_person | distributor | other` — mirrors VigiCloud's own `CaseChannel` shape.
   */
  channel                 String
  descriptionEncrypted    String    @map("description_encrypted")
  /**
   * Null until `classify()` runs; `quality_complaint` or `possible_ae`
   * afterward. See this model's own doc comment for the `possible_ae`
   * routing behavior.
   */
  classification          String?
  /**
   * `critical | major | minor` — only meaningful for a `quality_complaint`; a `possible_ae` complaint's own seriousness lives on the routed PV case instead.
   */
  severity                String?
  resolutionNoteEncrypted String?   @map("resolution_note_encrypted")
  resolvedAt              DateTime? @map("resolved_at") @db.Timestamptz(3)
  capaId                  String?   @map("capa_id") @db.Uuid
  capa                    Capa?     @relation(fields: [capaId], references: [id])
  /**
   * Set once `classify()` routes this complaint to VigiCloud as a real PV case — the routed case's own `id`.
   */
  routedCaseId            String?   @unique @map("routed_case_id") @db.Uuid
  routedCase              Case?     @relation(fields: [routedCaseId], references: [id])
  status                  String    @default("intake")
  createdBy               String?   @map("created_by") @db.Uuid
  creator                 User?     @relation("complaint_created_by", fields: [createdBy], references: [id])
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, complaintNumber])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("complaint")
}

// ── QualCloud (Phase 13) Stage 6 — OOS/OOT Investigation ────────────────

/**
 * The real two-phase FDA/*Barr Labs* model, made structural:
 * `phase_1_lab_investigation | phase_2_manufacturing_investigation |
 * closed`. `retestRationale` is structurally required (DTO-level
 * `@IsNotEmpty`) before a retest decision can even be logged — the
 * exact control against "testing into compliance" data-integrity
 * violations the whole OOS literature warns about.
 * `QualityWorkflowGuards` blocks closing while still in Phase 1 unless
 * a documented assignable lab cause exists — the concrete, inspectable
 * proof this implements the real FDA OOS framework rather than a
 * generic "investigate and close" box.
 */
model Oos {
  id                         String                 @id @db.Uuid
  companyId                  String                 @map("company_id") @db.Uuid
  company                    Company                @relation(fields: [companyId], references: [id])
  /**
   * Real sequential display code, `OOS-2026-00001`.
   */
  oosNumber                  String                 @map("oos_number")
  batchId                    String                 @map("batch_id") @db.Uuid
  batch                      Batch                  @relation(fields: [batchId], references: [id])
  specificationId            String                 @map("specification_id") @db.Uuid
  specification              Specification          @relation(fields: [specificationId], references: [id])
  parameterId                String                 @map("parameter_id") @db.Uuid
  parameter                  SpecificationParameter @relation(fields: [parameterId], references: [id])
  testResult                 String                 @map("test_result")
  investigationPhase         String                 @default("phase_1_lab_investigation") @map("investigation_phase")
  phase1AssignableCauseFound Boolean?               @map("phase1_assignable_cause_found")
  phase1Findings             String?                @map("phase1_findings")
  retestAuthorized           Boolean?               @map("retest_authorized")
  retestRationale            String?                @map("retest_rationale")
  /**
   * Set true only when Phase 1 concludes with no assignable cause — computed once, at the `phase_2_manufacturing_investigation` transition, never re-derived.
   */
  phase2Triggered            Boolean                @default(false) @map("phase2_triggered")
  phase2Findings             String?                @map("phase2_findings")
  /**
   * `no_impact | batch_rejected | batch_reworked | other_batches_affected` — feeds `Batch.qualityStatus`/`BatchTraceabilityService` directly.
   */
  batchImpact                String?                @map("batch_impact")
  capaId                     String?                @map("capa_id") @db.Uuid
  capa                       Capa?                  @relation(fields: [capaId], references: [id])
  status                     String                 @default("phase_1_lab_investigation")
  closedAt                   DateTime?              @map("closed_at") @db.Timestamptz(3)
  createdBy                  String?                @map("created_by") @db.Uuid
  creator                    User?                  @relation("oos_created_by", fields: [createdBy], references: [id])
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, oosNumber])
  @@index([companyId, status])
  @@index([companyId, batchId])
  @@map("oos")
}

// ── QualCloud (Phase 13) Stage 7 — Batch Traceability, Record Review & Disposition ──

/**
 * The *pre*-Qualified-Person review — the QA batch-record check, e-
 * signature-gated. Stage 17's own QP release is a separate, later, more
 * senior gate for manufacturers that need it, never conflated with this
 * one (see this model's own `disposition` field). Reuses the existing
 * electronic-signature engine directly (`SignatureService`, the same
 * one `ClinicalTrialService.revealTreatmentArm()` already uses) rather
 * than a full generic workflow instance — this is a single-shot review
 * action, not a multi-state lifecycle.
 */
model BatchRecordReview {
  id              String    @id @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  batchId         String    @map("batch_id") @db.Uuid
  batch           Batch     @relation(fields: [batchId], references: [id])
  mbrDocumentId   String?   @map("mbr_document_id") @db.Uuid
  mbrDocument     Document? @relation("batch_record_review_mbr", fields: [mbrDocumentId], references: [id])
  reviewerUserId  String    @map("reviewer_user_id") @db.Uuid
  reviewer        User      @relation("batch_record_review_reviewer", fields: [reviewerUserId], references: [id])
  reviewFindings  String?   @map("review_findings")
  /**
   * `released | rejected | reworked` — set only by `recordDisposition()`, signature-gated.
   */
  disposition     String?
  dispositionedAt DateTime? @map("dispositioned_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([batchId])
  @@map("batch_record_review")
}

/**
 * QualCloud (Phase 13) Stage 15 — Pharmaceutical Waste Management.
 * Genuinely, honestly unsourced: no real PPB waste-disposal procedure
 * document exists anywhere in this project's reference material, so
 * this is deliberately built as a generic, jurisdiction-agnostic
 * mechanism per `todo-qualcloud.md`'s own 🧭 default, never a fabricated
 * citation. `disposalMethod` is a plain string (not a hardcoded enum)
 * resolved against the admin-editable `WasteDisposalMethodCatalogEntry`
 * catalog below — a real, PPB-sourced list can slot in later with zero
 * code change, matching `Supplier.supplierType`'s own precedent.
 * `witnessedByUserId`/`witnessSignatureEventId` are set only once a
 * second person signs as a destruction witness
 * (`WasteDisposalService.recordWitness()`, reusing `SignatureService`
 * directly — the same pattern `RecallDestructionService` already uses
 * for disposal-approval evidence) — optional, since not every disposal
 * method requires a witness.
 */
model WasteDisposalRecord {
  id                            String    @id @db.Uuid
  companyId                     String    @map("company_id") @db.Uuid
  company                       Company   @relation(fields: [companyId], references: [id])
  productId                     String?   @map("product_id") @db.Uuid
  product                       Product?  @relation(fields: [productId], references: [id])
  batchId                       String?   @map("batch_id") @db.Uuid
  batch                         Batch?    @relation(fields: [batchId], references: [id])
  /**
   * `expired_stock | rejected_batch | recalled_stock | sampling_residue | other`.
   */
  wasteType                     String    @map("waste_type")
  quantity                      String
  unit                          String
  /**
   * A `WasteDisposalMethodCatalogEntry.typeKey` value, or a free-text fallback — see this model's own doc comment.
   */
  disposalMethod                String    @map("disposal_method")
  disposalFacilityName          String?   @map("disposal_facility_name")
  disposalCertificateDocumentId String?   @map("disposal_certificate_document_id") @db.Uuid
  disposalCertificateDocument   Document? @relation("waste_disposal_certificate", fields: [disposalCertificateDocumentId], references: [id])
  witnessedByUserId             String?   @map("witnessed_by_user_id") @db.Uuid
  witnessedBy                   User?     @relation("waste_disposal_witnessed_by", fields: [witnessedByUserId], references: [id])
  witnessSignatureEventId       String?   @map("witness_signature_event_id") @db.Uuid
  witnessedAt                   DateTime? @map("witnessed_at") @db.Timestamptz(3)
  disposedAt                    DateTime  @map("disposed_at") @db.Timestamptz(3)
  createdBy                     String?   @map("created_by") @db.Uuid
  creator                       User?     @relation("waste_disposal_created_by", fields: [createdBy], references: [id])
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([batchId])
  @@map("waste_disposal_record")
}

/**
 * QualCloud (Phase 13) Stage 15 — the admin-configurable waste-disposal-
 * method catalog, mirroring `TrainingTypeCatalogEntry`'s exact precedent
 * (plain, platform-wide reference data, no RLS, no `companyId`) so a
 * real PPB-sourced list of methods can be added by a platform admin
 * with zero code change once one exists.
 */
model WasteDisposalMethodCatalogEntry {
  id        String   @id @db.Uuid
  methodKey String   @map("method_key")
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([methodKey])
  @@map("waste_disposal_method_catalog_entry")
}

/**
 * QualCloud (Phase 13) Stage 16 — Falsified & Substandard Product
 * Handling. `source` is a plain string carrying one of
 * `market_surveillance | complaint | distributor | regulator |
 * scan_feature` — `scan_feature` (QR/serialization scan-to-verify) is
 * named here as a real, forward-reserved value only; the scan feature
 * itself is explicitly out of scope for this pass, per
 * `todo-qualcloud.md`'s own Stage 16 framing. `evidenceDocumentIds` is a
 * plain string array (mirroring `Batch.parentBatchIds`'s own precedent)
 * rather than a child table — this schema's own "don't build a graph
 * table ahead of a confirmed multi-row need" discipline. `linkedDeviationId`/
 * `linkedCaseId` are set once `confirm()` opens the real cross-module
 * links (a `Deviation` with `sourceType: 'monitoring_alert'`, and —
 * where product safety is implicated — a real VigiCloud PV case via
 * `PvCaseService.createFromSystemChannel()`, the exact mechanism
 * `ComplaintService.classify()`'s own possible-AE routing already uses).
 */
model FalsifiedProductReport {
  id                  String   @id @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  company             Company  @relation(fields: [companyId], references: [id])
  productId           String?  @map("product_id") @db.Uuid
  product             Product? @relation(fields: [productId], references: [id])
  batchId             String?  @map("batch_id") @db.Uuid
  batch               Batch?   @relation(fields: [batchId], references: [id])
  reportedBy          String?  @map("reported_by") @db.Uuid
  reporter            User?    @relation("falsified_product_report_reported_by", fields: [reportedBy], references: [id])
  source              String
  evidenceDescription String   @map("evidence_description")
  evidenceDocumentIds String[] @default([]) @map("evidence_document_ids")
  authorityNotified   Boolean  @default(false) @map("authority_notified")
  /**
   * `reported | confirmed | dismissed | closed`.
   */
  status              String   @default("reported")
  linkedDeviationId   String?  @map("linked_deviation_id") @db.Uuid
  linkedCaseId        String?  @map("linked_case_id") @db.Uuid
  linkedRecallId      String?  @map("linked_recall_id") @db.Uuid
  dismissedReason     String?  @map("dismissed_reason")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([companyId, status])
  @@map("falsified_product_report")
}

/**
 * QualCloud (Phase 13) Stage 17 — Batch Release (Qualified Person). A
 * distinct, more senior gate than Stage 7's `BatchRecordReview` — never
 * conflated with it. Deliberately modeled as a permission-only gate
 * (`quality.manage_batch_release`, seeded since Stage 0 but granted to
 * no role — see this model's own `releasedByUserId`'s grant discussion
 * in `BatchReleaseService`'s own doc comment): real-world Qualified
 * Person designation is a jurisdiction-specific professional credential,
 * not something this schema invents a role/certification table for.
 * `riskAcceptances` is a plain JSON array of `{recordType, recordId,
 * reason}` — the releaser's own explicit, typed risk-acceptance of any
 * still-open `Deviation`/`Oos`/`Complaint` linked to this batch,
 * evaluated at release time rather than retrofitting a risk-acceptance
 * column onto three separate pre-existing models.
 */
model BatchReleaseDecision {
  id                  String   @id @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  company             Company  @relation(fields: [companyId], references: [id])
  batchId             String   @map("batch_id") @db.Uuid
  batch               Batch    @relation(fields: [batchId], references: [id])
  batchRecordReviewId String   @map("batch_record_review_id") @db.Uuid
  /**
   * `released | rejected`.
   */
  decision            String
  riskAcceptances     Json     @default("[]") @map("risk_acceptances")
  signatureEventId    String?  @map("signature_event_id") @db.Uuid
  releasedByUserId    String   @map("released_by_user_id") @db.Uuid
  releasedBy          User     @relation("batch_release_decision_released_by", fields: [releasedByUserId], references: [id])
  releasedAt          DateTime @default(now()) @map("released_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([batchId])
  @@map("batch_release_decision")
}

/**
 * QualCloud (Phase 13) Stage 18 — Validation (Process/Cleaning/Method)
 * and Computer System Validation, one shared pair of tables for all
 * four `validationType` values rather than four separate per-type
 * tables, per `todo-qualcloud.md`'s own stated shape. A validation
 * protocol *is* a controlled document — `protocolDocumentId` always
 * points at a real `Sop` row (created via the existing `SopService
 * .create()`, `documentType: 'protocol'`) and its approval lifecycle is
 * driven entirely through that `Sop`'s own, already-built
 * `quality_controlled_document` workflow — this model never invents a
 * second approval mechanism. `gampCategory` only applies when
 * `validationType = 'computer_system'` (GAMP 5's own risk-based
 * categorization); `approach` only applies when `validationType =
 * 'process'`.
 */
model ValidationProtocol {
  id                    String     @id @db.Uuid
  companyId             String     @map("company_id") @db.Uuid
  company               Company    @relation(fields: [companyId], references: [id])
  title                 String
  /**
   * `process | cleaning | analytical_method | computer_system`.
   */
  validationType        String     @map("validation_type")
  /**
   * Only meaningful for `validationType: 'process'` — `traditional_three_batch | continued_process_verification`.
   */
  approach              String?
  /**
   * Only meaningful for `validationType: 'computer_system'` — `1_infrastructure | 3_non_configured | 4_configured | 5_custom`.
   */
  gampCategory          String?    @map("gamp_category")
  productId             String?    @map("product_id") @db.Uuid
  product               Product?   @relation(fields: [productId], references: [id])
  equipmentId           String?    @map("equipment_id") @db.Uuid
  equipment             Equipment? @relation(fields: [equipmentId], references: [id])
  protocolDocumentId    String     @map("protocol_document_id") @db.Uuid
  protocolDocument      Sop        @relation(fields: [protocolDocumentId], references: [id])
  nextRevalidationDueAt DateTime?  @map("next_revalidation_due_at") @db.Date
  createdBy             String?    @map("created_by") @db.Uuid
  creator               User?      @relation("validation_protocol_created_by", fields: [createdBy], references: [id])
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  reports ValidationReport[]

  @@index([companyId])
  @@index([companyId, validationType])
  @@map("validation_protocol")
}

model ValidationReport {
  id               String             @id @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  company          Company            @relation(fields: [companyId], references: [id])
  protocolId       String             @map("protocol_id") @db.Uuid
  protocol         ValidationProtocol @relation(fields: [protocolId], references: [id])
  executionRecords Json?              @map("execution_records")
  reportDocumentId String?            @map("report_document_id") @db.Uuid
  reportDocument   Document?          @relation("validation_report_document", fields: [reportDocumentId], references: [id])
  /**
   * `validated | not_validated | conditionally_validated`.
   */
  conclusion       String?
  executedBy       String?            @map("executed_by") @db.Uuid
  executor         User?              @relation("validation_report_executed_by", fields: [executedBy], references: [id])
  executedAt       DateTime?          @map("executed_at") @db.Timestamptz(3)
  createdBy        String?            @map("created_by") @db.Uuid
  creator          User?              @relation("validation_report_created_by", fields: [createdBy], references: [id])
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([protocolId])
  @@map("validation_report")
}

/**
 * QualCloud (Phase 13) Stage 19 — Environmental Monitoring. One reading
 * per facility/grade/monitoring-type/date — EU GMP Annex 1's
 * A|B|C|D cleanroom grades (~ISO 14644-1's ISO 5|7|8), each with its
 * own alert/action limit pair. `actionLimit`/`alertLimit` are plain,
 * admin-configurable strings (not hardcoded), defaulted to Annex 1's
 * own commonly-published reference limits per grade at creation time if
 * the caller doesn't supply one — see `ENVIRONMENTAL_MONITORING_DEFAULT_LIMITS`
 * in `environmental-monitoring.service.ts`. `excursion` is computed at
 * write time (never re-derived later) from `result` vs. those two
 * limits — a numeric comparison where the result is numeric, otherwise
 * a plain pass/fail flag the caller asserts directly (viable counts are
 * sometimes reported as "<1"/"TNTC," not a clean number). An excursion
 * past the *action* limit opens a `Task` for a human to assess —
 * deliberately NOT an auto-created `Deviation`, matching
 * `EquipmentQualificationService`'s own calibration-overdue precedent
 * exactly: there is no honest "system" actor to attribute a Deviation's
 * own `detectedBy` to, so the system hands a real person a due task
 * instead of fabricating one.
 */
model EnvironmentalMonitoringResult {
  id              String    @id @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  facilityId      String    @map("facility_id") @db.Uuid
  facility        Facility  @relation(fields: [facilityId], references: [id])
  /** `A | B | C | D` — EU GMP Annex 1 cleanroom grade. */
  cleanroomGrade  String    @map("cleanroom_grade")
  /** `viable_air | viable_surface | viable_personnel | non_viable_particle`. */
  monitoringType  String    @map("monitoring_type")
  sampleLocation  String?   @map("sample_location")
  result          String
  alertLimit      String?   @map("alert_limit")
  actionLimit     String?   @map("action_limit")
  excursion       Boolean   @default(false)
  excursionLevel  String?   @map("excursion_level")
  sampledAt       DateTime  @map("sampled_at") @db.Timestamptz(3)
  notes           String?
  recordedBy      String?   @map("recorded_by") @db.Uuid
  recorder        User?     @relation("environmental_monitoring_recorded_by", fields: [recordedBy], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([companyId, facilityId, sampledAt])
  @@index([companyId, excursion])
  @@map("environmental_monitoring_result")
}

/**
 * QualCloud (Phase 13) Stage 19 — Stability Programme. One study per
 * product/batch/storage-condition combination (ICH Q1A(R2)'s own
 * long-term/intermediate/accelerated zones, Zone IVb's 30°C/75%RH
 * defaulted since this platform's first market is Kenya, with
 * 25°C/60%RH offered as the alternate for a temperate-market target),
 * each with a real pull-date/results-per-parameter timepoint schedule.
 * Feeds `PqrService.assemble()`'s own `stabilityNote` field directly
 * (see that service's doc comment, which named this exact gap).
 */
model StabilityStudy {
  id               String               @id @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  company          Company              @relation(fields: [companyId], references: [id])
  productId        String               @map("product_id") @db.Uuid
  product          Product              @relation(fields: [productId], references: [id])
  batchId          String?              @map("batch_id") @db.Uuid
  batch            Batch?               @relation(fields: [batchId], references: [id])
  specificationId  String?              @map("specification_id") @db.Uuid
  specification    Specification?       @relation(fields: [specificationId], references: [id])
  /** `long_term_30c_75rh | intermediate_30c_65rh | accelerated_40c_75rh | long_term_25c_60rh`. */
  storageCondition String               @map("storage_condition")
  startDate        DateTime             @map("start_date") @db.Date
  /** `in_progress | completed | terminated`. */
  status           String               @default("in_progress")
  createdBy        String?              @map("created_by") @db.Uuid
  creator          User?                @relation("stability_study_created_by", fields: [createdBy], references: [id])
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  timepoints StabilityTimepoint[]

  @@index([companyId])
  @@index([companyId, productId])
  @@map("stability_study")
}

/**
 * One scheduled/recorded pull-point on a `StabilityStudy` — real
 * structured results per `SpecificationParameter`, mirroring `Oos`'s own
 * "test against a real specification parameter, not free text" shape.
 * `withinSpec` is computed at recording time from each result against
 * its own parameter's lower/upper limit (the same comparison
 * `OosService` already performs), never re-derived later.
 */
model StabilityTimepoint {
  id               String         @id @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  company          Company        @relation(fields: [companyId], references: [id])
  stabilityStudyId String         @map("stability_study_id") @db.Uuid
  stabilityStudy   StabilityStudy @relation(fields: [stabilityStudyId], references: [id])
  /** Months from `StabilityStudy.startDate` — 0, 3, 6, 9, 12, 18, 24, 36. */
  timepointMonths  Int            @map("timepoint_months")
  pullDate         DateTime?      @map("pull_date") @db.Date
  /** `scheduled | pulled | tested | results_recorded`. */
  status           String         @default("scheduled")
  /** `[{ parameterId, parameterName, result, withinSpec }]` — one entry per tested `SpecificationParameter`. */
  results          Json?
  withinSpec       Boolean?       @map("within_spec")
  recordedBy       String?        @map("recorded_by") @db.Uuid
  recorder         User?          @relation("stability_timepoint_recorded_by", fields: [recordedBy], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([stabilityStudyId])
  @@map("stability_timepoint")
}
