// ── Phase 1.6 — Multi-Factor Authentication ───────────────────────────────

model MfaCredential {
  id     String    @id @db.Uuid
  userId String    @unique @map("user_id") @db.Uuid
  user   User      @relation(fields: [userId], references: [id])
  method MfaMethod @default(totp)

  /**
   * AES-256-GCM ciphertext (base64: iv + authTag + ciphertext), never the raw TOTP secret.
   */
  secretEncrypted String @map("secret_encrypted")

  /**
   * JSON array of { hash: string (sha256 hex), usedAt: string|null } — each of the 8 issued-once codes.
   */
  recoveryCodesHashed Json? @map("recovery_codes_hashed")

  /**
   * Null until verify-setup succeeds — a row can exist mid-setup without being active yet.
   */
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mfa_credential")
}

// ── Phase 1.7/1.8 — single-use tokens (password reset, post-invite verification) ──

model AuthToken {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
