# ─────────────────────────────────────────────────────────────────────────
# SafeMeds Backend — Environment Configuration
#
# Copy this file to `.env` and fill in real values. The app validates every
# variable below at boot (src/config/env.validation.ts) via Zod and refuses
# to start if anything is missing or malformed — there is no silent fallback
# to an insecure default in the places that matter (secrets, credentials).
#
# Generate a strong random secret with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1

# ── Database (Postgres via Prisma) ──────────────────────────────────────
# Matches docker-compose.yml by default.
DATABASE_URL=postgresql://safemeds:safemeds@localhost:5432/safemeds_dev?schema=public
DATABASE_POOL_SIZE=10

# ── Redis (BullMQ queues, single-use token store, caching) ─────────────
REDIS_URL=redis://localhost:6379

# ── JWT / session tokens ─────────────────────────────────────────────────
# Access token: short-lived JWT. Refresh token itself is an opaque random
# value (not a JWT) stored hashed — no secret needed for it, only a TTL.
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_MFA_PENDING_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_MFA_PENDING_EXPIRES_IN_MINUTES=5

# ── Cookies & CSRF ────────────────────────────────────────────────────────
# Leave COOKIE_DOMAIN unset for localhost; set to `.safemeds.uk` in prod.
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Password hashing (argon2id tuning) ───────────────────────────────────
ARGON2_MEMORY_COST_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12

# ── MFA (TOTP secrets encrypted at rest, AES-256-GCM) ────────────────────
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
MFA_ENCRYPTION_KEY=change-me-generate-32-bytes-as-64-hex-chars-0000000000000000
TEXT_ENCRYPTION_KEY=change-me-generate-32-bytes-as-64-hex-chars-0000000000000000

# ── Re-authentication (signature-grade tokens, Phase 1.9 / Phase 6) ─────
REAUTH_TOKEN_EXPIRES_IN_MINUTES=5

# ── Account lifecycle timing ─────────────────────────────────────────────
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
INVITATION_TOKEN_TTL_DAYS=7
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15

# ── Rate limiting (global default only; auth-route overrides are
# hardcoded via @Throttle() in auth.controller.ts) ─────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_change_me
MAIL_FROM_ADDRESS=no-reply@safemeds.uk
MAIL_FROM_NAME=SafeMeds

# ── Object storage (Cloudflare R2, S3-compatible API) ────────────────────
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=safemeds-documents-dev
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=
UPLOAD_MAX_FILE_SIZE_MB=10
PRESIGNED_UPLOAD_TTL_SECONDS=300
PRESIGNED_DOWNLOAD_TTL_SECONDS=900

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── API docs ──────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated extra origins beyond FRONTEND_URL (e.g. staging previews).
CORS_ADDITIONAL_ORIGINS=

# ── VigiCloud Stage 3.3 — inbound email ingestion ────────────────────────────
# Not provisioned yet — see vg-stage3-setup.md for what to configure in
# Resend + DNS before setting these. Left blank, the inbound-email webhook
# endpoint returns a clear "not configured" error rather than the app
# refusing to boot.
RESEND_INBOUND_WEBHOOK_SECRET=
EMAIL_INTAKE_DOMAIN=

# ── VigiCloud Stage 3.4 — WhatsApp Business Platform (Meta Cloud API) ────────
# Not provisioned yet — see vg-stage3-setup.md for the full Meta Business
# onboarding steps. Left blank, the WhatsApp webhook endpoints return a
# clear "not configured" error rather than the app refusing to boot.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

